/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_HOSTKEY DIALOGEX 0, 0, 300, 134
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "SFTP"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "",IDC_HOSTKEY_MESSAGE,10,8,280,56,SS_NOPREFIX
    LTEXT           "&Host:",IDC_STATIC,10,70,60,8
    EDITTEXT        IDE_HOSTKEY_HOST,72,68,218,12,ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "Key &type:",IDC_STATIC,10,86,60,8
    EDITTEXT        IDE_HOSTKEY_TYPE,72,84,218,12,ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "&Fingerprint:",IDC_STATIC,10,102,60,8
    EDITTEXT        IDE_HOSTKEY_FINGERPRINT,72,100,218,12,ES_AUTOHSCROLL | ES_READONLY
    DEFPUSHBUTTON   "&Accept and save",IDB_HOSTKEY_SAVE,10,114,92,14,WS_GROUP
    PUSHBUTTON      "Accept &once",IDB_HOSTKEY_ONCE,104,114,92,14
    PUSHBUTTON      "Cancel",IDCANCEL,198,114,92,14
END

IDD_PROMPT DIALOGEX 0, 0, 300, 170
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "SFTP"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "",IDC_PROMPT_INSTRUCTION,10,8,280,24,SS_NOPREFIX
    LTEXT           "",IDC_PROMPT_LABEL1,10,36,280,8,SS_NOPREFIX
    EDITTEXT        IDE_PROMPT1,10,46,280,12,ES_AUTOHSCROLL | ES_PASSWORD
    LTEXT           "",IDC_PROMPT_LABEL1+1,10,64,280,8,SS_NOPREFIX
    EDITTEXT        IDE_PROMPT1+1,10,74,280,12,ES_AUTOHSCROLL | ES_PASSWORD
    LTEXT           "",IDC_PROMPT_LABEL1+2,10,92,280,8,SS_NOPREFIX
    EDITTEXT        IDE_PROMPT1+2,10,102,280,12,ES_AUTOHSCROLL | ES_PASSWORD
    LTEXT           "",IDC_PROMPT_LABEL1+3,10,120,280,8,SS_NOPREFIX
    EDITTEXT        IDE_PROMPT1+3,10,130,280,12,ES_AUTOHSCROLL | ES_PASSWORD
    DEFPUSHBUTTON   "OK",IDOK,168,150,60,14,WS_GROUP
    PUSHBUTTON      "Cancel",IDCANCEL,230,150,60,14
END

IDD_SITELIST DIALOGEX 0, 0, 330, 196
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "SFTP - Sites"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_SITELIST_LIST,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,7,7,250,150
    DEFPUSHBUTTON   "&Connect",IDOK,263,7,60,14,WS_GROUP
    PUSHBUTTON      "&New...",IDB_SITELIST_NEW,263,31,60,14
    PUSHBUTTON      "&Edit...",IDB_SITELIST_EDIT,263,49,60,14
    PUSHBUTTON      "&Delete",IDB_SITELIST_DELETE,263,67,60,14
    PUSHBUTTON      "&Rename...",IDB_SITELIST_RENAME,263,85,60,14
    PUSHBUTTON      "D&uplicate",IDB_SITELIST_DUPLICATE,263,103,60,14
    PUSHBUTTON      "Close",IDCANCEL,263,143,60,14
    LTEXT           "&Quick connect (user@host[:port][/path]):",IDC_STATIC,7,164,250,8
    EDITTEXT        IDE_SITELIST_QUICK,7,175,250,12,ES_AUTOHSCROLL
END

IDD_OPERATION DIALOGEX 0, 0, 360, 236
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CENTER | WS_MINIMIZEBOX | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "SFTP"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "From:",IDC_STATIC,7,7,28,8
    LTEXT           "",IDC_OP_SOURCE,38,7,315,8,SS_NOPREFIX | SS_PATHELLIPSIS
    LTEXT           "To:",IDC_STATIC,7,19,28,8
    LTEXT           "",IDC_OP_TARGET,38,19,315,8,SS_NOPREFIX | SS_PATHELLIPSIS
    LTEXT           "File:",IDC_STATIC,7,33,28,8
    LTEXT           "",IDC_OP_FILE,38,33,315,8,SS_NOPREFIX | SS_PATHELLIPSIS
    CONTROL         "",IDC_OP_PROGRESS,"msctls_progress32",PBS_SMOOTH,7,45,346,10
    LTEXT           "",IDC_OP_STATS,7,59,346,16,SS_NOPREFIX
    LTEXT           "",IDC_OP_STATUS,7,78,346,8,SS_NOPREFIX
    CONTROL         "&Errors only",IDX_OP_ERRORS_ONLY,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,91,120,10
    CONTROL         "",IDC_OP_LIST,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,7,104,346,90
    PUSHBUTTON      "&Pause",IDB_OP_PAUSE,7,200,56,14,WS_GROUP
    PUSHBUTTON      "&Cancel",IDB_OP_CANCEL,66,200,56,14
    PUSHBUTTON      "&Solve error...",IDB_OP_SOLVE,125,200,56,14
    PUSHBUTTON      "Retry all &failed",IDB_OP_RETRY,184,200,64,14
    PUSHBUTTON      "&Hide",IDB_OP_HIDE,297,200,56,14
    CONTROL         "Close this window when &done",IDX_OP_CLOSE_WHEN_DONE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,220,200,10
END

IDD_SOLVE_ERROR DIALOGEX 0, 0, 320, 168
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "SFTP - Solve Error"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "",IDC_SOLVE_NAME,10,8,300,8,SS_NOPREFIX | SS_PATHELLIPSIS
    LTEXT           "",IDC_SOLVE_MESSAGE,10,20,300,24,SS_NOPREFIX
    LTEXT           "",IDC_SOLVE_SOURCE,10,48,300,8,SS_NOPREFIX
    LTEXT           "",IDC_SOLVE_TARGET,10,60,300,8,SS_NOPREFIX
    PUSHBUTTON      "&Overwrite",IDB_SOLVE_OVERWRITE,10,78,70,14,WS_GROUP
    PUSHBUTTON      "Re&sume",IDB_SOLVE_RESUME,85,78,70,14
    PUSHBUTTON      "&Retry",IDB_SOLVE_RETRY,160,78,70,14
    PUSHBUTTON      "S&kip",IDB_SOLVE_SKIP,235,78,70,14
    LTEXT           "&New name:",IDC_STATIC,10,100,300,8
    EDITTEXT        IDE_SOLVE_NEWNAME,10,110,220,12,ES_AUTOHSCROLL
    PUSHBUTTON      "Re&name",IDB_SOLVE_RENAME,235,109,70,14
    CONTROL         "&Apply to all items with this problem",IDX_SOLVE_ALL,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,132,300,10
    PUSHBUTTON      "Close",IDCANCEL,235,148,70,14
END

IDD_OPERATIONS DIALOGEX 0, 0, 380, 150
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "SFTP - Operations"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
