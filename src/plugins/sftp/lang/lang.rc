// English resources of the SFTP plugin. Hand-written: not edited by Microsoft Visual C++.

#pragma code_page(65001)

#include "winresrc.h"

#include "lang.rh"
#include "..\sftp.rh2"

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_NEU)
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

#include "lang.rc2" // strings

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_HOSTKEY DIALOGEX 0, 0, 300, 134
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "SFTP"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "",IDC_HOSTKEY_MESSAGE,10,8,280,56,SS_NOPREFIX
    LTEXT           "&Host:",IDC_STATIC,10,70,60,8
    EDITTEXT        IDE_HOSTKEY_HOST,72,68,218,12,ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "Key &type:",IDC_STATIC,10,86,60,8
    EDITTEXT        IDE_HOSTKEY_TYPE,72,84,218,12,ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "&Fingerprint:",IDC_STATIC,10,102,60,8
    EDITTEXT        IDE_HOSTKEY_FINGERPRINT,72,100,218,12,ES_AUTOHSCROLL | ES_READONLY
    DEFPUSHBUTTON   "&Accept and save",IDB_HOSTKEY_SAVE,10,114,92,14,WS_GROUP
    PUSHBUTTON      "Accept &once",IDB_HOSTKEY_ONCE,104,114,92,14
    PUSHBUTTON      "Cancel",IDCANCEL,198,114,92,14
END

IDD_PROMPT DIALOGEX 0, 0, 300, 170
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "SFTP"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "",IDC_PROMPT_INSTRUCTION,10,8,280,24,SS_NOPREFIX
    LTEXT           "",IDC_PROMPT_LABEL1,10,36,280,8,SS_NOPREFIX
    EDITTEXT        IDE_PROMPT1,10,46,280,12,ES_AUTOHSCROLL | ES_PASSWORD
    LTEXT           "",IDC_PROMPT_LABEL1+1,10,64,280,8,SS_NOPREFIX
    EDITTEXT        IDE_PROMPT1+1,10,74,280,12,ES_AUTOHSCROLL | ES_PASSWORD
    LTEXT           "",IDC_PROMPT_LABEL1+2,10,92,280,8,SS_NOPREFIX
    EDITTEXT        IDE_PROMPT1+2,10,102,280,12,ES_AUTOHSCROLL | ES_PASSWORD
    LTEXT           "",IDC_PROMPT_LABEL1+3,10,120,280,8,SS_NOPREFIX
    EDITTEXT        IDE_PROMPT1+3,10,130,280,12,ES_AUTOHSCROLL | ES_PASSWORD
    DEFPUSHBUTTON   "OK",IDOK,168,150,60,14,WS_GROUP
    PUSHBUTTON      "Cancel",IDCANCEL,230,150,60,14
END

IDD_SITELIST DIALOGEX 0, 0, 330, 196
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "SFTP - Sites"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_SITELIST_LIST,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,7,7,250,150
    DEFPUSHBUTTON   "&Connect",IDOK,263,7,60,14,WS_GROUP
    PUSHBUTTON      "&New...",IDB_SITELIST_NEW,263,31,60,14
    PUSHBUTTON      "&Edit...",IDB_SITELIST_EDIT,263,49,60,14
    PUSHBUTTON      "&Delete",IDB_SITELIST_DELETE,263,67,60,14
    PUSHBUTTON      "&Rename...",IDB_SITELIST_RENAME,263,85,60,14
    PUSHBUTTON      "D&uplicate",IDB_SITELIST_DUPLICATE,263,103,60,14
    PUSHBUTTON      "Close",IDCANCEL,263,143,60,14
    LTEXT           "&Quick connect (user@host[:port][/path]):",IDC_STATIC,7,164,250,8
    EDITTEXT        IDE_SITELIST_QUICK,7,175,250,12,ES_AUTOHSCROLL
END

IDD_SITENAME DIALOGEX 0, 0, 220, 60
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Rename Site"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "&Name:",IDC_STATIC,7,8,206,8
    EDITTEXT        IDE_SITENAME_NAME,7,19,206,12,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK",IDOK,92,39,60,14,WS_GROUP
    PUSHBUTTON      "Cancel",IDCANCEL,153,39,60,14
END

IDD_SITEEDIT DIALOGEX 0, 0, 290, 236
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "SFTP Site"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_SITEEDIT_TABS,"SysTabControl32",WS_TABSTOP,7,7,276,195
    DEFPUSHBUTTON   "OK",IDOK,159,215,60,14,WS_GROUP
    PUSHBUTTON      "Cancel",IDCANCEL,223,215,60,14
END

IDD_SITETAB_SESSION DIALOGEX 0, 0, 260, 150
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD | WS_TABSTOP
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "&Name:",IDC_STATIC,4,6,70,8
    EDITTEXT        IDE_SITE_NAME,78,4,176,12,ES_AUTOHSCROLL
    LTEXT           "&Host name:",IDC_STATIC,4,24,70,8
    EDITTEXT        IDE_SITE_HOST,78,22,176,12,ES_AUTOHSCROLL
    LTEXT           "&Port:",IDC_STATIC,4,42,70,8
    EDITTEXT        IDE_SITE_PORT,78,40,40,12,ES_AUTOHSCROLL
    LTEXT           "&User name:",IDC_STATIC,4,60,70,8
    EDITTEXT        IDE_SITE_USER,78,58,176,12,ES_AUTOHSCROLL
    LTEXT           "Pass&word:",IDC_STATIC,4,78,70,8
    EDITTEXT        IDE_SITE_PASSWORD,78,76,176,12,ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT           "",IDC_SITE_PASSWORD_HINT,78,91,176,16,SS_NOPREFIX
    CONTROL         "&Remember the password and the key passphrase",IDX_SITE_REMEMBER,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,4,112,250,10
    CONTROL         "&Forget the stored password and passphrase",IDX_SITE_FORGET,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,4,128,250,10
END

IDD_SITETAB_AUTH DIALOGEX 0, 0, 260, 150
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD | WS_TABSTOP
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "Use the SSH &agent (Pageant or OpenSSH agent)",IDX_SITE_AGENT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,4,6,250,10
    LTEXT           "Private &key file:",IDC_STATIC,4,26,250,8
    EDITTEXT        IDE_SITE_KEYFILE,4,36,190,12,ES_AUTOHSCROLL
    PUSHBUTTON      "&Browse...",IDB_SITE_KEYBROWSE,198,35,56,14
    LTEXT           "Key &passphrase:",IDC_STATIC,4,56,250,8
    EDITTEXT        IDE_SITE_PASSPHRASE,4,66,190,12,ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT           "",IDC_SITE_PASSPHRASE_HINT,4,81,250,16,SS_NOPREFIX
    LTEXT           "The passphrase is remembered together with the password (see the Session tab). If the server uses keyboard-interactive authentication, it asks for the answers when you connect.",IDC_STATIC,4,104,250,32
END

IDD_SITETAB_CONNECTION DIALOGEX 0, 0, 260, 150
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD | WS_TABSTOP
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "&Timeout:",IDC_STATIC,4,6,70,8
    EDITTEXT        IDE_SITE_TIMEOUT,78,4,40,12,ES_AUTOHSCROLL
    LTEXT           "seconds",IDC_STATIC,122,6,60,8
    CONTROL         "Use &compression",IDX_SITE_COMPRESSION,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,4,26,250,10
    GROUPBOX        "File name encoding",IDC_STATIC,4,46,250,70
    CONTROL         "&UTF-8",IDR_SITE_ENC_UTF8,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,12,60,230,10
    CONTROL         "&Auto-detect (UTF-8, otherwise the system code page)",IDR_SITE_ENC_AUTO,"Button",BS_AUTORADIOBUTTON,12,74,236,10
    CONTROL         "Code pa&ge:",IDR_SITE_ENC_CODEPAGE,"Button",BS_AUTORADIOBUTTON,12,90,66,10
    EDITTEXT        IDE_SITE_CODEPAGE,82,88,40,12,ES_AUTOHSCROLL
END

IDD_SITETAB_DIRECTORIES DIALOGEX 0, 0, 260, 150
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD | WS_TABSTOP
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Initial &remote directory (empty: the login directory):",IDC_STATIC,4,6,250,8
    EDITTEXT        IDE_SITE_REMOTEPATH,4,16,250,12,ES_AUTOHSCROLL
    LTEXT           "Initial &local directory:",IDC_STATIC,4,38,250,8
    EDITTEXT        IDE_SITE_LOCALPATH,4,48,250,12,ES_AUTOHSCROLL
END
#endif
