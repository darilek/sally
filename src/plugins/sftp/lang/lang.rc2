STRINGTABLE
{
 IDS_PLUGINNAME,             "SFTP"
 IDS_PLUGIN_DESCRIPTION,     "SFTP client for Sally."
 IDS_ABOUT,                  "About SFTP Plugin"
 // arguments: plugin name, plugin version, copyright, description, libssh2 version, OpenSSL version text
 IDS_ABOUT_FORMAT,           "%ls %ls\n\n%ls\n\n%ls\n\nlibssh2 %hs\n%hs"
 IDS_NOT_IMPLEMENTED,        "SFTP: connecting will be available in a later version."
 // argument: libssh2 error code
 IDS_LIBSSH2_INIT_FAILED,    "SFTP: the libssh2 library could not be initialized (error %d). The plugin cannot be loaded."
 // item in the Change Drive menu: hotkey, TAB, title
 IDS_CHNGDRVITEM,            "\tSFTP"
}
