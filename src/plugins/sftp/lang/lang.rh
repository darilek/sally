#define IDD_CHMOD                 1013
#define IDX_CHMOD_FIRST_BIT       1460
#define IDX_CHMOD_OWNER_R         1460
#define IDX_CHMOD_OWNER_W         1461
#define IDX_CHMOD_OWNER_X         1462
#define IDX_CHMOD_GROUP_R         1463
