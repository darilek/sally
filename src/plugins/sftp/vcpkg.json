{
  "name": "sally-sftp",
  "version-string": "1.0.0",
  "description": "Third-party libraries of the Sally SFTP plugin, linked statically into sftp.dll",
  "builtin-baseline": "9eec002df1cd109f8f104cd966a763daf9751489",
  "dependencies": [
    {
      "name": "libssh2",
      "default-features": false,
      "features": [ "openssl", "zlib" ]
    },
    "openssl",
    "zlib",
    "gtest"
  ],
  "overrides": [
    { "name": "libssh2", "version": "1.11.1", "port-version": 3 },
    { "name": "openssl", "version": "3.6.5", "port-version": 2 },
    { "name": "zlib", "version": "1.3.2", "port-version": 2 },
    { "name": "gtest", "version": "1.18.0" }
  ]
}
