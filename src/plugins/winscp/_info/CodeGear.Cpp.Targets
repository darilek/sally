<!--
===============================================================================================

  CodeGear.Cpp.Targets

  WARNING

  DO NOT MODIFY unless you have made a backup of these files.  Modifying
  this file unless you have knowledge about MSBuild you could cause problems
  when loading or building projects in the IDE or building from the
  command-line.

===============================================================================================
-->

<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" DefaultTargets="Make">

  <Import Project="$(BDS)\bin\CodeGear.Common.Targets" Condition="Exists('$(BDS)\bin\CodeGear.Common.Targets')"/>
  <Import Project="$(BDS)\bin\CodeGear.Idl.Targets" Condition="Exists('$(BDS)\bin\CodeGear.Idl.Targets')"/>
  <Import Project="$(BDS)\bin\CodeGear.Deployment.Targets" Condition="Exists('$(BDS)\bin\CodeGear.Deployment.Targets')"/>

  <UsingTask TaskName="BCC32" AssemblyFile="$(BDS)\bin\Borland.Build.Tasks.Cpp.dll"/>
  <UsingTask TaskName="BRCC32" AssemblyFile="$(BDS)\bin\Borland.Build.Tasks.Shared.dll"/>
  <UsingTask TaskName="TASM32" AssemblyFile="$(BDS)\bin\Borland.Build.Tasks.Cpp.dll"/>
  <UsingTask TaskName="DCC" AssemblyFile="$(BDS)\bin\Borland.Build.Tasks.Delphi.dll"/>
  <UsingTask TaskName="ILINK32" AssemblyFile="$(BDS)\bin\Borland.Build.Tasks.Cpp.dll"/>
  <UsingTask TaskName="LD" AssemblyFile="$(BDS)\bin\Borland.Build.Tasks.Cpp.dll"/>
  <UsingTask TaskName="TLIB" AssemblyFile="$(BDS)\bin\Borland.Build.Tasks.Cpp.dll"/>
  <UsingTask TaskName="CPP32" AssemblyFile="$(BDS)\bin\Borland.Build.Tasks.Cpp.dll"/>
  <UsingTask TaskName="CLANG" AssemblyFile="$(BDS)\bin\Borland.Build.Tasks.Cpp.dll"/>
  <UsingTask TaskName="InvokeMSBuild" AssemblyFile="$(BDS)\bin\Borland.Build.Tasks.Shared.dll"/>
  <UsingTask TaskName="DependencyCheck" AssemblyFile="$(BDS)\bin\Borland.Build.Tasks.Shared.dll"/>
  <UsingTask TaskName="BccDependencyCheck" AssemblyFile="$(BDS)\bin\Borland.Build.Tasks.Cpp.dll"/>
  <UsingTask TaskName="CopyItem" AssemblyFile="$(BDS)\bin\Borland.Build.Tasks.Shared.dll"/>
  <UsingTask TaskName="FindItems" AssemblyFile="$(BDS)\bin\Borland.Build.Tasks.Shared.dll"/>
  <UsingTask TaskName="ItemSort" AssemblyFile="$(BDS)\bin\Borland.Build.Tasks.Shared.dll"/>
  <UsingTask TaskName="CreateTempDpr" AssemblyFile="$(BDS)\bin\Borland.Build.Tasks.Cpp.dll"/>
  <UsingTask TaskName="MessageMap" AssemblyFile="$(BDS)\bin\Borland.Build.Tasks.Shared.dll"/>
  <UsingTask TaskName="SendKibitzOptions" AssemblyFile="$(BDS)\bin\Borland.Build.Tasks.Cpp.dll"/>
  <UsingTask TaskName="OBJCOPY" AssemblyFile="$(BDS)\bin\Borland.Build.Tasks.Shared.dll"/>

  <!-- Build Target Dependencies -->
  <PropertyGroup>
    <PreBuildEventDependsOn>
      _ResolveInput;
      _ResolveOutput;
    </PreBuildEventDependsOn>
    <PreLinkEventDependsOn>
      _ResolveInput;
      _ResolveOutput;
    </PreLinkEventDependsOn>
    <PostBuildEventDependsOn>
      _ResolveInput;
      _ResolveOutput;
    </PostBuildEventDependsOn>
    <RcCompileDependsOnTargets>_RcDepCheck;</RcCompileDependsOnTargets>
    <DependencyCheckDependsOnTargets>
      _PasDepCheck;
      _RidlDepCheck;
      _CppDepCheck;
      _PCHDepCheck;
      _AsmDepCheck;
      $(RcCompileDependsOnTargets);
    </DependencyCheckDependsOnTargets>
    <MakeDependsOnTargets>
      $(MakeDependsOnTargets);
      _CheckPlatformVariable;
      _CheckGetItPackageDependencies;
      _MakePreReq;
      _ResolveOutput;
      CreateDirectories;
      _RunUserTools;
      PreBuildEvent;
      _PreOutputTimeStamp;
      MakeObjs;
      Link;
      BuildAndroidServiceJarFile;
      _PostOutputTimeStamp;
      MakeStaticPackage;
      PostBuildEvent;
      GenOSX64Outputs;
      GenAndroid32Outputs
    </MakeDependsOnTargets>
    <BuildDependsOnTargets>
      _ForceRebuild;
      CleanLinkerStateFiles;
      $(MakeDependsOnTargets);
      AutoIncBuildNumber
    </BuildDependsOnTargets>
    <MakeOneDependsOnTargets>
      $(MakeOneDependsOnTargets);
      _ResolveConfiguration;
      _MakeOnePreReq;
      _ResolveInput;
      _ResolveFileToCompile;
      CreateDirectories;
      PreBuildEvent;
      _PreOutputTimeStamp;
      _MakeOne;
      _PostOutputTimeStamp;
      PostBuildEvent;
    </MakeOneDependsOnTargets>
    <BuildOneDependsOnTargets>
      _ForceRebuild;
      $(MakeOneDependsOnTargets);
    </BuildOneDependsOnTargets>
    <LinkDependsOnTargets Condition="'$(_SkipLink)'!='true'">
      $(LinkDependsOnTargets);
      _ResolveOutput;
      CreateDirectories;
      PreLinkEvent;
      _PerformLink;
    </LinkDependsOnTargets>
    <CoreCompileDependsOnTargets Condition="'$(BCC_EnableBatchCompilation)'!='true'">
      RidlCompile;
      PasCompile;
      CppCompile;
      AsmCompile;
      RcCompile;
    </CoreCompileDependsOnTargets>
    <CoreCompileDependsOnTargets Condition="'$(BCC_EnableBatchCompilation)'=='true'">
      RidlCompile;
      PasCompile;
      CppBatchCompile;
      AsmCompile;
      RcCompile;
    </CoreCompileDependsOnTargets>
    <CleanDependsOnTargets>
      CleanDexCompilationOutputFiles;
      CleanOutputFiles;
      CleanAndroidApkRootDir;
      CleanUWPAppxRootDir;
      CleanLinkOutput;
      StaticPackageClean;
      CleanJavaClassesOutputDir;
      CleanOSX64Outputs;
      CleanAndroid32Outputs
    </CleanDependsOnTargets>
    <_ResolveOutputDependsOn Condition="'$(FileToCompile)'==''">
       BuildShouldBuildVersion;
      _ResolveIcons;
      _ResolveCompiledOutput;
      _ResolveOther;
    </_ResolveOutputDependsOn>
    <_ResolveOutputDependsOn Condition="'$(FileToCompile)'!=''">
      _ResolveFileToCompile;
    </_ResolveOutputDependsOn>
    <PreprocessDependsOnTargets>
      _CheckPlatformVariable;
      $(PreprocessDependsOnTargets);
      _ResolveInput;
    </PreprocessDependsOnTargets>
    <ToAssemblyDependsOnTargets>
      _CheckPlatformVariable;
      $(ToAssemblyDependsOnTargets);
      _ResolveInput;
    </ToAssemblyDependsOnTargets>
    <_EvaluatePropertyDependsOnTargets>
      _ResolveInput;
      _ResolveOutput;
    </_EvaluatePropertyDependsOnTargets>
    <_EvaluateItemDependsOnTargets>
      $(_EvaluatePropertyDependsOnTargets)
    </_EvaluateItemDependsOnTargets>
    <_EvaluateOutputsDependsOnTargets>
      $(_EvaluatePropertyDependsOnTargets);
      _GatherOutputs;
    </_EvaluateOutputsDependsOnTargets>
    <_ResolveGENTLBBindingsTarget>
      _ResolveGENTLBBindings;
    </_ResolveGENTLBBindingsTarget>
  </PropertyGroup>

  <!-- Project invariants -->
  <PropertyGroup Condition="'$(Platform)'=='$(cOSX32Platform)'">
      <StartupObjConsole>start.o</StartupObjConsole>
      <StartupObjGui>start.o</StartupObjGui>
      <StartupObjGui Condition="'$(FrameworkType)'=='FMX'">start_fmx.o</StartupObjGui>
      <StartupObjLibrary>start_dylib.o</StartupObjLibrary>
      <StartupObjPackage>start_pkg.o</StartupObjPackage>
      <ILinkTarget>-Tm</ILinkTarget>
      <CommonLibraries>libcgunwind.1.0.dylib;libSystem.B.dylib;libiconv.dylib;libmathcommon.A.dylib;libobjc.A.dylib;libpcre.dylib;libz.dylib</CommonLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='$(cWin32Platform)'">
      <StartupObjConsole Condition="'$(StartupObjConsole)'==''">c0x32</StartupObjConsole>
      <StartupObjGui Condition="'$(FrameworkType)'!='FMX' And '$(StartupObjGui)'==''">c0w32</StartupObjGui>
      <StartupObjGui Condition="'$(FrameworkType)'=='FMX' And '$(StartupObjGui)'==''">c0fmx32</StartupObjGui>
      <StartupObjLibrary Condition="'$(StartupObjLibrary)'==''">c0d32</StartupObjLibrary>
      <StartupObjPackage Condition="'$(StartupObjPackage)'==''">c0pkg32</StartupObjPackage>
      <ILinkTarget>-Tp</ILinkTarget>
      <CommonLibraries Condition="'$(CommonLibraries)'==''">import32.lib</CommonLibraries>
      <!-- Default to Classic (Borland) BCC32 -->
      <BCC_UseClassicCompiler Condition="'$(BCC_UseClassicCompiler)'==''">true</BCC_UseClassicCompiler>
      <USING_CLANG_WIN32 Condition="'$(Platform)'=='$(cWin32Platform)' And '$(BCC_UseClassicCompiler)'=='false'">true</USING_CLANG_WIN32>
      <USING_CLANG_WIN32 Condition="'$(Platform)'=='$(cWin32Platform)' And '$(UseClang32Compiler)'=='true'">true</USING_CLANG_WIN32>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='$(cWin64Platform)'">
      <StartupObjConsole>c0x64</StartupObjConsole>
      <StartupObjGui>c0w64</StartupObjGui>
      <StartupObjGui Condition="'$(FrameworkType)'=='FMX'">c0fmx64</StartupObjGui>
      <StartupObjLibrary>c0d64</StartupObjLibrary>
      <StartupObjPackage>c0pkg64</StartupObjPackage>
      <ILinkTarget>-Tp</ILinkTarget>
      <CommonLibraries>import64.a</CommonLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='$(cWin64xPlatform)'">
      <StartupObjConsole>$(BDS)\x86_64-w64-mingw32\lib\crt2u.o</StartupObjConsole>
      <StartupObjConsole Condition="'$(_TCHARMapping)'=='' Or '$(_TCHARMapping)'=='char'">$(BDS)\x86_64-w64-mingw32\lib\crt2.o</StartupObjConsole>
      <StartupObjGui>$(BDS)\x86_64-w64-mingw32\lib\crt2u.o</StartupObjGui>
      <StartupObjGui Condition="'$(_TCHARMapping)'=='' Or '$(_TCHARMapping)'=='char'">$(BDS)\x86_64-w64-mingw32\lib\crt2.o</StartupObjGui>
      <StartupObjLibrary>$(BDS)\x86_64-w64-mingw32\lib\dllcrt2.o</StartupObjLibrary>
      <StartupObjPackage>$(BDS)\x86_64-w64-mingw32\lib\pkgcrt.o</StartupObjPackage>
      <EndCodeObj>$(BDS)\x86_64-w64-mingw32\lib\crtend.o</EndCodeObj>
      <ILinkTarget></ILinkTarget>
      <CommonLibraries>import64.lib</CommonLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='$(ciOSDevice32Platform)' Or '$(Platform)'=='$(ciOSDevice64Platform)'">
      <StartupObjConsole>start_ios_main.o</StartupObjConsole>
      <StartupObjGui>start_ios.o</StartupObjGui>
      <StartupObjGui Condition="'$(FrameworkType)'=='FMX'">start_ios.o</StartupObjGui>
      <StartupObjLibrary></StartupObjLibrary>
      <StartupObjPackage></StartupObjPackage>
      <EndCodeObj>end_ios.o</EndCodeObj>
      <ILinkTarget></ILinkTarget>
      <CommonLibraries></CommonLibraries>
      <STDCLib Condition="Exists('$(Profile_sysroot)\usr\lib\libstdc++.dylib')">stdc++</STDCLib>
      <STDCLib Condition="!Exists('$(Profile_sysroot)\usr\lib\libstdc++.dylib')"></STDCLib>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='$(cAndroidArm32Platform)'">
      <StartupObjConsole>$(NDKApiPath)\arch-arm\usr\lib\crtbegin_so.o</StartupObjConsole>
      <StartupObjGui>$(NDKApiPath)\arch-arm\usr\lib\crtbegin_so.o</StartupObjGui>
      <StartupObjGui Condition="'$(FrameworkType)'=='FMX'">$(NDKApiPath)\arch-arm\usr\lib\crtbegin_so.o</StartupObjGui>
      <StartupObjLibrary></StartupObjLibrary>
      <StartupObjPackage></StartupObjPackage>
      <EndCodeObj>$(NDKApiPath)\arch-arm\usr\lib\crtend_so.o</EndCodeObj>
      <ILinkTarget></ILinkTarget>
      <CommonLibraries></CommonLibraries>
      <STDCLib>c++_static;c++abi</STDCLib>
      <STDCInclude></STDCInclude>
      <BCC_SystemIncludePath>$(NDKBasePath)\sources\cxx-stl\llvm-libc++\include;$(BCC_SystemIncludePath)</BCC_SystemIncludePath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='$(cAndroidArm64Platform)'">
      <StartupObjConsole>$(NDKApiPath)\arch-arm64\usr\lib\crtbegin_so.o</StartupObjConsole>
      <StartupObjGui>$(NDKApiPath)\arch-arm64\usr\lib\crtbegin_so.o</StartupObjGui>
      <StartupObjGui Condition="'$(FrameworkType)'=='FMX'">$(NDKApiPath)\arch-arm64\usr\lib\crtbegin_so.o</StartupObjGui>
      <StartupObjLibrary></StartupObjLibrary>
      <StartupObjPackage></StartupObjPackage>
      <EndCodeObj>$(NDKApiPath)\arch-arm64\usr\lib\crtend_so.o</EndCodeObj>
      <ILinkTarget></ILinkTarget>
      <CommonLibraries></CommonLibraries>
      <STDCLib>c++_static</STDCLib>
      <STDCInclude></STDCInclude>
      <BCC_SystemIncludePath>$(NDKBasePath)\sources\cxx-stl\llvm-libc++\include;$(BCC_SystemIncludePath)</BCC_SystemIncludePath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='$(cLinux64Platform)'">
      <StartupObjConsole>$(Profile_startupobj)</StartupObjConsole>
      <StartupObjLibrary>$(Profile_startupobjS)</StartupObjLibrary>
      <StartupObjPackage>$(Profile_startupobjS)</StartupObjPackage>
      <EndCodeObj>$(Profile_endcodeobj)</EndCodeObj>
      <EndCodeObjShared>$(Profile_endcodeobjS)</EndCodeObjShared>
  </PropertyGroup>


  <!-- Map old C++-specific $(ProjectType) to new $(AppType) common variable -->
  <Choose>
    <When Condition="'$(ProjectType)'=='CppPackage'">
      <PropertyGroup>
        <AppType>Package</AppType>
      </PropertyGroup>
    </When>
    <When Condition="'$(ProjectType)'=='CppConsoleApplication' Or '$(ProjectType)'=='CppManagedConsoleApp'">
      <PropertyGroup>
        <AppType>Console</AppType>
      </PropertyGroup>
    </When>
    <When Condition="'$(ProjectType)'=='CppDynamicLibrary'
      Or '$(ProjectType)'=='CppActiveLibrary'
      Or '$(ProjectType)'=='VCppStyleDLL'
      Or '$(ProjectType)'=='CppManagedDynamicLibrary'">
      <PropertyGroup>
        <AppType>Library</AppType>
      </PropertyGroup>
    </When>
    <When Condition="'$(ProjectType)'=='CppStaticLibrary'">
      <PropertyGroup>
        <AppType>StaticLibrary</AppType>
      </PropertyGroup>
    </When>
    <Otherwise>
      <PropertyGroup Condition="'$(AppType)'==''">
        <AppType>Application</AppType>
      </PropertyGroup>
    </Otherwise>
  </Choose>

  <Choose>
    <When Condition="'$(AppType)'=='Package'">
      <PropertyGroup>
        <StartupObj>$(StartupObjPackage)</StartupObj>
        <EndCodeObj Condition="'$(Platform)'=='$(cLinux64Platform)'">$(EndCodeObjShared)</EndCodeObj>
        <EndCodeObj Condition="'$(Platform)'=='$(cWin64xPlatform)'">$(EndCodeObj)</EndCodeObj>
        <BCC_GenerateDLL Condition="'$(Platform)'=='$(cWin32Platform)'">true</BCC_GenerateDLL>
        <BCC_GeneratePackage Condition="('$(Platform)'=='$(cWin64Platform)' Or '$(Platform)'=='$(cWin64xPlatform)' Or '$(USING_CLANG_WIN32)'=='true' Or '$(Platform)'=='$(cLinux64Platform)') And '$(_DoingStaticPackageBuild)'!='true'">true</BCC_GeneratePackage>
        <ILINK_AppType Condition="'$(Platform)'=='$(cWin32Platform)'">Windows</ILINK_AppType>
        <ILinkTarget>$(ILinkTarget)p</ILinkTarget>
        <UsingDelphiRTL>true</UsingDelphiRTL>
        <Multithreaded>true</Multithreaded>
        <UsePackages>true</UsePackages>
        <OutputExt Condition="'$(OutputExt)'==''">$(BplExt)</OutputExt>
        <ILINK_PackageType Condition="'$(DesignOnlyPackage)'=='true'">Designtime</ILINK_PackageType>
        <ILINK_PackageType Condition="'$(RuntimeOnlyPackage)'=='true'">Runtime</ILINK_PackageType>
        <ILINK_PackageType Condition="'$(ILINK_PackageType)'==''">Both</ILINK_PackageType>
        <DCC_CBuilderOutput Condition="'$(DCC_CBuilderOutput)'=='All'">JPHNE</DCC_CBuilderOutput>
        <DCC_CBuilderOutput Condition="'$(_DoingStaticPackageBuild)'=='true'">JPHN</DCC_CBuilderOutput>
        <BCC_OutputDir Condition="'$(BCC_OutputDir)'!='' And !HasTrailingSlash('$(BCC_OutputDir)')">$(BCC_OutputDir)\</BCC_OutputDir>
        <!--
        <BCC_OutputDir Condition="'$(_DoingStaticPackageBuild)'=='true'">$(BCC_OutputDir)staticobjs</BCC_OutputDir>
        -->
        <TLibLink Condition="'$(Platform)'=='$(ciOSDevice32Platform)' Or
                             '$(Platform)'=='$(ciOSDevice64Platform)' Or
                             '$(Platform)'=='$(ciOSSimulatorArm64Platform)' Or
                             '$(Platform)'=='$(cAndroidArm32Platform)' Or
                             '$(Platform)'=='$(cAndroidArm64Platform)'">true</TLibLink>
        <DllPrefix>$(BplPlatformPrefix)</DllPrefix>
        <LD_PackageDescription_lld Condition="'$(Platform)'=='$(cWin64xPlatform)'">$(ILINK_Description)</LD_PackageDescription_lld>
        <LD_EntryPointSymbol Condition="'$(Platform)'=='$(cWin64xPlatform)'">DllMainCRTStartup</LD_EntryPointSymbol>
        <LD_GenerateImportLibrary_lld Condition="'$(ILINK_GenerateImportLibrary)'=='true' And '$(Platform)'=='$(cWin64xPlatform)'">@(ImportLibrary)</LD_GenerateImportLibrary_lld>
      </PropertyGroup>
    </When>
    <When Condition="'$(AppType)'=='Console'">
      <PropertyGroup>
        <StartupObj>$(StartupObjConsole)</StartupObj>
        <BCC_GenerateConsoleApp>true</BCC_GenerateConsoleApp>
        <ILINK_AppType Condition="'$(Platform)'=='$(cWin32Platform)'">Console</ILINK_AppType>
        <ILinkTarget>$(ILinkTarget)e</ILinkTarget>
        <OutputExt Condition="'$(OutputExt)'==''">$(ExeExt)</OutputExt>
      </PropertyGroup>
    </When>
    <When Condition="'$(AppType)'=='Library'">
      <PropertyGroup>
        <StartupObj>$(StartupObjLibrary)</StartupObj>
        <EndCodeObj Condition="'$(Platform)'=='$(cLinux64Platform)'">$(EndCodeObjShared)</EndCodeObj>
        <BCC_GenerateDLL>true</BCC_GenerateDLL>
        <ILinkTarget>$(ILinkTarget)d</ILinkTarget>
        <OutputExt Condition="'$(OutputExt)'==''">$(DllExt)</OutputExt>
        <LD_EntryPointSymbol Condition="'$(Platform)'=='$(cWin64xPlatform)'">DllMainCRTStartup</LD_EntryPointSymbol>
        <LD_EnableAutoImageBase Condition="'$(Platform)'=='$(cWin64xPlatform)'">true</LD_EnableAutoImageBase>
        <LD_GenerateImportLibrary_lld Condition="'$(ILINK_GenerateImportLibrary)'=='true' And '$(Platform)'=='$(cWin64xPlatform)'">@(ImportLibrary)</LD_GenerateImportLibrary_lld>
      </PropertyGroup>
    </When>
    <When Condition="'$(AppType)'=='StaticLibrary'">
      <PropertyGroup>
        <StartupObj></StartupObj>
        <ILINK_AdditionalLibs></ILINK_AdditionalLibs>
        <BCC_GenerateWindowsApp Condition="'$(Platform)'=='$(cWin32Platform)'">true</BCC_GenerateWindowsApp>
        <OutputExt Condition="'$(OutputExt)'==''">$(LibExt)</OutputExt>
        <DllPrefix>$(StaticLibPrefix)</DllPrefix>
        <TLibLink>true</TLibLink>
      </PropertyGroup>
    </When>
    <Otherwise> <!-- Other GUI application -->
      <PropertyGroup>
        <StartupObj>$(StartupObjGui)</StartupObj>
        <BCC_GenerateWindowsApp Condition="'$(Platform)'=='$(cWin32Platform)' or '$(Platform)'=='$(cWin64Platform)' or '$(Platform)'=='$(cWin64xPlatform)'">true</BCC_GenerateWindowsApp>
        <ILINK_WinAppType>Executable</ILINK_WinAppType>
        <ILINK_AppType Condition="'$(Platform)'=='$(cWin32Platform)' or '$(Platform)'=='$(cWin64Platform)' or '$(Platform)'=='$(cWin64xPlatform)'">Windows</ILINK_AppType>
        <ILinkTarget>$(ILinkTarget)e</ILinkTarget>
        <OutputExt Condition="'$(OutputExt)'==''">$(ExeExt)</OutputExt>
        <LD_Subsystem Condition="'$(Platform)'=='$(cWin64xPlatform)'">windows</LD_Subsystem>
      </PropertyGroup>
    </Otherwise>
  </Choose>

  <!-- RTL, MT, VCL Settings -->

  <PropertyGroup>
    <!-- Property to indicate Compiler/Linker in use -->
    <USING_CLANG Condition="'$(USING_CLANG)'==''">false</USING_CLANG>
    <USING_CLANG Condition="'$(Platform)'=='$(cWin64Platform)'
        Or '$(Platform)'=='$(cWin64xPlatform)'
        Or '$(Platform)'=='$(ciOSSimulatorArm64Platform)'
        Or '$(Platform)'=='$(ciOSDevice32Platform)'
        Or '$(Platform)'=='$(ciOSDevice64Platform)'
        Or '$(Platform)'=='$(cAndroidArm32Platform)'
        Or '$(Platform)'=='$(cAndroidArm64Platform)'
        Or '$(Platform)'=='$(cLinux64Platform)'
        Or '$(Platform)'=='$(cOSX64Platform)'
        Or '$(Platform)'=='$(cOSXArm64Platform)'
        Or '$(USING_CLANG_WIN32)'=='true'">true</USING_CLANG>

    <USING_CLANG50 Condition="'$(USING_CLANG50)'==''">false</USING_CLANG50>
    <USING_CLANG50 Condition="'$(USING_CLANG)'=='true' and
                             ('$(Platform)'=='$(cWin64Platform)' or '$(USING_CLANG_WIN32)'=='true')">true</USING_CLANG50>

    <USING_CLANG150 Condition="'$(USING_CLANG150)'==''">false</USING_CLANG150>
    <USING_CLANG150 Condition="'$(USING_CLANG)'=='true' and
                              '$(Platform)'=='$(cWin64xPlatform)'">true</USING_CLANG150>

    <NO_LINK  Condition="'$(NO_LINK)'=='' ">false</NO_LINK>
    <USING_LD Condition="'$(Platform)'=='$(cAndroidArm32Platform)'
                      Or '$(Platform)'=='$(cAndroidArm64Platform)'
                      Or '$(Platform)'=='$(ciOSSimulatorArm64Platform)'
                      Or '$(Platform)'=='$(ciOSDevice32Platform)'
                      Or '$(Platform)'=='$(ciOSDevice64Platform)'
                      Or '$(Platform)'=='$(cLinux64Platform)'
                      Or '$(Platform)'=='$(cOSX64Platform)'
                      Or '$(Platform)'=='$(cOSXArm64Platform)'
                      Or '$(Platform)'=='$(cWin64xPlatform)'
                      ">true</USING_LD>
    <USING_LD Condition="'$(USING_LD)'==''">false</USING_LD>

    <UsingDelphiRTL Condition="'$(FrameworkType)'=='VCL' Or '$(FrameworkType)'=='FMX'">true</UsingDelphiRTL>
    <!-- Special flag for Win64 Console App linking to Delphi Runtime -->
    <ConWin64DelphiRTL Condition="'$(AppType)'=='Console' And ('$(Platform)'=='$(cWin64Platform)' Or '$(Platform)'=='$(cWin64xPlatform)') And '$(UsingDelphiRTL)'=='true'">true</ConWin64DelphiRTL>

    <SystemLibraryPath Condition="'$(ILINK_FullDebugInfo)'=='true'">$(BDSLIB)\$(Platform)\debug</SystemLibraryPath>
    <SystemLibraryPath Condition="'$(ILINK_FullDebugInfo)'!='true'">$(BDSLIB)\$(Platform)\release</SystemLibraryPath>
    <RtlHelperLibraryName>rtlhelper</RtlHelperLibraryName>
    <RtlHelperLibraryName Condition="'$(Platform)'=='$(cLinux64Platform)' And '$(AppType)'!='Console'">$(RtlHelperLibraryName)_PIC</RtlHelperLibraryName>
  </PropertyGroup>

  <!-- Force C++ RTL and Packages to match (be both static or dynamic) for Win64 and Win64x-->
  <PropertyGroup Condition="('$(Platform)'=='$(cWin64Platform)' Or '$(Platform)'=='$(cWin64xPlatform)') And '$(UsePackages)'!=''">
    <DynamicRTL>$(UsePackages)</DynamicRTL>
  </PropertyGroup>

  <!-- But static objects of Package use static RTL -->
  <PropertyGroup Condition="('$(Platform)'=='$(cWin64Platform)' Or '$(Platform)'=='$(cWin64xPlatform)') And '$(_DoingStaticPackageBuild)'=='true'">
    <DynamicRTL>false</DynamicRTL>
  </PropertyGroup>

  <!-- TODO: Refactor w/ simpler condition and have options under the same property group -->
  <PropertyGroup Condition="'$(Platform)'=='$(cAndroidArm32Platform)'
                         Or '$(Platform)'=='$(cAndroidArm64Platform)'
                         Or '$(Platform)'=='$(ciOSSimulatorArm64Platform)'
                         Or '$(Platform)'=='$(ciOSDevice32Platform)'
                         Or '$(Platform)'=='$(ciOSDevice64Platform)'">
    <DynamicRTL>false</DynamicRTL>
    <UsePackages>false</UsePackages>
    <!-- ARC is dead, long live NOARC -->
    <CLANG_BorlandAutoRefCount>false</CLANG_BorlandAutoRefCount>
  </PropertyGroup>

  <PropertyGroup>
    <RTLE Condition="'$(Platform)'=='$(cWin32Platform)' And '$(USING_CLANG_WIN32)'=='true'">rtle.lib</RTLE>
    <RTLE Condition="'$(Platform)'=='$(cWin32Platform)' And '$(USING_CLANG_WIN32)'!='true'">vcle.lib</RTLE>
    <RTLE Condition="'$(Platform)'=='$(cWin64xPlatform)' And '$(USING_CLANG150)'=='true'">rtle.lib</RTLE>
    <RTLE Condition="'$(RTLE)'==''">rtle.a</RTLE>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UsingDelphiRTL)'=='true' And '$(AppType)'!='Package' And '$(ConWin64DelphiRTL)'!='true'">
    <DelphiRTLLibs Condition="'$(LinkPackageStatics)'=='' And '$(UsePackages)'!='true' And '$(Platform)'=='$(cOSX32Platform)'">$(RTLE);rtl.a</DelphiRTLLibs>
    <DelphiRTLLibs Condition="'$(LinkPackageImports)'=='' And '$(UsePackages)'=='true' And '$(Platform)'=='$(cOSX32Platform)'">$(RTLE)</DelphiRTLLibs>
    <DelphiRTLLibs Condition="'$(LinkPackageStatics)'=='' And '$(UsePackages)'!='true' And '$(Platform)'=='$(cWin32Platform)'">$(RTLE);rtl.lib</DelphiRTLLibs>
    <DelphiRTLLibs Condition="'$(LinkPackageImports)'=='' And '$(UsePackages)'=='true' And '$(Platform)'=='$(cWin32Platform)'">$(RTLE)</DelphiRTLLibs>
    <DelphiRTLLibs Condition="'$(LinkPackageStatics)'=='' And '$(UsePackages)'!='true' And '$(Platform)'=='$(cWin64Platform)'">$(RTLE);rtl.a</DelphiRTLLibs>
    <DelphiRTLLibs Condition="'$(LinkPackageImports)'=='' And '$(UsePackages)'=='true' And '$(Platform)'=='$(cWin64Platform)'">$(RTLE)</DelphiRTLLibs>
    <DelphiRTLLibs Condition="'$(LinkPackageStatics)'=='' And '$(UsePackages)'!='true' And '$(Platform)'=='$(cWin64xPlatform)'">$(RTLE);rtl.lib</DelphiRTLLibs>
    <DelphiRTLLibs Condition="'$(LinkPackageImports)'=='' And '$(UsePackages)'=='true' And '$(Platform)'=='$(cWin64xPlatform)'">$(RTLE)</DelphiRTLLibs>
    <DelphiRTLBpis Condition="'$(LinkPackageImports)'=='' And '$(UsePackages)'=='true'">rtl.bpi</DelphiRTLBpis>
  </PropertyGroup>

  <!-- WIN64 and WIN64x Console apps linking to the Delphi runtime must ensure C++ and Delphi are both static or dynamic -->
  <PropertyGroup Condition="'$(UsingDelphiRTL)'=='true' And '$(ConWin64DelphiRTL)'=='true'">
    <DelphiRTLLibs Condition="'$(LinkPackageStatics)'=='' And '$(DynamicRTL)'=='true'">$(RTLE)</DelphiRTLLibs>
    <DelphiRTLBpis Condition="'$(LinkPackageImports)'=='' And '$(DynamicRTL)'=='true'">rtl.bpi</DelphiRTLBpis>
    <DelphiRTLLibs Condition="'$(LinkPackageStatics)'=='' And '$(DynamicRTL)'!='true'">rtl.a;$(RTLE)</DelphiRTLLibs>
    <DelphiRTLLibs Condition="'$(LinkPackageStatics)'=='' And '$(DynamicRTL)'!='true' And '$(Platform)'=='$(cWin64xPlatform)'">rtl.lib;$(RTLE)</DelphiRTLLibs>
    <DelphiRTLBpis Condition="'$(LinkPackageImports)'=='' And '$(DynamicRTL)'!='true'"></DelphiRTLBpis>

    <DelphiRTLLibs Condition="'$(DelphiRTLLibs)'==''">$(RTLE)</DelphiRTLLibs>
  </PropertyGroup>

  <Choose>
    <When Condition="'$(DynamicRTL)'=='true' And '$(UsingDelphiRTL)'=='true'">
      <PropertyGroup>
        <RTLLib Condition="'$(Platform)'=='$(cWin32Platform)' Or '$(Platform)'=='$(cOSX32Platform)'">cp32mti.lib</RTLLib>
        <RTLLib Condition="'$(Platform)'=='$(cWin64Platform)'">cp64mti.a</RTLLib>
        <ILINK_AdditionalLibs Condition="'$(ILINK_AdditionalLibs)'=='' And '$(Platform)'=='$(cWin32Platform)'">$(CommonLibraries);$(RTLLib)</ILINK_AdditionalLibs>
        <ILINK_AdditionalLibs Condition="'$(ILINK_AdditionalLibs)'=='' And ('$(Platform)'=='$(cWin64Platform)' Or '$(Platform)'=='$(cWin64xPlatform)')">$(CommonLibraries);$(RTLLib)</ILINK_AdditionalLibs>
        <ILINK_AdditionalLibs Condition="'$(ILINK_AdditionalLibs)'=='' And '$(Platform)'=='$(cOSX32Platform)'">libcgcrtl.dylib;libcgcrtl_nonshared.a;libcgstl.dylib;$(CommonLibraries)</ILINK_AdditionalLibs>
        <BCC_InternalDefines Condition="'$(BCC_InternalDefines)'!=''">$(BCC_InternalDefines)</BCC_InternalDefines>
        <BCC_InternalDefines Condition="'$(_DoingStaticPackageBuild)'!='true'">$(BCC_InternalDefines)</BCC_InternalDefines>
        <BCC_GenerateMultithreaded Condition="'$(Platform)'=='$(cWin32Platform)' Or '$(Platform)'=='$(cWin64Platform)' Or '$(Platform)'=='$(cWin64xPlatform)'">true</BCC_GenerateMultithreaded>
        <ILINK_AdditionalObjs Condition="'$(ILINK_AdditionalObjs)'=='' And '$(Platform)'=='$(cWin32Platform)'">memmgr.lib;sysinit.obj</ILINK_AdditionalObjs>
        <ILINK_AdditionalObjs Condition="'$(ILINK_AdditionalObjs)'=='' And '$(Platform)'=='$(cOSX32Platform)'">delphi.o</ILINK_AdditionalObjs>
        <ILINK_AdditionalObjs Condition="'$(ILINK_AdditionalObjs)'=='' And '$(Platform)'=='$(cLinux64Platform)'">$(SystemLibraryPath)\delphi.o;$(SystemLibraryPath)\SysInit.o</ILINK_AdditionalObjs>
        <ILINK_AdditionalObjs Condition="'$(ILINK_AdditionalObjs)'=='' And '$(Platform)'=='$(cWin64Platform)'">memmgr.a;sysinit.o</ILINK_AdditionalObjs>
        <ILINK_AdditionalObjs Condition="'$(ILINK_AdditionalObjs)'=='' And '$(Platform)'=='$(cWin64xPlatform)'">sysinit.o</ILINK_AdditionalObjs>
      </PropertyGroup>
    </When>
    <When Condition="'$(DynamicRTL)'!='true' And '$(UsingDelphiRTL)'=='true'">
      <PropertyGroup>
        <RTLLib Condition="'$(Platform)'=='$(cWin32Platform)' Or '$(Platform)'=='$(cOSX32Platform)'">cp32mt.lib</RTLLib>
        <RTLLib Condition="'$(Platform)'=='$(cWin64Platform)'">cp64mt.a</RTLLib>
        <ILINK_AdditionalLibs Condition="'$(ILINK_AdditionalLibs)'=='' And '$(Platform)'=='$(cWin32Platform)'">$(CommonLibraries);$(RTLLib)</ILINK_AdditionalLibs>
        <ILINK_AdditionalLibs Condition="'$(ILINK_AdditionalLibs)'=='' And '$(Platform)'=='$(cOSX32Platform)'">libcgcrtl.a;libcgstl.a;$(CommonLibraries)</ILINK_AdditionalLibs>
        <ILINK_AdditionalLibs Condition="'$(ILINK_AdditionalLibs)'=='' And ('$(Platform)'=='$(cWin64Platform)' Or '$(Platform)'=='$(cWin64xPlatform)')">$(CommonLibraries);$(RTLLib)</ILINK_AdditionalLibs>
        <ILINK_AdditionalLibs Condition="'$(ILINK_AdditionalLibs)'=='' And '$(Platform)'=='$(ciOSDevice32Platform)'">rtlhelper;c++;$(STDCLib);System;rtle;cgcrtl;$(CommonLibraries)</ILINK_AdditionalLibs>
        <ILINK_AdditionalLibs Condition="'$(ILINK_AdditionalLibs)'=='' And '$(Platform)'=='$(ciOSDevice64Platform)'">rtlhelper;c++;$(STDCLib);System;rtle;cgcrtl;$(CommonLibraries)</ILINK_AdditionalLibs>
        <ILINK_AdditionalLibs Condition="'$(ILINK_AdditionalLibs)'=='' And '$(Platform)'=='$(ciOSSimulatorArm64Platform)'">compiler_rt;c++;System;rtlhelper;rtle;cgcrtl;$(CommonLibraries)</ILINK_AdditionalLibs>
        <ILINK_AdditionalLibs Condition="'$(ILINK_AdditionalLibs)'=='' And '$(Platform)'=='$(cAndroidArm32Platform)'">cgcrtl;pcre;dl;c;m;rtlhelper;android;EGL;GLESv2;log;jnigraphics;GLESv1_CM;OpenSLES;$(STDCLib);LocalizedRTL;compiler_rt;$(CommonLibraries)</ILINK_AdditionalLibs>
        <ILINK_AdditionalLibs Condition="'$(ILINK_AdditionalLibs)'=='' And '$(Platform)'=='$(cAndroidArm64Platform)'">cgcrtl;pcre;dl;c;m;rtlhelper;android;EGL;GLESv2;log;jnigraphics;GLESv1_CM;OpenSLES;$(STDCLib);LocalizedRTL;compiler_rt;$(CommonLibraries)</ILINK_AdditionalLibs>
        <BCC_GenerateMultithreaded Condition="'$(Platform)'=='$(cWin32Platform)' Or '$(Platform)'=='$(cWin64Platform)' Or '$(Platform)'=='$(cWin64xPlatform)'">true</BCC_GenerateMultithreaded>
        <ILINK_AdditionalObjs Condition="'$(ILINK_AdditionalObjs)'=='' And '$(Platform)'=='$(cWin32Platform)'">memmgr.lib;sysinit.obj</ILINK_AdditionalObjs>
        <ILINK_AdditionalObjs Condition="'$(ILINK_AdditionalObjs)'=='' And '$(Platform)'=='$(cOSX32Platform)'">delphi.o</ILINK_AdditionalObjs>
        <ILINK_AdditionalObjs Condition="'$(ILINK_AdditionalObjs)'=='' And '$(Platform)'=='$(cLinux64Platform)'">$(SystemLibraryPath)\delphi.o;$(SystemLibraryPath)\SysInit.o</ILINK_AdditionalObjs>
        <ILINK_AdditionalObjs Condition="'$(ILINK_AdditionalObjs)'=='' And '$(Platform)'=='$(cWin64Platform)'">memmgr.a;sysinit.o</ILINK_AdditionalObjs>
        <ILINK_AdditionalObjs Condition="'$(ILINK_AdditionalObjs)'=='' And '$(Platform)'=='$(cWin64xPlatform)'">sysinit.o</ILINK_AdditionalObjs>
      </PropertyGroup>
    </When>
    <When Condition="'$(DynamicRTL)'=='true' And '$(Multithreaded)'=='true' And '$(UsingDelphiRTL)'!='true'">
      <PropertyGroup>
        <ILINK_AdditionalLibs Condition="'$(ILINK_AdditionalLibs)'=='' And '$(Platform)'=='$(cWin32Platform)'">$(CommonLibraries);cw32mti.lib</ILINK_AdditionalLibs>
        <ILINK_AdditionalLibs Condition="'$(ILINK_AdditionalLibs)'=='' And '$(Platform)'=='$(cWin64Platform)'">$(CommonLibraries);cw64mti.a</ILINK_AdditionalLibs>
        <ILINK_AdditionalLibs Condition="'$(ILINK_AdditionalLibs)'=='' And '$(Platform)'=='$(cWin64xPlatform)'">$(CommonLibraries)</ILINK_AdditionalLibs>
        <ILINK_AdditionalLibs Condition="'$(ILINK_AdditionalObjs)'=='' And '$(Platform)'=='$(cOSX32Platform)'">libcgcrtl.dylib;libcgcrtl_nonshared.a;libcgstl.dylib;$(CommonLibraries)</ILINK_AdditionalLibs>
        <ILINK_AdditionalLibs Condition="'$(ILINK_AdditionalObjs)'=='' And '$(Platform)'=='$(cOSX64Platform)'">rtlhelper;c++;$(STDCLib);System;$(CommonLibraries)</ILINK_AdditionalLibs>
        <ILINK_AdditionalLibs Condition="'$(ILINK_AdditionalObjs)'=='' And '$(Platform)'=='$(cOSXArm64Platform)'">rtlhelper;c++;$(STDCLib);System;$(CommonLibraries)</ILINK_AdditionalLibs>
        <BCC_InternalDefines Condition="'$(BCC_InternalDefines)'!=''">$(BCC_InternalDefines);</BCC_InternalDefines>
        <BCC_InternalDefines Condition="'$(_DoingStaticPackageBuild)'!='true'">$(BCC_InternalDefines)</BCC_InternalDefines>
        <BCC_GenerateMultithreaded Condition="'$(Platform)'=='$(cWin32Platform)' Or '$(Platform)'=='$(cWin64Platform)' Or '$(Platform)'=='$(cWin64xPlatform)'">true</BCC_GenerateMultithreaded>
      </PropertyGroup>
    </When>
    <When Condition="'$(DynamicRTL)'!='true' And '$(Multithreaded)'=='true' AND '$(UsingDelphiRTL)'!='true'">
      <PropertyGroup>
        <ILINK_AdditionalLibs Condition="'$(ILINK_AdditionalLibs)'=='' And '$(Platform)'=='$(cWin32Platform)'">$(CommonLibraries);cw32mt.lib</ILINK_AdditionalLibs>
        <ILINK_AdditionalLibs Condition="'$(ILINK_AdditionalLibs)'=='' And '$(Platform)'=='$(cWin64Platform)'">$(CommonLibraries);cw64mt.a</ILINK_AdditionalLibs>
        <ILINK_AdditionalLibs Condition="'$(ILINK_AdditionalLibs)'=='' And '$(Platform)'=='$(cWin64xPlatform)'">$(CommonLibraries)</ILINK_AdditionalLibs>
        <ILINK_AdditionalLibs Condition="'$(ILINK_AdditionalLibs)'=='' And '$(Platform)'=='$(cOSX32Platform)'">libcgcrtl.a;libcgstl.a;$(CommonLibraries)</ILINK_AdditionalLibs>
        <ILINK_AdditionalLibs Condition="'$(ILINK_AdditionalLibs)'=='' And '$(Platform)'=='$(ciOSDevice32Platform)'">rtlhelper;c++;$(STDCLib);System;rtle;cgcrtl;$(CommonLibraries)</ILINK_AdditionalLibs>
        <ILINK_AdditionalLibs Condition="'$(ILINK_AdditionalLibs)'=='' And '$(Platform)'=='$(ciOSDevice64Platform)'">rtlhelper;c++;$(STDCLib);System;rtle;cgcrtl;$(CommonLibraries)</ILINK_AdditionalLibs>
        <ILINK_AdditionalLibs Condition="'$(ILINK_AdditionalLibs)'=='' And '$(Platform)'=='$(ciOSSimulatorArm64Platform)'">compiler_rt;c++;System;rtlhelper;rtle;cgcrtl;$(CommonLibraries)</ILINK_AdditionalLibs>
        <ILINK_AdditionalLibs Condition="'$(ILINK_AdditionalLibs)'=='' And '$(Platform)'=='$(cOSX64Platform)'">rtlhelper;c++;$(STDCLib);System;$(CommonLibraries)</ILINK_AdditionalLibs>
        <ILINK_AdditionalLibs Condition="'$(ILINK_AdditionalLibs)'=='' And '$(Platform)'=='$(cOSXArm64Platform)'">rtlhelper;c++;$(STDCLib);System;$(CommonLibraries)</ILINK_AdditionalLibs>
        <ILINK_AdditionalLibs Condition="'$(ILINK_AdditionalLibs)'=='' And '$(Platform)'=='$(cAndroidArm32Platform)'">cgcrtl;pcre;dl;c;m;rtlhelper;android;EGL;GLESv2;log;jnigraphics;GLESv1_CM;OpenSLES;$(STDCLib);LocalizedRTL;compiler_rt;$(CommonLibraries)</ILINK_AdditionalLibs>
        <ILINK_AdditionalLibs Condition="'$(ILINK_AdditionalLibs)'=='' And '$(Platform)'=='$(cAndroidArm64Platform)'">cgcrtl;pcre;dl;c;m;rtlhelper;android;EGL;GLESv2;log;jnigraphics;GLESv1_CM;OpenSLES;$(STDCLib);LocalizedRTL;compiler_rt;$(CommonLibraries)</ILINK_AdditionalLibs>
        <BCC_GenerateMultithreaded Condition="'$(Platform)'=='$(cWin32Platform)' Or '$(Platform)'=='$(cWin64Platform)' Or '$(Platform)'=='$(cWin64xPlatform)'">true</BCC_GenerateMultithreaded>
      </PropertyGroup>
    </When>
    <When Condition="'$(DynamicRTL)'=='true' AND '$(Multithreaded)'!='true' AND '$(UsingDelphiRTL)'!='true'">
      <PropertyGroup>
        <ILINK_AdditionalLibs Condition="'$(ILINK_AdditionalLibs)'=='' And '$(Platform)'=='$(cWin32Platform)'">$(CommonLibraries);cw32i.lib</ILINK_AdditionalLibs>
        <ILINK_AdditionalLibs Condition="'$(ILINK_AdditionalLibs)'=='' And '$(Platform)'=='$(cWin64Platform)'">$(CommonLibraries);cw64i.a</ILINK_AdditionalLibs>
        <ILINK_AdditionalLibs Condition="'$(ILINK_AdditionalLibs)'=='' And '$(Platform)'=='$(cWin64xPlatform)'">$(CommonLibraries)</ILINK_AdditionalLibs>
        <ILINK_AdditionalLibs Condition="'$(ILINK_AdditionalObjs)'=='' And '$(Platform)'=='$(cOSX32Platform)'">libcgcrtl.dylib;libcgcrtl_nonshared.a;libcgstl.dylib;$(CommonLibraries)</ILINK_AdditionalLibs>
        <BCC_InternalDefines Condition="'$(BCC_InternalDefines)'!=''">$(BCC_InternalDefines);</BCC_InternalDefines>
        <BCC_InternalDefines Condition="'$(_DoingStaticPackageBuild)'!='true'">$(BCC_InternalDefines)</BCC_InternalDefines>
      </PropertyGroup>
    </When>
    <When Condition="'$(DynamicRTL)'!='true' AND '$(Multithreaded)'!='true' AND '$(UsingDelphiRTL)'!='true'">
      <PropertyGroup>
        <ILINK_AdditionalLibs Condition="'$(ILINK_AdditionalLibs)'=='' And '$(Platform)'=='$(cWin32Platform)'">$(CommonLibraries);cw32.lib</ILINK_AdditionalLibs>
        <ILINK_AdditionalLibs Condition="'$(ILINK_AdditionalLibs)'=='' And '$(Platform)'=='$(cWin64Platform)'">$(CommonLibraries);cw64.a</ILINK_AdditionalLibs>
        <ILINK_AdditionalLibs Condition="'$(ILINK_AdditionalLibs)'=='' And '$(Platform)'=='$(cWin64xPlatform)'">$(CommonLibraries)</ILINK_AdditionalLibs>
        <ILINK_AdditionalLibs Condition="'$(ILINK_AdditionalLibs)'=='' And '$(Platform)'=='$(cOSX32Platform)'">libcgcrtl.a;libcgstl.a;$(CommonLibraries)</ILINK_AdditionalLibs>
        <ILINK_AdditionalLibs Condition="'$(ILINK_AdditionalLibs)'=='' And '$(Platform)'=='$(ciOSDevice32Platform)'">rtlhelper;c++;$(STDCLib);System;rtle;cgcrtl;$(CommonLibraries)</ILINK_AdditionalLibs>
        <ILINK_AdditionalLibs Condition="'$(ILINK_AdditionalLibs)'=='' And '$(Platform)'=='$(ciOSDevice64Platform)'">rtlhelper;c++;$(STDCLib);System;rtle;cgcrtl;$(CommonLibraries)</ILINK_AdditionalLibs>
        <ILINK_AdditionalLibs Condition="'$(ILINK_AdditionalLibs)'=='' And '$(Platform)'=='$(ciOSSimulatorArm64Platform)'">compiler_rt;c++;System;rtlhelper;rtle;cgcrtl;$(CommonLibraries)</ILINK_AdditionalLibs>
        <ILINK_AdditionalLibs Condition="'$(ILINK_AdditionalLibs)'=='' And '$(Platform)'=='$(cAndroidArm32Platform)'">cgcrtl;pcre;dl;c;m;rtlhelper;android;EGL;GLESv2;log;jnigraphics;GLESv1_CM;OpenSLES;$(STDCLib);LocalizedRTL;compiler_rt;$(CommonLibraries)</ILINK_AdditionalLibs>
        <ILINK_AdditionalLibs Condition="'$(ILINK_AdditionalLibs)'=='' And '$(Platform)'=='$(cAndroidArm64Platform)'">cgcrtl;pcre;dl;c;m;rtlhelper;android;EGL;GLESv2;log;jnigraphics;GLESv1_CM;OpenSLES;$(STDCLib);LocalizedRTL;compiler_rt;$(CommonLibraries)</ILINK_AdditionalLibs>
        <ILINK_AdditionalLibs Condition="'$(ILINK_AdditionalLibs)'=='' And '$(Platform)'=='$(cOSX64Platform)'">rtlhelper;c++;$(STDCLib);System;$(CommonLibraries)</ILINK_AdditionalLibs>
        <ILINK_AdditionalLibs Condition="'$(ILINK_AdditionalLibs)'=='' And '$(Platform)'=='$(cOSXArm64Platform)'">rtlhelper;c++;$(STDCLib);System;$(CommonLibraries)</ILINK_AdditionalLibs>
      </PropertyGroup>
    </When>
  </Choose>

<!-- Global Properties -->

  <!-- Environment options -->
  <PropertyGroup Condition="'$(Platform)'=='$(cWin32Platform)'">
    <CBuilderIncludePath Condition="'$(CBuilderWin32IncludePath)'!=''">$(CBuilderWin32IncludePath);$(CBuilderIncludePath)</CBuilderIncludePath>
    <CBuilderLibraryPath Condition="'$(CBuilderWin32LibraryPath)'!=''">$(CBuilderWin32LibraryPath);$(CBuilderLibraryPath)</CBuilderLibraryPath>
    <CBuilderBrowsingPath Condition="'$(CBuilderWin32BrowsingPath)'!=''">$(CBuilderWin32BrowsingPath);$(CBuilderBrowsingPath)</CBuilderBrowsingPath>
    <CBuilderBPIOutputPath Condition="'$(CBuilderWin32BPIOutputPath)'!=''">$(CBuilderWin32BPIOutputPath)</CBuilderBPIOutputPath>
    <CBuilderBPLOutputPath Condition="'$(CBuilderWin32BPLOutputPath)'!=''">$(CBuilderWin32BPLOutputPath)</CBuilderBPLOutputPath>
  </PropertyGroup>

    <!-- CLANG_WIN32 -->
  <PropertyGroup Condition="'$(Platform)'=='$(cWin32Platform)' And '$(USING_CLANG_WIN32)'=='true'">
    <CBuilderIncludePath>$(CBuilderIncludePath_Clang32)</CBuilderIncludePath>
    <CBuilderLibraryPath>$(CBuilderLibraryPath_Clang32)</CBuilderLibraryPath>
    <CBuilderBrowsingPath>$(CBuilderBrowsingPath_Clang32)</CBuilderBrowsingPath>
    <CBuilderBPIOutputPath>$(CBuilderBPIOutputPath_Clang32)</CBuilderBPIOutputPath>
    <CBuilderBPLOutputPath>$(CBuilderBPLOutputPath_Clang32)</CBuilderBPLOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)'=='$(cOSX32Platform)'">
    <DCC_SysLibRoot Condition="'$(DCC_SysLibRoot)'!=''">$(DCC_SysLibRoot);$(Profile_sysroot)</DCC_SysLibRoot>
    <DCC_SysLibRoot Condition="'$(DCC_SysLibRoot)'==''">$(Profile_sysroot)</DCC_SysLibRoot>

    <CBuilderIncludePath Condition="'$(CBuilderOSX32IncludePath)'!=''">$(CBuilderOSX32IncludePath);$(CBuilderIncludePath)</CBuilderIncludePath>
    <CBuilderLibraryPath Condition="'$(CBuilderOSX32LibraryPath)'!=''">$(CBuilderOSX32LibraryPath);$(CBuilderLibraryPath)</CBuilderLibraryPath>
    <!-- xlink requires package .dylibs for linking in addition to "import" libraries -->
    <CBuilderLibraryPath Condition="'$(CBuilderOSX32BPLOutputPath)'!=''">$(CBuilderLibraryPath);$(CBuilderOSX32BPLOutputPath)</CBuilderLibraryPath>
    <CBuilderLibraryPath Condition="'$(DelphiDllOutputPath)'!='' And '$(DelphiDllOutputPath)'!='$(CBuilderOSX32BPLOutputPath)'">$(CBuilderLibraryPath);$(DelphiDllOutputPath)</CBuilderLibraryPath>
    <CBuilderBrowsingPath Condition="'$(CBuilderOSX32BrowsingPath)'!=''">$(CBuilderOSX32BrowsingPath);$(CBuilderBrowsingPath)</CBuilderBrowsingPath>
    <CBuilderBPIOutputPath Condition="'$(CBuilderOSX32BPIOutputPath)'!=''">$(CBuilderOSX32BPIOutputPath)</CBuilderBPIOutputPath>
    <CBuilderBPLOutputPath Condition="'$(CBuilderOSX32BPLOutputPath)'!=''">$(CBuilderOSX32BPLOutputPath)</CBuilderBPLOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <LANGDIR Condition="'$(LANGDIR)' == 'EN'"></LANGDIR>
  </PropertyGroup>

  <ItemGroup Condition="'$(Platform)'=='$(cWin32Platform)' And '$(LANGDIR)'!=''">
    <TranslatedIncludePath Include="$(BDSINCLUDE)\windows\crtl\$(LANGDIR)"
      Condition="Exists('$(BDSINCLUDE)\windows\crtl\$(LANGDIR)')"/>
    <TranslatedIncludePath Include="$(BDSINCLUDE)\windows\rtl\$(LANGDIR)"
      Condition="Exists('$(BDSINCLUDE)\windows\rtl\$(LANGDIR)')"/>
  </ItemGroup>


  <!--Common and Shared options-->
  <PropertyGroup>
    <BCC_NoLink>true</BCC_NoLink>
    <BCC_UTF8Output>true</BCC_UTF8Output>
    <ILINK_OSVersion Condition="'$(ILINK_OSVersion)'=='' And '$(UsingDelphiRTL)'=='true'">6.0</ILINK_OSVersion>
    <ILINK_SubSysVersion Condition="'$(ILINK_SubSysVersion)'=='' And '$(UsingDelphiRTL)'=='true'">6.0</ILINK_SubSysVersion>
    <DCC_GenerateCppFiles>true</DCC_GenerateCppFiles>
    <ShowStdOut Condition="'$(ShowStdOut)'==''">$(ShowGeneralMessages)</ShowStdOut>
    <!-- _TCHAR mapping for Unicode character selection -->
    <!-- Default TCHAR to "char" for backwards compatibility -->
    <_TCHARMapping Condition="'$(_TCHARMapping)'==''">char</_TCHARMapping>
    <StartupObj Condition="'$(StartupObj)'!='' And '$(_TCHARMapping)'!='char' And ('$(Platform)'=='$(cWin32Platform)' Or '$(Platform)'=='$(cWin64Platform)')">$(StartupObj)w</StartupObj>
    <ILINK_StartupObjs Condition="'$(ILINK_StartupObjs)'==''">$(StartupObj)</ILINK_StartupObjs>
    <BCC_GenerateUnicode Condition="'$(_TCHARMapping)'!='char'">true</BCC_GenerateUnicode>

    <!-- Include Paths -->
    <DelphiLibraryPath Condition="'$(DelphiLibraryPath)'==''">$(BDSLIB)</DelphiLibraryPath>
    <BRCC_IncludePath Condition="'$(BRCC_IncludePath)'!=''">$(BRCC_IncludePath);$(IncludePath)</BRCC_IncludePath>
    <BRCC_IncludePath Condition="'$(BRCC_IncludePath)'==''">$(IncludePath)</BRCC_IncludePath>
    <DCC_UnitSearchPath>$(DCC_UnitSearchPath);$(DelphiLibraryPath)</DCC_UnitSearchPath>
    <DCC_IncludePath>$(DCC_UnitSearchPath)</DCC_IncludePath>
    <DCC_ResourcePath>$(DCC_UnitSearchPath)</DCC_ResourcePath>
    <DCC_ObjPath>$(DCC_UnitSearchPath)</DCC_ObjPath>
    <TASM_IncludePath Condition="'$(TASM_IncludePath)'!=''">$(TASM_IncludePath);$(IncludePath)</TASM_IncludePath>
    <TASM_IncludePath Condition="'$(TASM_IncludePath)'==''">$(IncludePath)</TASM_IncludePath>

    <!-- Defines -->
    <BCC_Defines Condition="'$(BCC_Defines)'!=''">$(BCC_Defines);$(Defines)</BCC_Defines>
    <BCC_Defines Condition="'$(BCC_Defines)'==''">$(Defines)</BCC_Defines>
    <BCC_Defines Condition="'$(FrameworkType)' != 'None'">$(BCC_Defines);FRAMEWORK_$(FrameworkType)</BCC_Defines>
    <BCC_InternalDefines Condition="'$(BCC_InternalDefines)'!='' And '$(UsePackages)'=='true' And '$(_DoingStaticPackageBuild)'!='true'">$(BCC_InternalDefines);USEPACKAGES</BCC_InternalDefines>
    <BCC_InternalDefines Condition="'$(BCC_InternalDefines)'=='' And '$(UsePackages)'=='true' And '$(_DoingStaticPackageBuild)'!='true'">USEPACKAGES</BCC_InternalDefines>
    <BRCC_Defines Condition="'$(BRCC_Defines)'!=''">$(BRCC_Defines);$(Defines)</BRCC_Defines>
    <BRCC_Defines Condition="'$(BRCC_Defines)'==''">$(Defines)</BRCC_Defines>
    <DCC_Define Condition="'$(DCC_Define)'!=''">$(DCC_Define);$(Defines)</DCC_Define>
    <DCC_Define Condition="'$(DCC_Define)'==''">$(Defines)</DCC_Define>
    <TASM_Defines Condition="'$(TASM_Defines)'!=''">$(TASM_Defines);$(Defines)</TASM_Defines>
    <TASM_Defines Condition="'$(TASM_Defines)'==''">$(Defines)</TASM_Defines>
    <BCC_Undefines Condition="'$(_DoingStaticPackageBuild)'=='true'">USEPACKAGES</BCC_Undefines>

    <!-- Output Directories and Filenames -->
    <OutputName Condition="'$(OutputName)'==''">$(MSBuildProjectName)</OutputName>
    <OutputExt Condition="'$(OutputExt)'!=''">.$(OutputExt)</OutputExt>
    <ILINK_PackageBaseName Condition="'$(AppType)'=='Package'">$(OutputName)</ILINK_PackageBaseName>
    <IntermediateOutputDir Condition="'$(IntermediateOutputDir)'!='' And !HasTrailingSlash('$(IntermediateOutputDir)')">$(IntermediateOutputDir)\</IntermediateOutputDir>
    <FinalOutputDir Condition="'$(FinalOutputDir)'=='' And '$(AppType)'=='Package'">$(CBuilderBPLOutputPath)</FinalOutputDir>
    <FinalOutputDir Condition="'$(FinalOutputDir)'==''">$(IntermediateOutputDir)</FinalOutputDir>
    <FinalOutputDir Condition="'$(FinalOutputDir)'!='' And !HasTrailingSlash('$(FinalOutputDir)')">$(FinalOutputDir)\</FinalOutputDir>
    <DllVersion Condition="'$(DllVersion)'!=''">.$(DllVersion)</DllVersion>
    <DllPrefix Condition="'$(DllPrefix)'=='' And ('$(Platform)'=='$(cAndroidArm32Platform)' Or '$(Platform)'=='$(cAndroidArm64Platform)') And ('$(AppType)'=='Application' Or '$(AppType)'=='Console')">$(DllPlatformPrefix)</DllPrefix>
    <DllPrefix Condition="'$(DllPrefix)'=='' And '$(AppType)'=='Library'">$(DllPlatformPrefix)</DllPrefix>
    <DllPrefix Condition="'$(DllPrefix)'=='' And '$(AppType)'=='Package'">$(BplPlatformPrefix)</DllPrefix>
    <FinalOutput Condition="'$(FinalOutput)'==''">$(FinalOutputDir)$(DllPrefix)$(OutputName)$(DllSuffix)$(OutputExt)$(DllVersion)</FinalOutput>

    <ILINK_BpiLibOutputDir>$(BPILibOutputDir)</ILINK_BpiLibOutputDir>
    <ILINK_BpiLibOutputDir Condition="'$(ILINK_BpiLibOutputDir)'=='' And '$(AppType)'=='Package'">$(CBuilderBPIOutputPath)</ILINK_BpiLibOutputDir>
    <ILINK_BpiLibOutputDir Condition="'$(ILINK_BpiLibOutputDir)'==''">$(FinalOutputDir)</ILINK_BpiLibOutputDir>
    <ILINK_BpiLibOutputDir Condition="'$(ILINK_BpiLibOutputDir)'!='' And !HasTrailingSlash('$(ILINK_BpiLibOutputDir)')">$(ILINK_BpiLibOutputDir)\</ILINK_BpiLibOutputDir>

    <BCC_OutputDir Condition="'$(BCC_OutputDir)'==''">$(IntermediateOutputDir)</BCC_OutputDir>
    <BCC_OutputDir Condition="'$(BCC_OutputDir)'!='' And !HasTrailingSlash('$(BCC_OutputDir)')">$(BCC_OutputDir)\</BCC_OutputDir>
    <BRCC_OutputDir Condition="'$(BRCC_OutputDir)'==''">$(IntermediateOutputDir)</BRCC_OutputDir>
    <BRCC_OutputDir Condition="'$(BRCC_OutputDir)'!='' And !HasTrailingSlash('$(BRCC_OutputDir)')">$(BRCC_OutputDir)\</BRCC_OutputDir>
    <TASM_OutputDir Condition="'$(TASM_OutputDir)'==''">$(IntermediateOutputDir)</TASM_OutputDir>
    <TASM_OutputDir Condition="'$(TASM_OutputDir)'!='' And !HasTrailingSlash('$(TASM_OutputDir)')">$(TASM_OutputDir)\</TASM_OutputDir>
    <DCC_ObjOutput Condition="'$(DCC_ObjOutput)'==''">$(IntermediateOutputDir)</DCC_ObjOutput>
    <DCC_ObjOutput Condition="'$(DCC_ObjOutput)'!='' And !HasTrailingSlash('$(DCC_ObjOutput)')">$(DCC_ObjOutput)\</DCC_ObjOutput>
    <DCC_DcuOutput>$(DCC_ObjOutput)</DCC_DcuOutput>
    <DCC_BpiOutput Condition="'$(DCC_BpiOutput)'==''">$(ILINK_BpiLibOutputDir)</DCC_BpiOutput>
    <DCC_BplOutput>$(FinalOutputDir)</DCC_BplOutput>

    <GENTLB_OutputDir Condition="'$(GENTLB_OutputDir)'!='' And !HasTrailingSlash('$(GENTLB_OutputDir)')">$(GENTLB_OutputDir)\</GENTLB_OutputDir>
    <GENTLB_OutputName Condition="'$(GENTLB_OutputName)'==''">$(MSBuildProjectName).tlb</GENTLB_OutputName>
    <GENTLB_GenCppBindings>false</GENTLB_GenCppBindings>

    <!-- Library search paths -->
    <ILINK_LibraryPath Condition="'$(CBuilderLibraryPath)'!=''">$(ILINK_LibraryPath);$(CBuilderLibraryPath)</ILINK_LibraryPath>
    <ILINK_LibraryPath Condition="'$(CBuilderBPIOutputPath)'!=''">$(ILINK_LibraryPath);$(CBuilderBPIOutputPath)</ILINK_LibraryPath>

    <ILINK_TranslatedLibraryPath Condition="'$(ILINK_TranslatedLibraryPath)'=='' And '$(LANGDIR)' != ''">$(BDSLIB)\$(PLATFORM)\release\$(LANGDIR)</ILINK_TranslatedLibraryPath>
    <ILINK_LibraryPath Condition="'$(ILINK_TranslatedLibraryPath)'!='' And '$(LANGDIR)' != ''">$(ILINK_TranslatedLibraryPath);$(ILINK_LibraryPath)</ILINK_LibraryPath>

    <ILINK_LibraryPath Condition="'$(DelphiDCPOutput)'!='' And '$(DelphiDCPOutput)'!='$(CBuilderBPIOutputPath)' And ('$(Platform)'!='$(ciOSDevice32Platform)' And '$(Platform)'!='$(ciOSDevice64Platform)')">$(ILINK_LibraryPath);$(DelphiDCPOutput)</ILINK_LibraryPath>
    <!--<ILINK_LibraryPath Condition="'$(Win32DCPOutput)'!='' And '$(Win32DCPOutput)'!='$(CBuilderBPIOutputPath)'">$(ILINK_LibraryPath);$(Win32DCPOutput)</ILINK_LibraryPath>-->
    <ILINK_LibraryPath Condition="'$(BCC_OutputDir'!=''">$(BCC_OutputDir);$(ILINK_LibraryPath)</ILINK_LibraryPath>
    <ILINK_LibraryPath Condition="'$(DCC_ObjOutput)'!='$(BCC_OutputDir)'">$(ILINK_LibraryPath);$(DCC_ObjOutput)</ILINK_LibraryPath>

    <ILINK_ObjectSearchPath>$(ILINK_LibraryPath)</ILINK_ObjectSearchPath>
    <ILINK_IntermediateOutputPath Condition="'$(ILINK_IntermediateOutputPath'==''">$(IntermediateOutputDir)</ILINK_IntermediateOutputPath>

    <!-- Default Values -->
    <BCC_PCHName Condition="'$(BCC_PCHName)'=='' And '$(BCC_PCHUsage)'!='None'">$(IntermediateOutputDir)$(OutputName).pch</BCC_PCHName>
    <ILINK_PackageImports>@(PackageImport)</ILINK_PackageImports>
    <ILINK_PackageLibs Condition="'$(UsePackages)'!='true' And '$(AppType)'!='Package'">$(AllPackageLibs)</ILINK_PackageLibs>
    <ILINK_MapFileName Condition="'$(ILINK_MapFileName)'=='' And '$(ILINK_MapFileType)'!='None'">$(FinalOutputDir)$(OutputName).map</ILINK_MapFileName>

    <ProjectName>$(MSBuildProjectName)</ProjectName>
    <ProjectFilename>$(MSBuildProjectFile)</ProjectFilename>
    <ProjectExt>$(MSBuildProjectExtension)</ProjectExt>
    <ProjectDir>$(MSBuildProjectDirectory)</ProjectDir>
    <ProjectPath>$(MSBuildProjectFullPath)</ProjectPath>

    <InputPath>@(InputFile->'%(FullPath)')</InputPath>
    <InputDir>@(InputFile->'%(RootDir)%(Directory)')</InputDir>
    <InputName>@(InputFile->'%(Filename)')</InputName>
    <InputExt>@(InputFile->'%(Extension)')</InputExt>
    <InputFilename>@(InputFile->'%(Filename)%(Extension)')</InputFilename>

    <OutputPath>@(OutputFile->'%(FullPath)')</OutputPath>
    <OutputDir>@(OutputFile->'%(RootDir)%(Directory)')</OutputDir>
    <OutputName>@(OutputFile->'%(Filename)')</OutputName>
    <OutputExt>@(OutputFile->'%(Extension)')</OutputExt>
    <OutputFilename>@(OutputFile->'%(Filename)%(Extension)')</OutputFilename>

    <!-- Codeguard (Currently not supported for Clang32 compiler -->
    <CodeGuard_Lib Condition="'$(BCC_AllCodeguardOptions)'=='true' And '$(Platform)'=='$(cWin32Platform)' And '$(USING_CLANG_WIN32)'!='true'">cg32.$(LibExt)</CodeGuard_Lib>

    <!-- Miscellaneous and Build Event Properties -->
    <BCC_ReplaceHeaderName Condition="$(BCC_ReplaceHeaderName)!='' And '$(OptPCH)'!=''">$(BCC_ReplaceHeaderName);</BCC_ReplaceHeaderName>
    <BCC_ReplaceHeaderName>$(BCC_ReplaceHeaderName)$(OptPCH)</BCC_ReplaceHeaderName>

    <BCC_LinkWithDynamicRTL>$(DynamicRTL)</BCC_LinkWithDynamicRTL>
  </PropertyGroup>


  <!-- Win32/OSX based options -->
  <PropertyGroup Condition="'$(USING_CLANG)'!='true'">
    <!-- Include Paths -->
    <IncludePath Condition="'$(CBuilderIncludePath)'!=''">$(IncludePath);$(CBuilderIncludePath)</IncludePath>
    <IncludePath Condition="'$(DelphiHPPOutputPath)'!=''">$(IncludePath);$(DelphiHPPOutputPath)</IncludePath>
    <IncludePath Condition="'$(LANGDIR)'!=''">@(TranslatedIncludePath);$(IncludePath)</IncludePath>
    <BCC_IncludePath Condition="'$(BCC_IncludePath)'!=''">$(BCC_IncludePath);$(IncludePath)</BCC_IncludePath>
    <BCC_IncludePath Condition="'$(BCC_IncludePath)'==''">$(IncludePath)</BCC_IncludePath>
  </PropertyGroup>


  <!--
  ========================================================================
    LD based options for iOS, OSX, Android And Linux platforms
  ========================================================================
  -->
  <PropertyGroup Condition="'$(Platform)'=='$(cAndroidArm32Platform)'
                         Or '$(Platform)'=='$(cAndroidArm64Platform)'
                         Or '$(Platform)'=='$(ciOSDevice32Platform)'
                         Or '$(Platform)'=='$(ciOSDevice64Platform)'
                         Or '$(Platform)'=='$(cLinux64Platform)'
                         Or '$(Platform)'=='$(cOSX64Platform)'
                         Or '$(Platform)'=='$(cOSXArm64Platform)'">
    <ILINK_LibraryPath Condition="('$(Platform)'=='$(cAndroidArm32Platform)' Or '$(Platform)'=='$(cAndroidArm64Platform)') And '$(ILINK_LibraryPath)'!=''">$(ILINK_LibraryPath);$(CBuilderNDKLibraryPath);$(DelphiNDKLibraryPath)</ILINK_LibraryPath>
    <ILINK_LibraryPath Condition="('$(Platform)'=='$(cAndroidArm32Platform)' Or '$(Platform)'=='$(cAndroidArm64Platform)') And '$(ILINK_LibraryPath)'==''">$(CBuilderNDKLibraryPath);$(DelphiNDKLibraryPath)</ILINK_LibraryPath>

    <!-- iOS SDK paths -->
    <ILINK_LibraryPath Condition="('$(Platform)'=='$(ciOSDevice32Platform)'
                                Or '$(Platform)'=='$(ciOSDevice64Platform)'
                                Or '$(Platform)'=='$(cOSX64Platform)'
                                Or '$(Platform)'=='$(cOSXArm64Platform)'
                                  ) And '$(ILINK_LibraryPath)'!=''"
                                  >$(ILINK_LibraryPath);$(Profile_SysRoot)\usr\lib;$(Profile_SysRoot)\System\Library\Frameworks</ILINK_LibraryPath>
    <ILINK_LibraryPath Condition="('$(Platform)'=='$(ciOSDevice32Platform)'
                                Or '$(Platform)'=='$(ciOSDevice64Platform)'
                                Or '$(Platform)'=='$(cOSX64Platform)'
                                Or '$(Platform)'=='$(cOSXArm64Platform)'
                                  ) And '$(ILINK_LibraryPath)'==''"
                                  >$(Profile_SysRoot)\usr\lib;$(Profile_SysRoot)\System\Library\Frameworks</ILINK_LibraryPath>
    <!-- Be careful with this options and the order of them. Android linker needs a mix of options to load libraries in on estricted order
        -lrtlhelper
        -ProjectX.lnk that contains the start-up code, SysInit.o and the user object files
        -lUseLibrariesToLink (e.g. -lrtl, -lfmx and the rest of PackageLibs)
        -lUseLibrariesToLink  (ILINK_AdditionalLibs generic libraries (ie. -lcompiler_rt -lgnusl_static)
    -->
    <LD_UseLibrariesToLink Condition="'$(ILINK_PackageLibs)'!=''">@(ILINK_PackageLibs->'%(filename)')</LD_UseLibrariesToLink>
    <LD_UseLibrariesToLink Condition="'$(ILINK_PackageLibs)'==''">rtl</LD_UseLibrariesToLink>
    <!-- If libsqlib or libmidas are linked, Force add rtlhelper first to avoid unexpected link of new/new[] operator. -->
    <LD_UseLibrariesToLink Condition="'$(ILink_LinkwithSQL)'!='false' Or '$(ILink_LinkwithMidas)'!='false'">$(LD_UseLibrariesToLink);$(RtlHelperLibraryName)</LD_UseLibrariesToLink>
    <LD_UseLibrariesToLink Condition="'$(ILink_LinkwithSQL)'!='false' And '$(Platform)'!='$(cOSX64Platform)' And '$(Platform)'!='$(cOSXArm64Platform)'">$(LD_UseLibrariesToLink);sqlib</LD_UseLibrariesToLink>
    <LD_UseLibrariesToLink Condition="'$(ILink_LinkwithIntebaseTogo)'!='false' And '$(Platform)'!='$(cOSX64Platform)' And '$(Platform)'!='$(cOSXArm64Platform)'">$(LD_UseLibrariesToLink);ibtogo</LD_UseLibrariesToLink>
    <LD_UseLibrariesToLink Condition="'$(ILink_LinkwithMidas)'!='false' And '$(Platform)'!='$(cOSX64Platform)' And '$(Platform)'!='$(cOSXArm64Platform)'">$(LD_UseLibrariesToLink);midas</LD_UseLibrariesToLink>
    <LD_UseLibrariesToLink Condition="'$(ILink_LinkwithZLib)'!='false'">$(LD_UseLibrariesToLink);z</LD_UseLibrariesToLink>
    <LD_UseLibrariesToLink Condition="('$(Platform)'=='$(cAndroidArm32Platform)' Or '$(Platform)'=='$(cAndroidArm64Platform)') And '$(ILink_LinkwithSQLite)'!='false'">$(LD_UseLibrariesToLink);sqlite</LD_UseLibrariesToLink>
    <LD_UseLibrariesToLink Condition="('$(Platform)'=='$(ciOSDevice32Platform)' Or '$(Platform)'=='$(ciOSDevice64Platform)') And '$(ILink_LinkwithSQLite)'!='false'">$(LD_UseLibrariesToLink);sqlite</LD_UseLibrariesToLink>
    <LD_UseLibrariesToLink Condition="('$(Platform)'=='$(ciOSDevice32Platform)' Or '$(Platform)'=='$(ciOSDevice64Platform)') And '$(ILink_LinkwithSSLandCrypto)'=='true'">$(LD_UseLibrariesToLink);ssl;crypto</LD_UseLibrariesToLink>
    <LD_UseLibrariesToLink Condition="'$(ILINK_LinkwithIndy)'!='false'">$(LD_UseLibrariesToLink);IndyCore;IndyProtocols;IndySystem</LD_UseLibrariesToLink>
    <LD_UseLibrariesToLink Condition="('$(Platform)'=='$(ciOSDevice32Platform)' Or '$(Platform)'=='$(ciOSDevice64Platform)') And '$(ILINK_LinkwithRegEx)'!='false'">$(LD_UseLibrariesToLink);pcre</LD_UseLibrariesToLink>
    <!--
    <LD_UseLibrariesToLink Condition="('$(Platform)'=='$(ciOSDevice32Platform)' Or '$(Platform)'=='$(ciOSDevice64Platform)' Or '$(Platform)'=='$(cAndroidArm32Platform)' Or '$(Platform)'=='$(cAndroidArm64Platform)') And '$(ILINK_LinkwithDUnitXRuntime)'=='true'">$(LD_UseLibrariesToLink);DUnitXRuntime</LD_UseLibrariesToLink>
    -->

    <LD_UseLibrariesToLink Condition="'$(ILink_AdditionalLinkerFiles)'!=''">$(LD_UseLibrariesToLink);$(ILink_AdditionalLinkerFiles)</LD_UseLibrariesToLink>
    <!-- ILINK_AdditionalLibs should be pased last (generic libraries) -->
    <LD_UseLibrariesToLink Condition="'$(ILINK_AdditionalLibs)'!=''">$(LD_UseLibrariesToLink);$(ILINK_AdditionalLibs)</LD_UseLibrariesToLink>

    <LD_ForceLoadStaticLibraries Condition="('$(Platform)'=='$(ciOSDevice32Platform)'
                                          Or '$(Platform)'=='$(ciOSDevice64Platform)') And '$(LANGDIR)'!=''">$(SystemLibraryPath)\$(LANGDIR)\liblocalizedlib.a;$(LD_ForceLoadStaticLibraries)</LD_ForceLoadStaticLibraries>

    <!-- Startup and end codes for Android -->
    <LD_SetStartupCodeToUse Condition="'$(Platform)'=='$(cAndroidArm32Platform)' Or '$(Platform)'=='$(cAndroidArm64Platform)'">$(ILINK_StartupObjs);$(SystemLibraryPath)\start_android.o;$(SystemLibraryPath)\startup_android.o;$(SystemLibraryPath)\SysInit.o</LD_SetStartupCodeToUse>
    <LD_SetEndCodeToUse Condition="'$(Platform)'=='$(cAndroidArm32Platform)' Or '$(Platform)'=='$(cAndroidArm64Platform)'">$(SystemLibraryPath)\end_android.o;$(EndCodeObj)</LD_SetEndCodeToUse>

    <!-- Startup and end codes for iOS -->
    <LD_SetStartupCodeToUse Condition="('$(Platform)'=='$(ciOSDevice32Platform)' Or '$(Platform)'=='$(ciOSDevice64Platform)')">$(SystemLibraryPath)\$(StartupObj);$(SystemLibraryPath)\SysInit.o</LD_SetStartupCodeToUse>
    <LD_SetEndCodeToUse Condition="('$(Platform)'=='$(ciOSDevice32Platform)' Or '$(Platform)'=='$(ciOSDevice64Platform)')">$(SystemLibraryPath)\$(EndCodeObj)</LD_SetEndCodeToUse>

    <!-- Startup and end codes for Linux -->
    <LD_SetStartupCodeToUse Condition="'$(Platform)'=='$(cLinux64Platform)'">$(ILINK_StartupObjs);$(SystemLibraryPath)\start_linux64.o</LD_SetStartupCodeToUse>
    <LD_SetEndCodeToUse Condition="'$(Platform)'=='$(cLinux64Platform)'">$(SystemLibraryPath)\end_linux64.o;$(EndCodeObj)</LD_SetEndCodeToUse>
  </PropertyGroup>



  <!--
  ========================================================================
    Property group for Android platform
  ========================================================================
  -->
  <PropertyGroup Condition="'$(Platform)'=='$(cAndroidArm32Platform)' Or '$(Platform)'=='$(cAndroidArm64Platform)'">

    <DCC_LibraryPath>$(DelphiNDKLibraryPath)</DCC_LibraryPath>
    <DCC_LinkerOptions Condition="'$(LibraryPath)'!=''">$(DCC_LinkerOptions) -L "$(LibraryPath)"</DCC_LinkerOptions>
    <!-- Android NDK External linker -->
    <DCC_LinkerExecutable>$(NDKArmLinuxAndroidFile)</DCC_LinkerExecutable>

    <LD_AndroidOutputFileName>@(OutputFile)</LD_AndroidOutputFileName>
    <LD_SysRoot Condition="'$(Platform)'=='$(cAndroidArm32Platform)'">$(NDKApiPath)\arch-arm</LD_SysRoot>
    <LD_SysRoot Condition="'$(Platform)'=='$(cAndroidArm64Platform)'">$(NDKApiPath)\arch-arm64</LD_SysRoot>
    <LD_SharedLibrary>true</LD_SharedLibrary>
    <LD_VersionScriptFile>$(BDS)\bin\AndroidSymbols.vsr</LD_VersionScriptFile>
    <LD_UndefinedSymbols>true</LD_UndefinedSymbols>
    <LD_ReportUnresolvedSymRef>noexecstack;relro;now;muldefs</LD_ReportUnresolvedSymRef>
    <LD_ForceLoad_RtlHelper>true</LD_ForceLoad_RtlHelper>
    <LD_StartLibraryGroup>true</LD_StartLibraryGroup>
    <LD_EndLibraryGroup>true</LD_EndLibraryGroup>
    <LD_ForceLoad_Rtl>true</LD_ForceLoad_Rtl>
    <LD_AndroidOutputMapFile Condition="'$(ILINK_GenerateMapFile)'=='true'">@(ILinkMapFile)</LD_AndroidOutputMapFile>

    <CLANG_SysRoot Condition=" Exists('$(NDKBasePath)\sysroot')">$(NDKBasePath)\sysroot</CLANG_SysRoot>
    <CLANG_SysRoot Condition="!Exists('$(NDKBasePath)\sysroot')">$(NDKApiPath)\arch-arm</CLANG_SysRoot>
    <BCC_IDirAfter Condition="'$(Platform)'=='$(cAndroidArm32Platform)' And '$(BCC_IDirAfter)'!=''">$(BCC_IDirAfter);=\usr\include;=\usr\include\arm-linux-androideabi;$(STDCInclude);$(NDKBasePath)\sources\android\native_app_glue</BCC_IDirAfter>
    <BCC_IDirAfter Condition="'$(Platform)'=='$(cAndroidArm32Platform)' And '$(BCC_IDirAfter)'==''">=\usr\include;=\usr\include\arm-linux-androideabi;$(STDCInclude);$(NDKBasePath)\sources\android\native_app_glue</BCC_IDirAfter>
    <BCC_IDirAfter Condition="'$(Platform)'=='$(cAndroidArm64Platform)' And '$(BCC_IDirAfter)'!=''">$(BCC_IDirAfter);=\usr\include;=\usr\include\aarch64-linux-android;$(STDCInclude);$(NDKBasePath)\sources\android\native_app_glue</BCC_IDirAfter>
    <BCC_IDirAfter Condition="'$(Platform)'=='$(cAndroidArm64Platform)' And '$(BCC_IDirAfter)'==''">=\usr\include;=\usr\include\aarch64-linux-android;$(STDCInclude);$(NDKBasePath)\sources\android\native_app_glue</BCC_IDirAfter>
    <CLANG_UseSoftFloatingPoint>true</CLANG_UseSoftFloatingPoint>
    <CLANG_UseFloatABI>soft</CLANG_UseFloatABI>
    <CLANG_OnlyFramePointer>true</CLANG_OnlyFramePointer>
    <CLANG_GenObjFileUsingLLVM>true</CLANG_GenObjFileUsingLLVM>
    <CLANG_EmitConstructorAliases>true</CLANG_EmitConstructorAliases>
    <CLANG_TargetTriple Condition="'$(Platform)'=='$(cAndroidArm32Platform)'">thumbv7-none-linux-androideabi</CLANG_TargetTriple>
    <CLANG_TargetTriple Condition="'$(Platform)'=='$(cAndroidArm64Platform)'">aarch64-none-linux-android</CLANG_TargetTriple>
    <CLANG_TargetABI Condition="'$(Platform)'=='$(cAndroidArm32Platform)' And '$(CLANG_TargetABI)'==''">aapcs-linux</CLANG_TargetABI>
    <CLANG_TargetCPU Condition="'$(Platform)'=='$(cAndroidArm32Platform)' And '$(BCC_TargetCPU)'==''">-target-cpu cortex-a8</CLANG_TargetCPU>
    <CLANG_TargetABI Condition="'$(Platform)'=='$(cAndroidArm64Platform)' And '$(CLANG_TargetABI)'==''">aapcs</CLANG_TargetABI>
    <CLANG_TargetCPU Condition="'$(Platform)'=='$(cAndroidArm64Platform)' And '$(BCC_TargetCPU)'==''">-target-cpu generic</CLANG_TargetCPU>
    <CLANG_TargetCPU Condition="'$(BCC_TargetCPU)'!=''">$(BCC_TargetCPU)</CLANG_TargetCPU>
  </PropertyGroup>


  <!--
  ========================================================================
    Property group for iOS platforms
  ========================================================================
  -->
  <PropertyGroup Condition="'$(Platform)'=='$(ciOSSimulatorArm64Platform)' Or '$(Platform)'=='$(ciOSDevice32Platform)' Or '$(Platform)'=='$(ciOSDevice64Platform)'">

    <!-- Should we use ILINK_iOSMinimumVersion value instead ? -->
    <DCC_iOSMinimumVersion Condition="'$(Platform)'!='$(ciOSSimulatorArm64Platform)' And '$(DCC_iOSMinimumVersion)'==''">11.0</DCC_iOSMinimumVersion>
    <DCC_SysLibRoot Condition="'$(Platform)'!='$(ciOSSimulatorArm64Platform)' And '$(DCC_SysLibRoot)'!=''">$(DCC_SysLibRoot);$(Profile_sysroot)</DCC_SysLibRoot>
    <DCC_SysLibRoot Condition="'$(Platform)'!='$(ciOSSimulatorArm64Platform)' And '$(DCC_SysLibRoot)'==''">$(Profile_sysroot)</DCC_SysLibRoot>
    <DCC_FrameworkPath  Condition="'$(Platform)'!='$(ciOSSimulatorArm64Platform)' And '$(DCC_FrameworkPath)'!=''">$(DCC_FrameworkPath);$(Profile_Frameworkroot)</DCC_FrameworkPath>
    <DCC_FrameworkPath Condition="'$(Platform)'!='$(ciOSSimulatorArm64Platform)' And '$(DCC_FrameworkPath)'==''">$(Profile_Frameworkroot)</DCC_FrameworkPath>
    <DCC_LinkerOptions Condition="'$(DCC_LinkerOptions)'!='' And '$(Platform)'=='$(ciOSDevice32Platform)'">$(DCC_LinkerOptions) -arch armv7</DCC_LinkerOptions>
    <DCC_LinkerOptions Condition="'$(DCC_LinkerOptions)'=='' And '$(Platform)'=='$(ciOSDevice32Platform)'">-arch armv7</DCC_LinkerOptions>
    <DCC_LinkerOptions Condition="'$(DCC_LinkerOptions)'!='' And '$(Platform)'=='$(ciOSDevice64Platform)'">$(DCC_LinkerOptions) -arch arm64</DCC_LinkerOptions>
    <DCC_LinkerOptions Condition="'$(DCC_LinkerOptions)'=='' And '$(Platform)'=='$(ciOSDevice64Platform)'">-arch arm64</DCC_LinkerOptions>

    <ILINK_iOSMinimumVersion Condition="('$(Platform)'=='$(ciOSDevice32Platform)' Or '$(Platform)'=='$(ciOSDevice64Platform)') And '$(ILINK_iOSMinimumVersion)'==''">11.0</ILINK_iOSMinimumVersion>
    <RC_MinimumIOSVersion>$(ILINK_iOSMinimumVersion)</RC_MinimumIOSVersion>

    <ILINK_DefaultExportSymbols>_@DbgExcNotify;__CPPDbgExcNotify;_MachExceptionsSuspend;_MachExceptionsResume;_dbkFCallWrapperAddr;___dbk_fcall_wrapper</ILINK_DefaultExportSymbols>
    <ILINK_SymbolsToExport Condition="'$(ILINK_SymbolsToExport)'!=''">$(ILINK_SymbolsToExport);$(ILINK_DefaultExportSymbols)</ILINK_SymbolsToExport>
    <ILINK_SymbolsToExport Condition="'$(ILINK_SymbolsToExport)'==''">$(ILINK_DefaultExportSymbols)</ILINK_SymbolsToExport>
    <ILINK_SymbolsToExport>$(ILINK_SymbolsToExport);___rsrc_*;___rstr_*</ILINK_SymbolsToExport>

    <LD_DebugInfoOptimization Condition="'$(ILINK_FullDebugInfo)'=='true'">false</LD_DebugInfoOptimization>
    <LD_DebugInfoOptimization Condition="'$(ILINK_FullDebugInfo)'!='true'">true</LD_DebugInfoOptimization>
    <LD_SystemLibraries>$(Profile_SysRoot)\usr\lib\libiconv.dylib;$(Profile_SysRoot)\usr\lib\libobjc.dylib</LD_SystemLibraries>
    <LD_LinkDynamically>true</LD_LinkDynamically>
    <LD_RemoveUnreachableSymbols>true</LD_RemoveUnreachableSymbols>
    <LD_TargetArhitecture Condition="'$(Platform)'=='$(ciOSDevice32Platform)'">-arch armv7</LD_TargetArhitecture>
    <LD_TargetArhitecture Condition="'$(Platform)'=='$(ciOSDevice64Platform)'">-arch arm64</LD_TargetArhitecture>
    <LD_TargetArhitecture Condition="'$(Platform)'=='$(ciOSSimulatorArm64Platform)'">-arch arm64</LD_TargetArhitecture>
    <LD_iOSOutputMapFile Condition="'$(ILINK_GenerateMapFile)'=='true'">@(ILinkMapFile)</LD_iOSOutputMapFile>

    <BCC_IDirAfter Condition="'$(BCC_IDirAfter)'!=''">$(BCC_IDirAfter);=\usr\include;=\usr\include\c++\v1;=\usr\lib\clang\include;=\usr\include\pthread</BCC_IDirAfter>
    <BCC_IDirAfter Condition="'$(BCC_IDirAfter)'==''">=\usr\include;=\usr\include\c++\v1;=\usr\lib\clang\include;=\usr\include\pthread</BCC_IDirAfter>
    <BCC_FrameworkRoot Condition="$(BCC_FrameworkRoot)!=''">$(BCC_FrameworkRoot);$(Profile_SysRoot)\System\Library\Frameworks</BCC_FrameworkRoot>
    <BCC_FrameworkRoot Condition="$(BCC_FrameworkRoot)==''">$(Profile_SysRoot)\System\Library\Frameworks</BCC_FrameworkRoot>

    <CLANG_SysRoot>$(Profile_SysRoot)</CLANG_SysRoot>
    <CLANG_DisableFramePtrElimOpt>true</CLANG_DisableFramePtrElimOpt>
    <CLANG_UseSjLjExcpetions>true</CLANG_UseSjLjExcpetions>
    <CLANG_UseMappableDiagnostics>true</CLANG_UseMappableDiagnostics>
    <CLANG_TargetTriple Condition="'$(Platform)'=='$(ciOSDevice32Platform)'">thumbv7-apple-ios</CLANG_TargetTriple>
    <CLANG_TargetTriple Condition="'$(Platform)'=='$(ciOSDevice64Platform)'">arm64-apple-ios7</CLANG_TargetTriple>
    <CLANG_TargetTriple Condition="'$(Platform)'=='$(ciOSSimulatorArm64Platform)'">arm64-apple-ios7</CLANG_TargetTriple>
    <CLANG_TargetABI Condition="('$(Platform)'=='$(ciOSDevice32Platform)' And '$(CLANG_TargetABI)'=='')">apcs-gnu</CLANG_TargetABI>
    <CLANG_TargetABI Condition="('$(Platform)'=='$(ciOSDevice64Platform)' And '$(CLANG_TargetABI)'=='')">darwinpcs</CLANG_TargetABI>
    <CLANG_TargetABI Condition="('$(Platform)'=='$(ciOSSimulatorArm64Platform)' And '$(CLANG_TargetABI)'=='')">darwinpcs</CLANG_TargetABI>
  </PropertyGroup>


  <!--
  ========================================================================
    Property group for Linux64 platforms
  ========================================================================
  -->
  <PropertyGroup Condition="'$(Platform)'=='$(cLinux64Platform)'">
    <!-- More Required Here -->
    <CLANG_TargetTriple>x86_64-pc-linux</CLANG_TargetTriple>
    <CLANG_SysRoot>$(Profile_SysRoot)</CLANG_SysRoot>

    <CLANG_BorlandAutoRefCount>false</CLANG_BorlandAutoRefCount>

    <BCC_IDirAfter Condition="'$(BCC_IDirAfter)'!=''">$(BCC_IDirAfter);$(Profile_includepath)</BCC_IDirAfter>
    <BCC_IDirAfter Condition="'$(BCC_IDirAfter)'==''">$(Profile_includepath)</BCC_IDirAfter>

    <LD_SysRoot>$(Profile_SysRoot)</LD_SysRoot>
    <LD_ExceptionFrameHeader>true</LD_ExceptionFrameHeader>
    <LD_LinkerEmulation>elf_x86_64</LD_LinkerEmulation>
    <LD_DynamicLinker>/lib64/ld-linux-x86-64.so.2</LD_DynamicLinker>
    <LD_SharedLibrary Condition="'$(AppType)'=='Library' Or '$(AppType)'=='Package'">true</LD_SharedLibrary>
    <LD_ReportUnresolvedSymRef>relro</LD_ReportUnresolvedSymRef>
    <LD_ReportUnresolvedSymRef Condition="'$(LD_SharedLibrary)'=='true'">$(LD_ReportUnresolvedSymRef);noexecstack</LD_ReportUnresolvedSymRef>
    <LD_GenerateBuildID>true</LD_GenerateBuildID>
    <LD_StartLibraryGroup>true</LD_StartLibraryGroup>
    <LD_EndLibraryGroup>true</LD_EndLibraryGroup>
    <LD_AndroidOutputMapFile Condition="'$(ILINK_GenerateMapFile)'=='true'">@(ILinkMapFile)</LD_AndroidOutputMapFile>

    <LD_RuntimeSearchPath Condition="'$(RuntimeSearchPath)'!='' And '$(AppType)'!='Library' And '$(AppType)'!='Package'">$(RuntimeSearchPath)</LD_RuntimeSearchPath>
    <LD_RuntimeSearchPath Condition="'$(RuntimeSearchPath)'==''"> $ORIGIN</LD_RuntimeSearchPath>

    <ILINK_LibraryPath Condition="'$(Platform)'=='$(cLinux64Platform)' And '$(ILINK_LibraryPath)'!=''">$(ILINK_LibraryPath);$(Profile_librarypath)</ILINK_LibraryPath>
    <ILINK_LibraryPath Condition="'$(Platform)'=='$(cLinux64Platform)' And '$(ILINK_LibraryPath)'==''">$(Profile_librarypath)</ILINK_LibraryPath>
    <LD_UseLibrariesToLink>dl;c;m;stdc++;gcc_s;gcc</LD_UseLibrariesToLink>

    <!-- Use Package Analysis for static linking -->
    <ILINK_PackageLibs Condition="'$(UsePackages)'=='' And '$(UsingDelphiRTL)'=='true' And '$(LinkPackageStatics)'!=''">$(LinkPackageStatics)</ILINK_PackageLibs>
    <ILINK_PackageLibs Condition="'$(UsePackages)'=='' And '$(UsingDelphiRTL)'=='true' And '$(LinkPackageStatics)'==''">rtl.lib</ILINK_PackageLibs>
    <LD_UseLibrariesToLink Condition="'$(UsePackages)'=='' And '$(UsingDelphiRTL)'=='true' And '$(ILINK_PackageLibs)'!=''">$(LD_UseLibrariesToLink);@(ILINK_PackageLibs->'%(filename)')</LD_UseLibrariesToLink>
    <!-- [END] Use Package Analysis for static linking -->

    <!-- Use Package Analysis for dynamic linking -->
    <LD_UsePackagesToLink Condition="'$(UsePackages)'=='true' And '$(UsingDelphiRTL)'=='true' And '$(LinkPackageImports)'!=''">@(ILINK_PackageImports->':%(filename).$(BpiExt)')</LD_UsePackagesToLink>
    <LD_UsePackagesToLink Condition="'$(UsePackages)'=='true' And '$(UsingDelphiRTL)'=='true' And '$(LinkPackageImports)'==''">:rtl.bpi</LD_UsePackagesToLink>
    <ILINK_LibraryPath Condition="'$(UsingDelphiRTL)'=='true' And '$(UsePackages)'=='true'">$(ILINK_LibraryPath);$(BDS)\binlinux64</ILINK_LibraryPath>
    <!-- [END] Use Package Analysis for dynamic linking -->

    <LD_UseLibrariesToLink Condition="'$(ILINK_LinkwithPThread)'!='false'">$(LD_UseLibrariesToLink);pthread</LD_UseLibrariesToLink>
    <LD_UseLibrariesToLink Condition="'$(UsingDelphiRTL)'=='true'">$(RtlHelperLibraryName);$(LD_UseLibrariesToLink);cgcrtl;rtle;$(CommonLibraries)</LD_UseLibrariesToLink>
  </PropertyGroup>

  <!--
  ========================================================================
    Property group for Win64x platform
  ========================================================================
  -->
  <PropertyGroup Condition="'$(Platform)'=='$(cWin64xPlatform)'">
    <!-- Startup and end codes -->
    <LD_SetStartupCodeToUse>$(ILINK_StartupObjs);$(BDS)\x86_64-w64-mingw32\lib\crtbegin.o</LD_SetStartupCodeToUse>
    <LD_SetEndCodeToUse>$(BDS)\lib\clang\20\lib\windows\libclang_rt.builtins-x86_64.a;$(EndCodeObj)</LD_SetEndCodeToUse>

    <LD_LinkerEmulation>i386pep</LD_LinkerEmulation>

    <LD_StaticLink Condition="'$(DynamicRTL)'!='true'">true</LD_StaticLink>
    <LD_DynamicLink Condition="'$(DynamicRTL)'=='true'">true</LD_DynamicLink>
    <LD_SharedLibrary Condition="'$(AppType)'=='Library' Or '$(AppType)'=='Package'">true</LD_SharedLibrary>

    <LD_WindowOutputMSLinkMapFile Condition="'$(ILINK_MapFileType_lld)'=='MSLink' Or '$(ILINK_MapFileType_lld)'==''">@(ILinkMapFile)</LD_WindowOutputMSLinkMapFile>
    <LD_WindowOutputLLDMapFile Condition="'$(ILINK_MapFileType_lld)'=='LLD'">@(ILinkMapFile)</LD_WindowOutputLLDMapFile>

    <LD_GeneratePDBFile Condition="'$(BCC_SourceDebuggingOn)'=='true'">$(FinalOutputDir)$(OutputName).pdb</LD_GeneratePDBFile>

    <ILINK_LibraryPath Condition="'$(UsingDelphiRTL)'=='true' And '$(UsePackages)'=='true'">$(ILINK_LibraryPath);$(BDS)\bin64</ILINK_LibraryPath>

    <LD_UseLibrariesToLink>moldname;ucrt;mingw32;mingwex;c++;unwind</LD_UseLibrariesToLink>
    <LD_UseLibrariesToLink Condition="'$(Multithreaded)'=='true'">$(LD_UseLibrariesToLink);mingwthrd</LD_UseLibrariesToLink>

    <!-- Use Package Analysis for static linking -->
    <LD_UseLibrariesToLink_lld Condition="'$(DelphiRTLLibs)'!=''">$(LD_UseLibrariesToLink_lld);$(DelphiRTLLibs)</LD_UseLibrariesToLink_lld>
    <LD_UseLibrariesToLink_lld Condition="'$(ILINK_PackageLibs)'!=''">$(LD_UseLibrariesToLink_lld);@(ILINK_PackageLibs->'%(filename).$(LibExt)')</LD_UseLibrariesToLink_lld>

    <LD_UseLibrariesToLink_lld Condition="'$(ILink_AdditionalLinkerFiles)'!=''">$(LD_UseLibrariesToLink_lld);$(ILink_AdditionalLinkerFiles)</LD_UseLibrariesToLink_lld>
    <LD_UseLibrariesToLink_lld Condition="'$(ILINK_AdditionalLibs)'!=''">$(LD_UseLibrariesToLink_lld);$(ILINK_AdditionalLibs)</LD_UseLibrariesToLink_lld>

    <!-- Use Package Analysis for dynamic linking -->
    <LD_UsePackagesToLink_lld Condition="'$(DelphiRTLBpis)'!=''">$(DelphiRTLBpis)</LD_UsePackagesToLink_lld>
    <LD_UsePackagesToLink_lld Condition="'$(ILINK_PackageImports)'!=''">$(LD_UsePackagesToLink_lld);@(ILINK_PackageImports->'%(filename).$(BpiExt)')</LD_UsePackagesToLink_lld>
    <LD_UsePackagesToLink></LD_UsePackagesToLink>

    <CLANG_TargetCPU Condition="'$(BCC_TargetCPU)'==''">-target-cpu x86-64</CLANG_TargetCPU>
    <CLANG_TuneCPU>-tune-cpu generic</CLANG_TuneCPU>
    <CLANG_UsePosIndCodeForObjectFile>true</CLANG_UsePosIndCodeForObjectFile>

    <DCC_AdditionalSwitches Condition="'$(DCC_AdditionalSwitches)'!=''">$(DCC_AdditionalSwitches) -JF:COFFI</DCC_AdditionalSwitches>
    <DCC_AdditionalSwitches Condition="'$(DCC_AdditionalSwitches)'==''">-JF:COFFI</DCC_AdditionalSwitches>

    <LD_StripDebugInfo_lld Condition="'$(ILINK_FullDebugInfo)'!='true'">true</LD_StripDebugInfo_lld>

    <LD_HeapReserveCommitSize_lld Condition="'$(ILINK_HeapReserveSize)'!=''">$(ILINK_HeapReserveSize)</LD_HeapReserveCommitSize_lld>
    <LD_HeapReserveCommitSize_lld Condition="'$(ILINK_HeapReserveSize)'==''">0x00100000</LD_HeapReserveCommitSize_lld>
    <LD_HeapReserveCommitSize_lld Condition="'$(ILINK_HeapCommitSize)'!=''">$(LD_HeapReserveCommitSize_lld),$(ILINK_HeapCommitSize)</LD_HeapReserveCommitSize_lld>
    <LD_HeapReserveCommitSize_lld Condition="'$(ILINK_HeapCommitSize)'==''">$(LD_HeapReserveCommitSize_lld),0x00001000</LD_HeapReserveCommitSize_lld>
    <LD_HeapReserveCommitSize_lld Condition="'$(ILINK_HeapReserveSize)'=='' And '$(ILINK_HeapCommitSize)'==''"></LD_HeapReserveCommitSize_lld>

    <LD_StackReserveCommitSize_lld Condition="'$(ILINK_StackReserveSize)'!=''">$(ILINK_StackReserveSize)</LD_StackReserveCommitSize_lld>
    <LD_StackReserveCommitSize_lld Condition="'$(ILINK_StackReserveSize)'==''">0x00100000</LD_StackReserveCommitSize_lld>
    <LD_StackReserveCommitSize_lld Condition="'$(ILINK_StackCommitSize)'!=''">$(LD_StackReserveCommitSize_lld),$(ILINK_StackCommitSize)</LD_StackReserveCommitSize_lld>
    <LD_StackReserveCommitSize_lld Condition="'$(ILINK_StackCommitSize)'==''">$(LD_StackReserveCommitSize_lld),0x00002000</LD_StackReserveCommitSize_lld>
    <LD_StackReserveCommitSize_lld Condition="'$(ILINK_StackReserveSize)'=='' And '$(ILINK_StackCommitSize)'==''"></LD_StackReserveCommitSize_lld>

    <!-- disable all TLIB options -->
    <TLIB_CaseSensitive></TLIB_CaseSensitive>
    <TLIB_PageSize></TLIB_PageSize>
    <TLIB_PurgeCommentRecords></TLIB_PurgeCommentRecords>
    <TLib_ListingFileName></TLib_ListingFileName>

    <!-- sanitizer options -->
    <BCC_Sanitizer Condition="'$(BCC_AddressSanitizer)'=='true' And '$(BCC_UndefinedBehaviorSanitizer)'=='true'">true</BCC_Sanitizer>
    <BCC_AddressSanitizer Condition="'$(BCC_Sanitizer)'=='true'">false</BCC_AddressSanitizer>
    <BCC_UndefinedBehaviorSanitizer Condition="'$(BCC_Sanitizer)'=='true'">false</BCC_UndefinedBehaviorSanitizer>

    <ILINK_AdditionalOptions Condition="'$(BCC_AddressSanitizer)'=='true' Or '$(BCC_Sanitizer)'=='true'">libclang_rt.asan_dynamic-x86_64.dll.a libclang_rt.asan_dynamic_runtime_thunk-x86_64.a --require-defined __asan_seh_interceptor --whole-archive libclang_rt.asan_dynamic_runtime_thunk-x86_64.a --no-whole-archive $(ILINK_AdditionalOptions)</ILINK_AdditionalOptions>
  </PropertyGroup>

  <!--
  ========================================================================
    Property group for OSX platforms
  ========================================================================
  -->
  <PropertyGroup Condition="'$(Platform)'=='$(cOSX64Platform)' Or '$(Platform)'=='$(cOSXArm64Platform)'">

    <!-- Should we use ILINK_macOSMinimumVersion value instead ? -->
    <DCC_macOSMinimumVersion Condition="'$(Platform)'=='OSX64' And '$(DCC_macOSMinimumVersion)'==''">10.14</DCC_macOSMinimumVersion>
    <DCC_macOSArmMinimumVersion Condition="'$(Platform)'=='OSXARM64' And '$(DCC_macOSArmMinimumVersion)'==''">11.0</DCC_macOSArmMinimumVersion>
    <DCC_SysLibRoot Condition="'$(Platform)'!='$(ciOSSimulatorArm64Platform)' And '$(DCC_SysLibRoot)'!=''">$(DCC_SysLibRoot);$(Profile_sysroot)</DCC_SysLibRoot>
    <DCC_SysLibRoot Condition="'$(Platform)'!='$(ciOSSimulatorArm64Platform)' And '$(DCC_SysLibRoot)'==''">$(Profile_sysroot)</DCC_SysLibRoot>
    <DCC_FrameworkPath  Condition="'$(Platform)'!='$(ciOSSimulatorArm64Platform)' And '$(DCC_FrameworkPath)'!=''">$(DCC_FrameworkPath);$(Profile_Frameworkroot)</DCC_FrameworkPath>
    <DCC_FrameworkPath Condition="'$(Platform)'!='$(ciOSSimulatorArm64Platform)' And '$(DCC_FrameworkPath)'==''">$(Profile_Frameworkroot)</DCC_FrameworkPath>
    <DCC_LinkerOptions Condition="'$(DCC_LinkerOptions)'!=''">$(DCC_LinkerOptions) -arch x86_64</DCC_LinkerOptions>
    <DCC_LinkerOptions Condition="'$(DCC_LinkerOptions)'==''">-arch x86_64</DCC_LinkerOptions>

    <ILINK_macOSMinimumVersion Condition="'$(Platform)'=='OSX64' And '$(ILINK_macOSMinimumVersion)'==''">10.14</ILINK_macOSMinimumVersion>
    <RC_MinimumOSXVersion Condition="'$(Platform)'=='OSX64'">$(ILINK_macOSMinimumVersion)</RC_MinimumOSXVersion>

    <ILINK_macOSArmMinimumVersion Condition="'$(Platform)'=='OSXARM64' And '$(ILINK_macOSArmMinimumVersion)'==''">11.0</ILINK_macOSArmMinimumVersion>
    <RC_MinimumOSXVersion Condition="'$(Platform)'=='OSXARM64'">$(ILINK_macOSArmMinimumVersion)</RC_MinimumOSXVersion>

    <!--
    <ILINK_DefaultExportSymbols>_@DbgExcNotify;__CPPDbgExcNotify;_MachExceptionsSuspend;_MachExceptionsResume;_dbkFCallWrapperAddr;___dbk_fcall_wrapper</ILINK_DefaultExportSymbols>
    <ILINK_SymbolsToExport Condition="'$(ILINK_SymbolsToExport)'!=''">$(ILINK_SymbolsToExport);$(ILINK_DefaultExportSymbols)</ILINK_SymbolsToExport>
    <ILINK_SymbolsToExport Condition="'$(ILINK_SymbolsToExport)'==''">$(ILINK_DefaultExportSymbols)</ILINK_SymbolsToExport>
    -->
    <ILINK_SymbolsToExport>$(ILINK_SymbolsToExport);___rsrc_*;___rstr_*</ILINK_SymbolsToExport>

    <LD_DebugInfoOptimization Condition="'$(ILINK_FullDebugInfo)'=='true'">false</LD_DebugInfoOptimization>
    <LD_DebugInfoOptimization Condition="'$(ILINK_FullDebugInfo)'!='true'">true</LD_DebugInfoOptimization>
    <LD_SystemLibraries>$(Profile_SysRoot)\usr\lib\libiconv.dylib;$(Profile_SysRoot)\usr\lib\libobjc.dylib</LD_SystemLibraries>
    <LD_LinkDynamically>true</LD_LinkDynamically>
    <LD_RemoveUnreachableSymbols>true</LD_RemoveUnreachableSymbols>
    <LD_TargetArhitecture>-arch x86_64</LD_TargetArhitecture>
    <LD_iOSOutputMapFile Condition="'$(ILINK_GenerateMapFile)'=='true'">@(ILinkMapFile)</LD_iOSOutputMapFile>

    <BCC_IDirAfter Condition="'$(BCC_IDirAfter)'!=''">$(BCC_IDirAfter);=\usr\include;=\usr\include\c++\v1;=\usr\lib\clang\include;=\usr\include\pthread</BCC_IDirAfter>
    <BCC_IDirAfter Condition="'$(BCC_IDirAfter)'==''">=\usr\include;=\usr\include\c++\v1;=\usr\lib\clang\include;=\usr\include\pthread</BCC_IDirAfter>
    <BCC_FrameworkRoot Condition="$(BCC_FrameworkRoot)!=''">$(BCC_FrameworkRoot);$(Profile_SysRoot)\System\Library\Frameworks</BCC_FrameworkRoot>
    <BCC_FrameworkRoot Condition="$(BCC_FrameworkRoot)==''">$(Profile_SysRoot)\System\Library\Frameworks</BCC_FrameworkRoot>

    <CLANG_SysRoot>$(Profile_SysRoot)</CLANG_SysRoot>
    <CLANG_DisableFramePtrElimOpt>true</CLANG_DisableFramePtrElimOpt>
    <!--
    <CLANG_UseSjLjExcpetions>true</CLANG_UseSjLjExcpetions>
    -->
    <CLANG_UseMappableDiagnostics>true</CLANG_UseMappableDiagnostics>
    <CLANG_TargetTriple>x86_64-apple-macosx</CLANG_TargetTriple>
    <!--
    <CLANG_TargetABI>???</CLANG_TargetABI>
    -->
  </PropertyGroup>


  <!-- Clang based options -->
  <PropertyGroup Condition="'$(USING_CLANG)'=='true'">

    <!-- Workaround BCC looking in current directory -->
    <BCC_AddProjectDirToIncludePath>true</BCC_AddProjectDirToIncludePath>
    <!-- Include Paths -->
    <UserIncludePath Condition="'$(CBuilderUserIncludePath)'!=''">$(CBuilderUserIncludePath)</UserIncludePath>
    <SysIncludePath Condition="'$(CBuilderIncludePath)'!=''">$(SysIncludePath);$(CBuilderIncludePath)</SysIncludePath>
    <SysIncludePath Condition="'$(DelphiHPPOutputPath)'!=''">$(SysIncludePath);$(DelphiHPPOutputPath)</SysIncludePath>
    <SysIncludePath Condition="'$(LANGDIR)'!=''">@(TranslatedIncludePath);$(SysIncludePath)</SysIncludePath>
    <BCC_SystemIncludePath Condition="'$(SysIncludePath)'!=''">$(BCC_SystemIncludePath);$(SysIncludePath)</BCC_SystemIncludePath>
    <BCC_SystemIncludePath Condition="'$(SysIncludePath)'==''">$(SystemIncludePath)</BCC_SystemIncludePath>

    <BCC_IncludePath Condition="'$(BCC_AddProjectDirToIncludePath)'=='true' And '$(BCC_IncludePath)'!=''">$(BCC_IncludePath);$(MSBuildProjectDirectory)</BCC_IncludePath>
    <BCC_IncludePath Condition="'$(BCC_AddProjectDirToIncludePath)'=='true' And '$(BCC_IncludePath)'==''">$(MSBuildProjectDirectory)</BCC_IncludePath>
    <BCC_IncludePath Condition="'$(IncludePath)'!='' And '$(BCC_IncludePath)'==''">$(IncludePath)</BCC_IncludePath>
    <BCC_IncludePath Condition="'$(IncludePath)'!='' And '$(BCC_IncludePath)'!=''">$(BCC_IncludePath);$(IncludePath)</BCC_IncludePath>
    <BCC_IncludePath Condition="'$(UserIncludePath)'!='' And '$(BCC_IncludePath)'==''">$(UserIncludePath)</BCC_IncludePath>
    <BCC_IncludePath Condition="'$(UserIncludePath)'!='' And '$(BCC_IncludePath)'!=''">$(BCC_IncludePath);$(UserIncludePath)</BCC_IncludePath>

    <!--Defines-->
    <CLANG_Defines Condition="'$(CLANG_Defines)'!=''">$(CLANG_Defines);$(Defines)</CLANG_Defines>
    <CLANG_Defines Condition="'$(CLANG_Defines)'==''">$(Defines)</CLANG_Defines>

    <!--Default values-->
    <CLANG_OutputDir>$(BCC_OutputDir)</CLANG_OutputDir>
    <CLANG_BorlandExtensions>true</CLANG_BorlandExtensions>
    <CLANG_NoBuiltInc>true</CLANG_NoBuiltInc>
    <CLANG_NoStdSystemInc>true</CLANG_NoStdSystemInc>
    <CLANG_UnwindTables>true</CLANG_UnwindTables>

    <CLANG15_UnwindTables>true</CLANG15_UnwindTables>
    <CLANG15_DisableFramePtrElimOpt>true</CLANG15_DisableFramePtrElimOpt>
    <CLANG15_ExtendedDebugInfo Condition="'$(Platform)'=='$(cWin64xPlatform)'">$(BCC_SourceDebuggingOn)</CLANG15_ExtendedDebugInfo>
    <CLANG15_ClearClangASTBeforeCodeGen>true</CLANG15_ClearClangASTBeforeCodeGen>
    <CLANG15_EnableFloatFusionOperation>true</CLANG15_EnableFloatFusionOperation>
    <CLANG15_ForceFloatRoundingMode>true</CLANG15_ForceFloatRoundingMode>
    <CLANG15_ForceLongDouble64>true</CLANG15_ForceLongDouble64>
    <CLANG15_SetGCCVersionCompatibility>true</CLANG15_SetGCCVersionCompatibility>
    <CLANG15_SetStructureLayoutToMSStandard>true</CLANG15_SetStructureLayoutToMSStandard>
    <CLANG15_NoSizedDeallocation>true</CLANG15_NoSizedDeallocation>
    <CLANG15_NoUseInitArray>true</CLANG15_NoUseInitArray>
    <CLANG15_SkipOdrCheckInGmf>true</CLANG15_SkipOdrCheckInGmf>
    <CLANG15_EnableVectorizeLoops Condition="'$(BCC_SourceDebuggingOn)'!='true'">true</CLANG15_EnableVectorizeLoops>
    <CLANG15_EnableVectorizeSLP Condition="'$(BCC_SourceDebuggingOn)'!='true'">true</CLANG15_EnableVectorizeSLP>

    <CLANG_FunctionSections Condition="'$(BCC_SourceDebuggingOn)'!='true' And '$(USING_CLANG_WIN32)'!='true'">true</CLANG_FunctionSections>
    <CLANG_FunctionSections Condition="'$(Platform)'=='$(cWin64xPlatform)'">$(BCC_FunctionSections)</CLANG_FunctionSections>

    <CLANG_InputLanguageType>c++</CLANG_InputLanguageType>
    <!-- Language Standard can be configured for clang-based WIN32 -->
    <BCC_LanguageStandard Condition="('$(Platform)'=='$(cWin32Platform)' Or  '$(Platform)'=='$(cWin64Platform)') And '$(BCC_LanguageStandard)'==''">c++17</BCC_LanguageStandard>
    <BCC_LanguageStandard Condition="('$(Platform)'!='$(cWin32Platform)' And '$(Platform)'!='$(cWin64Platform)') And '$(BCC_LanguageStandard)'==''">c++11</BCC_LanguageStandard>
    <BCC_LanguageStandard_v15 Condition="'$(BCC_LanguageStandard_v15)'==''">c++23</BCC_LanguageStandard_v15>
    <CLANG_LanguageStandard Condition="'$(Platform)'!='$(cWin64xPlatform)'">$(BCC_LanguageStandard)</CLANG_LanguageStandard>
    <CLANG_LanguageStandard Condition="'$(Platform)'=='$(cWin64xPlatform)'">$(BCC_LanguageStandard_v15)</CLANG_LanguageStandard>
    <CLANG_EnableCPPExceptions>true</CLANG_EnableCPPExceptions>
    <!--  Removed for WIN64 to handle -O2|EH failures -->
    <CLANG_StackRealign Condition="'$(Platform)'!='$(cWin64Platform)' And '$(Platform)'!='$(cWin64xPlatform)'">true</CLANG_StackRealign>
    <!--  '-mstack-alignment=16' for WIN32 -->
    <CLANG_StackAlign Condition="'$(Platform)'=='$(cWin32Platform)'">16</CLANG_StackAlign>
    <!-- -fno-common is default for WIN64 -->
    <BCC_NoCommon Condition="'$(Platform)'=='$(cWin64Platform)'">true</BCC_NoCommon>
    <!-- Default to DWARFVersion 4 for WIN64 -->
    <BCC_DWARFVersion Condition="'$(Platform)'=='$(cWin64Platform)'">4</BCC_DWARFVersion>

    <CLANG_EnableBlocksLangFeature>true</CLANG_EnableBlocksLangFeature>

    <CLANG_TargetTriple Condition="'$(Platform)'=='$(cWin64Platform)'">x86_64-pc-win32-elf</CLANG_TargetTriple>
    <CLANG_TargetTriple Condition="'$(Platform)'=='$(cWin64xPlatform)'">x86_64-w64-windows-gnu</CLANG_TargetTriple>
    <CLANG_TargetTriple Condition="'$(Platform)'=='$(cWin32Platform)'">i686-pc-windows-omf</CLANG_TargetTriple>

    <CLANG_RunPreprocessor>false</CLANG_RunPreprocessor>
    <CLANG_EmitNativeAssembly>false</CLANG_EmitNativeAssembly>
    <CLANG_DependencyIncDepHeaders>true</CLANG_DependencyIncDepHeaders>
    <CLANG_EmitNativeObject>true</CLANG_EmitNativeObject>
    <CLANG_EmitLLVM>false</CLANG_EmitLLVM>
    <CLANG_EnableExceptions>true</CLANG_EnableExceptions>
    <CLANG_SEH>true</CLANG_SEH>

    <CLANG15_SEH>true</CLANG15_SEH>

    <CLANG_RelaxAllMachineInstructions>$(BCC_DisableOptimizations)</CLANG_RelaxAllMachineInstructions>

    <CLANG_RelocationModel Condition="'$(Platform)'=='$(cWin32Platform)'">static</CLANG_RelocationModel>
    <CLANG_RelocationModel Condition="'$(Platform)'=='$(cLinux64Platform)' And '$(AppType)'!='Library' And '$(AppType)'!='Package'">pic</CLANG_RelocationModel>

    <CLANG_GenVerboseAssemblyOutput Condition="'$(Platform)'!='$(cWin64Platform)' And '$(Platform)'!='$(cWin64xPlatform)'">true</CLANG_GenVerboseAssemblyOutput>
    <CLANG_NotUseCppHeaders Condition="'$(Platform)'!='$(cWin64Platform)' And '$(Platform)'!='$(cWin64xPlatform)'">true</CLANG_NotUseCppHeaders>
    <CLANG_DefineDeprecatedMacros Condition="'$(Platform)'!='$(cWin64Platform)' And '$(Platform)'!='$(cWin64xPlatform)'">true</CLANG_DefineDeprecatedMacros>
    <CLANG_EnableStackProtectors Condition="'$(Platform)'!='$(cWin64Platform)' And '$(Platform)'!='$(cWin64xPlatform)'">true</CLANG_EnableStackProtectors>
    <BCC_PCHUsage Condition=" '$(BCC_PCHUsage)'=='' ">GenerateAndUse</BCC_PCHUsage>
    <BCC_PCHName Condition="'$(BCC_PCHName)'=='' And '$(BCC_PCHUsage)'!='None'">$(IntermediateOutputDir)$(OutputName).pch</BCC_PCHName>
    <BCC_RequireMathFuncErrorNumber Condition="'$(BCC_RequireMathFuncErrorNumber)'==''">true</BCC_RequireMathFuncErrorNumber>

    <!-- Spell Checking causes long delays when errors are encountered -->
    <!-- Investigate if we want to hardcode or give user control -->
    <BCC_DisableSpellChecking>true</BCC_DisableSpellChecking>

    <!-- Temporary workarounds -->
    <CLANG_No__cxa_atexit_ForDestructors>true</CLANG_No__cxa_atexit_ForDestructors>

    <!-- Out of process and parallel compilation options -->
    <RunBCCOutOfProcess>$(RunBCCOutOfProcess)</RunBCCOutOfProcess>
    <RunBCCOutOfProcess Condition="'$(RunBCCOutOfProcess)'=='' And '$(Platform)'=='$(cWin64xPlatform)'">true</RunBCCOutOfProcess>
    <CLANG_ParallelDependencies>false</CLANG_ParallelDependencies>
    <CLANG_ParallelDependencies Condition="'$(BCC_NoAutodependency)'!='true' And '$(Platform)'=='$(cWin64xPlatform)'">true</CLANG_ParallelDependencies>
    <CLANG_EnableBatchCompilation>$(BCC_EnableBatchCompilation)</CLANG_EnableBatchCompilation>
    <CLANG_SubProcessesNumber Condition="'$(RunBCCOutOfProcess)'=='true' And '$(SubProcessesNumber)'!=''">$(SubProcessesNumber)</CLANG_SubProcessesNumber>
    <CLANG_SubProcessesNumber Condition="'$(RunBCCOutOfProcess)'=='true' And '$(SubProcessesNumber)'==''">0</CLANG_SubProcessesNumber>
    <CLANG_SubProcessesNumber Condition="'$(RunBCCOutOfProcess)'=='true' And '$(SubProcessesNumber)'=='-1' And '$(Platform)'!='$(cWin64xPlatform)'">0</CLANG_SubProcessesNumber>
    <CLANG_BorlandDiagnosticFormat Condition="'$(RunBCCOutOfProcess)'=='true'">borland</CLANG_BorlandDiagnosticFormat>

    <!-- Workaround fact that Incr. linking AVs in ilink64 currently -->
    <ILINK_DisableIncrementalLinking Condition="'$(USING_CLANG_WIN32)'!='true'">true</ILINK_DisableIncrementalLinking>

    <!-- Use external types w/ CLANG -->
    <CLANG_ExternalTypes>$(BCC_ExternalTypeFilesClang)</CLANG_ExternalTypes>

    <!--TODO: To delete. We are using BCC_GenearateUnicode instead-->
    <CLANG_GenerateUnicode Condition="'$(_TCHARMapping)'!='char'">true</CLANG_GenerateUnicode>

    <!-- Split DWARF options -->
    <DwoExt>dwo</DwoExt>
    <BCC_DwoLnk>$(MSBuildProjectDirectory)\$(MSBuildProjectName)Dwo.lnk</BCC_DwoLnk>
    <BCC_UseSplitDWARF Condition="('$(BCC_UseSplitDWARF)'=='') or ('$(Platform)'!='$(cWin64Platform)')">false</BCC_UseSplitDWARF>
    <BCC_DwoOutput Condition="'$(BCC_DwoOutput)'!='' And !HasTrailingSlash('$(BCC_DwoOutput)')">$(BCC_DwoOutput)\</BCC_DwoOutput>
    <BCC_DwoOutput Condition="'$(BCC_DwoOutput)'==''">$(FinalOutputDir)</BCC_DwoOutput>

  </PropertyGroup>

  <!-- CLANG_WIN32 -->
  <PropertyGroup Condition="'$(USING_CLANG_WIN32)'=='true'">
    <CLANG_FunctionSections>true</CLANG_FunctionSections>
    <CLANG_NoThreadsafeStatics>true</CLANG_NoThreadsafeStatics>
    <!--
    <CLANG_DisableFramePtrElimOpt>true</CLANG_DisableFramePtrElimOpt>
    -->
    <CLANG_SEH>true</CLANG_SEH>
    <CLANG_EmitNativeObject>true</CLANG_EmitNativeObject>
    <!--
    <CLANG_UseBorlandABI>true</CLANG_UseBorlandABI>
    -->
    <!--This option depends on BCC_NoAutodependency option, must be added when it's unchecked-->
    <CLANG_AutoDependencyOutput>false</CLANG_AutoDependencyOutput>
    <CLANG_AutoDependencyOutput Condition="'$(BCC_NoAutodependency)'!='true'">true</CLANG_AutoDependencyOutput>
  </PropertyGroup>

  <PropertyGroup>
    <ILINK_PackageImports Condition="'$(UsePackages)'=='true' AND '$(UsingDelphiRTL)'=='true' AND '$(AppType)'!='Package' And '$(ILINK_PackageImports)'!=''">$(LinkPackageImports);$(ILINK_PackageImports)</ILINK_PackageImports>
    <ILINK_PackageImports Condition="'$(UsePackages)'=='true' AND '$(UsingDelphiRTL)'=='true' AND '$(AppType)'!='Package' And '$(ILINK_PackageImports)'==''">$(LinkPackageImports)</ILINK_PackageImports>
    <ILINK_PackageLibs Condition="'$(UsePackages)'=='true' AND '$(UsingDelphiRTL)'=='true' AND '$(AppType)'!='Package'">$(LinkPackageStatics)</ILINK_PackageLibs>
  </PropertyGroup>

  <ItemGroup>
    <_DirectoryList Include="$(BCC_OutputDir)"/>
    <_DirectoryList Include="$(BRCC_OutputDir)"/>
    <_DirectoryList Include="$(DCC_ObjOutput)"/>
    <_DirectoryList Include="$(Tasm_OutputDir)"/>
    <_DirectoryList Include="$(IntermediateOutputDir)"/>
    <_DirectoryList Include="$(FinalOutputDir)"/>
    <_DirectoryList Include="$(ILINK_IntermediateOutputPath)"/>
    <_DirectoryList Include="$(ILINK_BpiLibOutputDir)"/>
    <_DirectoryList Include="$(DelphiHPPOutputPath)"
      Condition="'$(DelphiHPPOutputPath)'!='' And !Exists('$(DelphiHPPOutputPath)')"/>
  </ItemGroup>

  <!--
    ***** Targets ***********************************************
    ** Targets prefixed with an underscore are not meant to be **
    ** invoked directly with MSBuild's /t switch.              **
    *************************************************************
  -->
  <Target Name="_MakePreReq">
    <Error Condition="'$(FileToCompile)'!=''"
      Text="Cannot specify property 'FileToCompile' for Make or Build targets. Use 'MakeOne' instead."/>
  </Target>

  <Target Name="_MakeOnePreReq">
    <Error Condition="'$(FileToCompile)'==''"
      Text="Must specify property 'FileToCompile' for 'MakeOne' target; i.e., /p:FileToCompile=&lt;filename&gt;."/>
  </Target>

  <Target Name="PreLinkEvent"
    Condition=" '$(PreLinkEvent)'!='' And '$(KibitzCompile)'==''"
    DependsOnTargets="$(PreLinkEventDependsOn)">
    <Exec Command="$(PreLinkEvent)" IgnoreExitCode="$(PreLinkEventIgnoreExitCode)" WorkingDirectory="$(FinalOutputDir)"/>
  </Target>

  <Target Name="_PasDepCheck">
    <DependencyCheck
      InputFiles="@(DelphiCompile)"
      OutputFile="$(DCC_ObjOutput)%(DelphiCompile.Filename).$(ObjExt)"
      ProjectFileName="$(MSBuildProjectFullPath)"
      Build="$(ForceRebuild)"
      KibitzTask="$(_KibitzTask)"
    >
      <Output
        TaskParameter="OutOfDate"
        ItemName="PasOutOfDate"
      />
      <Output
        TaskParameter="Skipped"
        ItemName="SkippedPasFiles"
      />
    </DependencyCheck>
    <ItemSort
      MetaName="BuildOrder"
      ValueIsInt="true"
      Items="@(PasOutOfDate)"
    >
      <Output
        TaskParameter="Items"
        ItemName="PasFiles"
      />
    </ItemSort>

    <MessageMap
      Condition="'@(SkippedPasFiles)'!=''"
      FormatString="strSkipping"
      Arg0="@(SkippedPasFiles)"
    />
    <MessageMap
      Condition="'@(PasFiles)'!='' And '$(ForceRebuild)'!='true'"
      FormatString="strModified"
      Arg0="@(PasFiles)"
    />
  </Target>

  <Target Name="_CppDepCheck">
    <BccDependencyCheck
      InputFiles="@(CppCompile)"
      OutputFile="$(BCC_OutputDir)%(CppCompile.Filename)%(CppCompile.Suffix).$(ObjExt)"
      ProjectFileName="$(MSBuildProjectFullPath)"
      Build="$(ForceRebuild)"
      KibitzTask="$(_KibitzTask)"
    >
      <Output
        TaskParameter="OutOfDate"
        ItemName="CppOutOfDate"
      />
      <Output
        TaskParameter="Skipped"
        ItemName="SkippedCppFiles"
      />
    </BccDependencyCheck>
    <ItemSort
      MetaName="BuildOrder"
      ValueIsInt="true"
      Items="@(CppOutOfDate)"
    >
      <Output
        TaskParameter="Items"
        ItemName="_CppFiles"
      />
    </ItemSort>
    <MessageMap
      Condition="'@(SkippedCppFiles)'!=''"
      FormatString="strSkipping"
      Arg0="@(SkippedCppFiles)"
    />
    <MessageMap
      Condition="'@(_CppFiles)'!='' And '$(ForceRebuild)'!='true'"
      FormatString="strModified"
      Arg0="@(_CppFiles)"
    />
  </Target>

  <!-- Project could have multiple PCHCompile items but we only want to get here
       the file that it's being used for precomplining -->
  <Target Name="__DetermineClangPCHFile" Condition="'$(USING_CLANG)'=='true'">
    <FindItems
        Filenames="$(BCC_PCHName_Clang)"
        Inputs="@(PCHCompile)"
    >
    <Output
        TaskParameter="Outputs"
        ItemName="PCHFile"
    />
    </FindItems>
  </Target>

  <Target Name="_PCHMakeOneDepCheck" DependsOnTargets="__DetermineClangPCHFile"
    Condition="'$(FileToCompile)'!='$(BCC_PCHName_Clang)' And
               '$(BCC_PCHUsage)'=='GenerateAndUse'  And
               '$(BCC_PCHName_Clang)'!=''">
    <BccDependencyCheck
      Condition="'$(USING_CLANG)'=='true'"
      InputFiles="@(PCHFile)"
      OutputFile="$(BCC_OutputDir)%(PCHFile.Filename).pch"
      ProjectFileName="$(MSBuildProjectFullPath)"
      Build="false"
      KibitzTask="$(_KibitzTask)"
    >
      <Output
        TaskParameter="OutOfDate"
        ItemName="PCHOutOfDate"
      />
      <Output
        TaskParameter="Skipped"
        ItemName="SkippedPCHFiles"
      />
    </BccDependencyCheck>

    <MessageMap
      Condition="'@(SkippedPCHFiles)'!=''"
      FormatString="strSkipping"
      Arg0="@(SkippedPCHFiles)"
    />

    <ItemGroup>
        <CppFiles Include="@(PCHOutOfDate);@(_CppFiles)" Condition="'@(PCHOutOfDate)'!=''"/>
        <CppFiles Include="@(_CppFiles)" Condition="'@(PCHOutOfDate)'==''"/>
    </ItemGroup>

  </Target>


  <!-- This target must be called for any compilation to work -->
  <Target Name="_PCHDepCheck">
    <BccDependencyCheck
      Condition="(('$(Platform)'=='$(cWin32Platform)' And '$(USING_CLANG_WIN32)'=='true')
        Or '$(Platform)'=='$(cWin64Platform)'
        Or '$(Platform)'=='$(cWin64xPlatform)'
        Or '$(Platform)'=='$(ciOSDevice32Platform)'
        Or '$(Platform)'=='$(ciOSDevice64Platform)'
        Or '$(Platform)'=='$(cLinux64Platform)'
        Or '$(Platform)'=='$(cAndroidArm32Platform)'
        Or '$(Platform)'=='$(cAndroidArm64Platform)') And '$(BCC_PCHUsage)'=='GenerateAndUse'"
      InputFiles="@(PCHCompile)"
      OutputFile="$(BCC_OutputDir)%(PCHCompile.Filename).pch"
      ProjectFileName="$(MSBuildProjectFullPath)"
      Build="$(ForceRebuild)"
      KibitzTask="$(_KibitzTask)"
    >
      <Output
        TaskParameter="OutOfDate"
        ItemName="PCHOutOfDate"
      />
      <Output
        TaskParameter="Skipped"
        ItemName="SkippedPCHFiles"
      />
    </BccDependencyCheck>

    <MessageMap
      Condition="'@(SkippedPCHFiles)'!=''"
      FormatString="strSkipping"
      Arg0="@(SkippedPCHFiles)"
    />

    <ItemGroup>
        <CppFiles Include="@(PCHOutOfDate);@(_CppFiles)" Condition="'@(PCHOutOfDate)'!=''"/>
        <CppFiles Include="@(_CppFiles)" Condition="'@(PCHOutOfDate)'==''"/>
    </ItemGroup>

  </Target>

  <Target Name="_AsmDepCheck">
    <DependencyCheck
      InputFiles="@(AsmCompile)"
      OutputFile="$(TASM_OutputDir)%(AsmCompile.Filename)%(AsmCompile.Suffix).$(ObjExt)"
      ProjectFileName="$(MSBuildProjectFullPath)"
      Build="$(ForceRebuild)"
      KibitzTask="$(_KibitzTask)"
    >
      <Output
        TaskParameter="OutOfDate"
        ItemName="AsmOutOfDate"
      />
      <Output
        TaskParameter="Skipped"
        ItemName="SkippedAsmFiles"
      />
    </DependencyCheck>
    <ItemSort
      MetaName="BuildOrder"
      ValueIsInt="true"
      Items="@(AsmOutOfDate)"
    >
      <Output
        TaskParameter="Items"
        ItemName="AsmFiles"
      />
    </ItemSort>
    <MessageMap
      Condition="'@(SkippedAsmFiles)'!=''"
      FormatString="strSkipping"
      Arg0="@(SkippedAsmFiles)"
    />
    <MessageMap
      Condition="'@(AsmFiles)'!='' And '$(ForceRebuild)'!='true'"
      FormatString="strModified"
      Arg0="@(AsmFiles)"
    />
  </Target>

  <Target Name="_RcDepCheck">
     <PropertyGroup>
       <__ForceRebuild Condition="'$(ForceRebuild)'=='true'">$(ForceRebuild)</__ForceRebuild>
       <__ForceRebuild Condition="'$(ForceRebuild)'!='true'">$(__ShouldBuildVersion)</__ForceRebuild>
     </PropertyGroup>

    <DependencyCheck
      InputFiles="@(ResourceCompile)"
      OutputFile="$(BRCC_OutputDir)%(ResourceCompile.Filename).res"
      ProjectFileName="$(MSBuildProjectFullPath)"
      Build="$(__ForceRebuild)"
      KibitzTask="$(_KibitzTask)"
    >
      <Output
        TaskParameter="OutOfDate"
        ItemName="RcOutOfDate"
      />
      <Output
        TaskParameter="Skipped"
        ItemName="SkippedRcFiles"
      />
    </DependencyCheck>
    <ItemSort
      MetaName="BuildOrder"
      ValueIsInt="true"
      Items="@(RcOutOfDate)"
    >
      <Output
        TaskParameter="Items"
        ItemName="RcFiles"
      />
    </ItemSort>
    <MessageMap
      Condition="'@(SkippedRcFiles)'!=''"
      FormatString="strSkipping"
      Arg0="@(SkippedRcFiles)"
    />
    <MessageMap
      Condition="'@(RcFiles)'!='' And '$(ForceRebuild)'!='true'"
      FormatString="strModified"
      Arg0="@(RcFiles)"
    />
  </Target>

  <Target Name="_IDEDepCheck" DependsOnTargets="_ResolveFileToCompile">
    <CallTarget Targets="_CheckLinkDependencies" Condition="'$(_KibitzTask)'=='IDEDepCheck' And '%(InputFile.Identity)'=='$(MSBuildProjectFullPath)'"/>
    <DependencyCheck
      Condition="'$(_KibitzTask)'=='IDEDepCheck' And '%(InputFile.Identity)'!='$(MSBuildProjectFullPath)'"
      InputFiles="@(InputFile)"
      OutputFile="@(OutputFile)"
      ProjectFileName="$(MSBuildProjectFullPath)"
      KibitzTask="$(_KibitzTask)"
    />
  </Target>

  <Target Name="_ResolveUserObjNames">
    <CreateItem
      Condition="'%(ObjFiles.IgnorePath)'!='true'"
      Include="%(ObjFiles.Identity)">
      <Output
        TaskParameter="Include"
        ItemName="UserObjs"
      />
    </CreateItem>
    <CreateItem
      Condition="'%(ObjFiles.IgnorePath)'=='true'"
      Include="@(ObjFiles->'%(Filename)%(Extension)')">
      <Output
        TaskParameter="Include"
        ItemName="UserObjs"
      />
    </CreateItem>
  </Target>

  <Target Name="_ResolveUserLibNames">
    <CreateItem
      Condition="'%(LibFiles.IgnorePath)'!='true'"
      Include="%(LibFiles.Identity)">
      <Output
        TaskParameter="Include"
        ItemName="UserLibs"
      />
    </CreateItem>
    <CreateItem
      Condition="'%(LibFiles.IgnorePath)'=='true'"
      Include="@(LibFiles->'%(Filename)%(Extension)')">
      <Output
        TaskParameter="Include"
        ItemName="UserLibs"
      />
    </CreateItem>
  </Target>

  <Target Name="_CopyPackageLibs">
    <CreateItem
      Include="$(ILINK_PackageImports)">
      <Output
        TaskParameter="Include"
        ItemName="ILINK_PackageImports"
      />
    </CreateItem>
    <CreateItem
      Include="$(ILINK_PackageLibs)">
      <Output
        TaskParameter="Include"
        ItemName="ILINK_PackageLibs"
      />
    </CreateItem>
  </Target>

  <Target Name="_CheckLinkDependencies"
      DependsOnTargets="_ResolveUserObjNames;_ResolveUserLibNames;_ResolveOutput;_CopyPackageLibs">
    <DependencyCheck
      Condition="'$(TLibLink)'!='true' And '$(ForceLink)'!='true'"
      InputFiles="$(ILINK_StartupObjs);$(ILINK_AdditionalObjs);@(ILINK_PackageImports->'%(filename).$(BpiExt)');@(CompiledObjs);@(UserObjs);@(ILINK_PackageLibs->'%(filename).$(LibExt)');@(UserLibs);$(ILINK_AdditionalLibs);@(DefFile);@(CompiledResources);@(ResFiles);@(FormResources);@(__ProjectResourceOutputFile)"
      SearchPaths="$(ILINK_LibraryPath)"
      OutputFile="@(OutputFile)"
      ProjectFileName="$(MSBuildProjectFullPath)"
      Build="$(ForceLink)"
      KibitzTask="$(_KibitzTask)"
    >
      <Output
        TaskParameter="OutOfDate"
        ItemName="OutputOutOfDate"
      />
    </DependencyCheck>
    <DependencyCheck
      Condition="'$(TLibLink)'=='true' And '$(ForceLink)'!='true'"
      InputFiles="@(CompiledObjs);@(UserObjs)"
      OutputFile="@(OutputFile->'%(RelativeDir)$(DllPrefix)%(Filename).$(LibExt)')"
      ProjectFileName="$(MSBuildProjectFullPath)"
      Build="$(ForceLink)"
      KibitzTask="$(_KibitzTask)"
    >
      <Output
        TaskParameter="OutOfDate"
        ItemName="OutputOutOfDate"
      />
    </DependencyCheck>
  </Target>

  <Target Name="DependencyCheck" DependsOnTargets="$(DependencyCheckDependsOnTargets)"/>

  <Target Name="__SetProjectResourceFileName">
    <CreateItem
      Condition="'@(RcItem)'!=''"
      Include="$(MSBuildProjectName)_resources.rc">
      <Output
        TaskParameter="Include"
        ItemName="__ProjectResourceFile"
      />
    </CreateItem>
    <CreateItem
      Condition="'@(RcItem)'!=''"
      Include="$(BRCC_OutputDir)$(MSBuildProjectName)_resources.res">
      <Output
        TaskParameter="Include"
        ItemName="__ProjectResourceOutputFile"
      />
    </CreateItem>
  </Target>


  <Target Name="_ResolveCompiledOutput" DependsOnTargets="_ExcludeFilesFromBuild">
    <!-- Add ProjectName.res file here if needed -->
    <!-- Results of compilation (Bcc, Brcc, Dcc, Tasm) -->
    <CreateItem
      Include="@(CppCompile->'$(BCC_OutputDir)%(filename)%(Suffix).$(ObjExt)')">
      <Output
        TaskParameter="Include"
        ItemName="CompiledObjs"
      />
    </CreateItem>

    <CreateItem
      Include="@(ResourceCompile->'$(BRCC_OutputDir)%(filename)%(Suffix).res')">
      <Output
        TaskParameter="Include"
        ItemName="CompiledResources"
      />
    </CreateItem>
    <CreateItem
      Include="@(DelphiCompile->'$(DCC_ObjOutput)%(filename)%(Suffix).$(ObjExt)')">
      <Output
        TaskParameter="Include"
        ItemName="CompiledObjs"
      />
    </CreateItem>
    <CreateItem
      Include="@(AsmCompile->'$(TASM_OutputDir)%(filename)%(Suffix).$(ObjExt)')">
      <Output
        TaskParameter="Include"
        ItemName="CompiledObjs"
      />
    </CreateItem>
    <CreateItem
      Include="$(GENTLB_OutputDir)$(GENTLB_OutputName)"
      Condition="'@(RidlCompile)'!=''"
    >
      <Output
        TaskParameter="Include"
        ItemName="CompiledResources"
      />
    </CreateItem>
    <CreateItem
      Include="$(BRCC_OutputDir)$(MSBuildProjectName)_resources.res"
      Condition="'@(RcItem)'!=''"
    >
      <Output
        TaskParameter="Include"
        ItemName="CompiledResources"
      />
    </CreateItem>

    <CreateItem
      Include="$(BRCC_OutputDir)$(MSBuildProjectName).res"
      Condition="'@(__ShouldLinkVersion)'=='true' Or '$(__ShouldBuildVersion)'=='true'"
    >
      <Output
        TaskParameter="Include"
        ItemName="CompiledResources"
      />
    </CreateItem>
    <CreateItem
      Include="$(FinalOutput)">
      <Output
        TaskParameter="Include"
        ItemName="OutputFile"
      />
    </CreateItem>
  </Target>

  <Target Name="_ResolveExternalTypesPch">
    <CreateItem
      Include="%(PrecompiledHeaderFile.RelativeDir)%(PrecompiledHeaderFile.Filename).#*"
      Condition="'@(PrecompiledHeaderFile)'!=''">
      <Output
        TaskParameter="Include"
        ItemName="ExternalTypesPch"
      />
    </CreateItem>
  </Target>

  <Target Name="_ResolveOther" DependsOnTargets="__SetProjectResourceFileName">

    <!-- Link products -->
    <CreateItem
      Include="@(OutputFile->'%(RelativeDir)%(Filename).ilc')"
      Condition="'$(TLibLink)'!='true' And '$(FileToCompile)'==''">
      <Output
        TaskParameter="Include"
        ItemName="ILinkStateFiles"
      />
    </CreateItem>
    <CreateItem
      Include="@(OutputFile->'%(RelativeDir)%(Filename).ild')"
      Condition="'$(TLibLink)'!='true' And '$(FileToCompile)'==''">
      <Output
        TaskParameter="Include"
        ItemName="ILinkStateFiles"
      />
    </CreateItem>
    <CreateItem
      Include="@(OutputFile->'%(RelativeDir)%(Filename).ilf')"
      Condition="'$(TLibLink)'!='true' And '$(FileToCompile)'==''">
      <Output
        TaskParameter="Include"
        ItemName="ILinkStateFiles"
      />
    </CreateItem>
    <CreateItem
      Include="@(OutputFile->'%(RelativeDir)%(Filename).ils')"
      Condition="'$(TLibLink)'!='true' And '$(FileToCompile)'==''">
      <Output
        TaskParameter="Include"
        ItemName="ILinkStateFiles"
      />
    </CreateItem>
    <CreateItem
      Include="@(OutputFile->'%(RelativeDir)%(Filename).pdi')"
      Condition="'$(TLibLink)'!='true' And '$(FileToCompile)'==''">
      <Output
        TaskParameter="Include"
        ItemName="ILinkStateFiles"
      />
    </CreateItem>
    <CreateItem
      Include="@(OutputFile->'%(RelativeDir)%(Filename).ilr')"
      Condition="'$(TLibLink)'!='true' And '$(FileToCompile)'==''">
      <Output
        TaskParameter="Include"
        ItemName="ILinkStateFiles"
      />
    </CreateItem>
    <CreateItem
      Include="@(OutputFile->'%(RelativeDir)%(Filename).tds')"
      Condition="'$(TLibLink)'!='true' And '$(FileToCompile)'==''">
      <Output
        TaskParameter="Include"
        ItemName="ILinkSymbolFile"
      />
    </CreateItem>
    <CreateItem
      Include="$(ILINK_MapFileName)"
      Condition="'$(TLibLink)'!='true' And '$(FileToCompile)'==''">
      <Output
        TaskParameter="Include"
        ItemName="ILinkMapFile"
      />
    </CreateItem>

    <!-- Precompiled header file BCC32 -->
    <CreateItem
      Include="$(BCC_PCHName)"
      Condition="('$(BCC_PCHUsage)'=='GenerateAndUse' Or '$(BCC_PCHUsage)'=='') And '$(FileToCompile)'==''">
      <Output
        TaskParameter="Include"
        ItemName="PrecompiledHeaderFile"
      />
    </CreateItem>

    <!-- Precompiled header file BCC64 (CLANG) -->
    <CreateItem
      Include="@(PCHCompile->'$(BCC_OutputDir)%(FileName).pch')"
      Condition="('$(BCC_PCHUsage)'=='GenerateAndUse' Or '$(BCC_PCHUsage)'=='') And '$(FileToCompile)'==''">
      <Output
        TaskParameter="Include"
        ItemName="PrecompiledHeaderFile"
      />
    </CreateItem>

    <!-- Precompiled header file iOS ARM and Android (CLANG) -->
    <CreateItem
      Include="@(PCHCompile->'$(BCC_OutputDir)%(FileName).o')"
      Condition="('$(BCC_PCHUsage)'=='GenerateAndUse' Or '$(BCC_PCHUsage)'=='') And '$(FileToCompile)'==''">
      <Output
        TaskParameter="Include"
        ItemName="PrecompiledHeaderFile"
      />
    </CreateItem>

    <!-- Dependency files (CLANG) -->
    <CreateItem
      Include="@(CppCompile->'$(BCC_OutputDir)%(Filename).d')">
      <Output
        TaskParameter="Include"
        ItemName="CLANG_DependencyFiles"
      />
    </CreateItem>

    <CreateItem
      Include="@(PCHCompile->'$(BCC_OutputDir)%(FileName).d')"
      Condition="('$(BCC_PCHUsage)'=='GenerateAndUse' Or '$(BCC_PCHUsage)'=='') And '$(FileToCompile)'==''">
      <Output
        TaskParameter="Include"
        ItemName="CLANG_DependencyFiles"
      />
    </CreateItem>

    <!-- DWARF object files (CLANG) -->
    <CreateItem
      Include="@(CppCompile->'$(BCC_DwoOutput)%(Filename)%(Suffix).$(DwoExt)')"
      Condition="'$(BCC_UseSplitDWARF)'=='true'">
      <Output
        TaskParameter="Include"
        ItemName="CLANG_DwarfObjectFiles"
      />
    </CreateItem>

    <!-- Package / DLL libraries -->
    <CreateItem
      Include="$(ILINK_BpiLibOutputDir)$(ILINK_PackageBaseName).$(BpiExt)"
      Condition="'$(AppType)'=='Package' And '$(ILINK_GenerateImportLibrary)'=='true'">
      <Output
        TaskParameter="Include"
        ItemName="ImportLibrary"
      />
    </CreateItem>

    <CreateItem
      Include="@(OutputFile->'$(ILINK_BpiLibOutputDir)%(Filename).$(LibExt)')"
      Condition="'$(AppType)'!='Package' And '$(ILINK_GenerateImportLibrary)'=='true'">
      <Output
        TaskParameter="Include"
        ItemName="ImportLibrary"
      />
    </CreateItem>

    <!-- DCC32 .hpp, .dcu, .obj etc. -->
    <CreateItem
      Include="@(DelphiCompile->'%(RelativeDir)%(Filename).hpp')"
      Condition="'$(DCC_CBuilderOutput)'=='JPH'
        Or '$(DCC_CBuilderOutput)'=='JPHN'
        Or '$(DCC_CBuilderOutput)'=='JPHNE'
        Or '$(DCC_CBuilderOutput)'=='JPHE'
        Or '$(DCC_CBuilderOutput)'=='All'">
      <Output
        TaskParameter="Include"
        ItemName="DCC_HppFiles"
      />
    </CreateItem>
    <CreateItem
      Include="@(DelphiCompile->'$(DCC_DcuOutput)%(Filename).dcu')">
      <Output
        TaskParameter="Include"
        ItemName="CompiledDcus"
      />
    </CreateItem>
    <CreateItem
      Include="@(DelphiCompile->'$(DCC_ObjOutput)%(Filename).$(ObjExt)')">
      <Output
        TaskParameter="Include"
        ItemName="DCC_ObjFiles"
      />
    </CreateItem>

    <!-- TASM Listing and Cross-reference files -->
    <CreateItem
      Include="@(AsmCompile->'$(TASM_OutputDir)%(Filename).lst')"
      Condition="'$(TASM_GenerateListingFile)'=='true'">
      <Output
        TaskParameter="Include"
        ItemName="TASM_ListingFile"
      />
    </CreateItem>
    <CreateItem
      Include="@(AsmCompile->'$(TASM_OutputDir)%(Filename).xref')"
      Condition="'$(TASM_GenerateCrossRefFile)'=='true'">
      <Output
        TaskParameter="Include"
        ItemName="TASM_CrossRefFile"
      />
    </CreateItem>

    <!-- Generated <project>.info.plist for iOS and OSX platforms -->
    <CreateItem Include="@(OutputFile->'%(RelativeDir)$(MSBuildProjectName).info.plist')">
      <Output TaskParameter="Include" ItemName="OtherOutputFiles"/>
    </CreateItem>

    <CreateItem Include="@(OutputFile->'%(RelativeDir)$(MSBuildProjectName).entitlements')">
      <Output TaskParameter="Include" ItemName="OtherOutputFiles"/>
    </CreateItem>

    <CreateItem Include="@(OutputFile->'%(RelativeDir)$(MSBuildProjectName).launchscreen')"
        Condition="'$(Platform)'=='$(ciOSDevice64Platform)'">
      <Output TaskParameter="Include" ItemName="LaunchScreenDir"/>
    </CreateItem>

    <CreateItem Include="@(OutputFile->'%(RelativeDir)ResourceRules.plist')">
      <Output TaskParameter="Include" ItemName="OtherOutputFiles"/>
    </CreateItem>

    <CreateItem Include="@(OutputFile->'%(RelativeDir)$(MSBuildProjectName).dSYM')">
      <Output TaskParameter="Include" ItemName="OtherOutputFiles"/>
    </CreateItem>

    <CreateItem Include="@(OutputFile->'%(RelativeDir)AndroidManifest.xml')">
      <Output TaskParameter="Include" ItemName="OtherOutputFiles"/>
    </CreateItem>

    <CreateItem Include="@(OutputFile->'%(RelativeDir)AndroidManifest-merged.xml')">
      <Output TaskParameter="Include" ItemName="OtherOutputFiles"/>
    </CreateItem>

    <CreateItem Include="@(OutputFile->'%(RelativeDir)splash_image_def.xml')">
      <Output TaskParameter="Include" ItemName="OtherOutputFiles"/>
    </CreateItem>

    <CreateItem Include="@(OutputFile->'%(RelativeDir)splash_image_def-v21.xml')">
      <Output TaskParameter="Include" ItemName="OtherOutputFiles"/>
    </CreateItem>

    <CreateItem Include="@(OutputFile->'%(RelativeDir)styles.xml')">
      <Output TaskParameter="Include" ItemName="OtherOutputFiles"/>
    </CreateItem>

    <CreateItem Include="@(OutputFile->'%(RelativeDir)styles-v21.xml')">
      <Output TaskParameter="Include" ItemName="OtherOutputFiles"/>
    </CreateItem>

    <CreateItem Include="@(OutputFile->'%(RelativeDir)styles-v31.xml')">
      <Output TaskParameter="Include" ItemName="OtherOutputFiles"/>
    </CreateItem>

    <CreateItem Include="@(OutputFile->'%(RelativeDir)styles-v35.xml')">
      <Output TaskParameter="Include" ItemName="OtherOutputFiles"/>
    </CreateItem>

    <!-- Android launcher file -->
    <CreateItem Include="@(OutputFile->'%(RelativeDir)ic_launcher.xml')"
        Condition="'$(Platform)'=='$(cAndroidArm32Platform)' Or '$(Platform)'=='$(cAndroidArm64Platform)'">
      <Output TaskParameter="Include" ItemName="OtherOutputFiles"/>
    </CreateItem>

    <CreateItem Include="@(OutputFile->'%(RelativeDir)ic_launcher-v33.xml')"
        Condition="'$(Platform)'=='$(cAndroidArm32Platform)' Or '$(Platform)'=='$(cAndroidArm64Platform)'">
      <Output TaskParameter="Include" ItemName="OtherOutputFiles"/>
    </CreateItem>

    <!-- Android colors file -->
    <CreateItem Include="@(OutputFile->'%(RelativeDir)colors.xml')"
        Condition="'$(Platform)'=='$(cAndroidArm32Platform)' Or '$(Platform)'=='$(cAndroidArm64Platform)'">
      <Output TaskParameter="Include" ItemName="OtherOutputFiles"/>
    </CreateItem>

    <CreateItem Include="@(OutputFile->'%(RelativeDir)colors-night-v21.xml')"
        Condition="'$(Platform)'=='$(cAndroidArm32Platform)' Or '$(Platform)'=='$(cAndroidArm64Platform)'">
      <Output TaskParameter="Include" ItemName="OtherOutputFiles"/>
    </CreateItem>

    <!-- Android strings file -->
    <CreateItem Include="@(OutputFile->'%(RelativeDir)strings.xml')"
        Condition="'$(Platform)'=='$(cAndroidArm32Platform)' Or '$(Platform)'=='$(cAndroidArm64Platform)'">
      <Output TaskParameter="Include" ItemName="OtherOutputFiles"/>
    </CreateItem>

    <!-- Android provider_paths.xml file -->
    <CreateItem Include="@(OutputFile->'%(RelativeDir)provider_paths.xml')"
        Condition="'$(Platform)'=='$(cAndroidArm32Platform)' Or '$(Platform)'=='$(cAndroidArm64Platform)'">
      <Output TaskParameter="Include" ItemName="OtherOutputFiles"/>
    </CreateItem>

    <!-- .classes dir for Android <project>.classes -->
    <CreateItem Include="@(OutputFile->'%(RelativeDir)$(MSBuildProjectName).classes')"
        Condition="'$(Platform)'=='$(cAndroidArm32Platform)' Or '$(Platform)'=='$(cAndroidArm64Platform)'">
      <Output TaskParameter="Include" ItemName="ClassesDir"/>
    </CreateItem>

    <!-- Android AndroidLibraries dir -->
    <CreateItem Include="@(OutputFile->'%(RelativeDir)AndroidLibraries')"
        Condition="'$(Platform)'=='$(cAndroidArm32Platform)' Or '$(Platform)'=='$(cAndroidArm64Platform)'">
      <Output TaskParameter="Include" ItemName="AndroidLibsDir"/>
    </CreateItem>

    <!-- Android CompiledResources dir -->
    <CreateItem Include="@(OutputFile->'%(RelativeDir)CompiledResources')"
        Condition="'$(Platform)'=='$(cAndroidArm32Platform)' Or '$(Platform)'=='$(cAndroidArm64Platform)'">
      <Output TaskParameter="Include" ItemName="CompiledResDir"/>
    </CreateItem>

     <!-- .java source files for Android Services -->
    <CreateItem Include="@(OutputFile->'%(RelativeDir)$(MSBuildProjectName).java')"
        Condition="'$(Platform)'=='$(cAndroidArm32Platform)' Or '$(Platform)'=='$(cAndroidArm64Platform)'">
      <Output TaskParameter="Include" ItemName="OtherOutputFiles"/>
    </CreateItem>

    <CreateItem Include="@(OutputFile->'%(RelativeDir)$(MSBuildProjectName)ProxyInterface.java')"
        Condition="'$(Platform)'=='$(cAndroidArm32Platform)' Or '$(Platform)'=='$(cAndroidArm64Platform)'">
      <Output TaskParameter="Include" ItemName="OtherOutputFiles"/>
    </CreateItem>

    <!-- .jar binary file for Android Services -->
    <CreateItem Include="@(OutputFile->'%(RelativeDir)$(MSBuildProjectName).jar')"
        Condition="'$(Platform)'=='$(cAndroidArm32Platform)' Or '$(Platform)'=='$(cAndroidArm64Platform)'">
      <Output TaskParameter="Include" ItemName="OtherOutputFiles"/>
    </CreateItem>

    <!-- Android ManifestGenerationPropertyList.txt file -->
    <CreateItem Include="@(OutputFile->'%(RelativeDir)ManifestGenerationPropertyList.txt')"
        Condition="'$(Platform)'=='$(cAndroidArm32Platform)' Or '$(Platform)'=='$(cAndroidArm64Platform)'">
      <Output TaskParameter="Include" ItemName="OtherOutputFiles"/>
    </CreateItem>

    <!-- Android AndroidLibraryManifestList.txt file -->
    <CreateItem Include="@(OutputFile->'%(RelativeDir)AndroidLibraryManifestList.txt')"
        Condition="'$(Platform)'=='$(cAndroidArm32Platform)' Or '$(Platform)'=='$(cAndroidArm64Platform)'">
      <Output TaskParameter="Include" ItemName="OtherOutputFiles"/>
    </CreateItem>

    <!-- Android CompiledResourcesList.txt file -->
    <CreateItem Include="@(OutputFile->'%(RelativeDir)CompiledResourcesList.txt')"
        Condition="'$(Platform)'=='$(cAndroidArm32Platform)' Or '$(Platform)'=='$(cAndroidArm64Platform)'">
      <Output TaskParameter="Include" ItemName="OtherOutputFiles"/>
    </CreateItem>

    <!-- Android PackagedResources.zip file -->
    <CreateItem Include="@(OutputFile->'%(RelativeDir)PackagedResources.zip')"
        Condition="'$(Platform)'=='$(cAndroidArm32Platform)' Or '$(Platform)'=='$(cAndroidArm64Platform)'">
      <Output TaskParameter="Include" ItemName="OtherOutputFiles"/>
    </CreateItem>

    <!-- Android ManifestMergePropertyList.txt file -->
    <CreateItem Include="@(OutputFile->'%(RelativeDir)ManifestMergePropertyList.txt')"
        Condition="'$(Platform)'=='$(cAndroidArm32Platform)' Or '$(Platform)'=='$(cAndroidArm64Platform)'">
      <Output TaskParameter="Include" ItemName="OtherOutputFiles"/>
    </CreateItem>

    <!-- Android ResourcePackagePropertyList.txt file -->
    <CreateItem Include="@(OutputFile->'%(RelativeDir)ResourcePackagePropertyList.txt')"
        Condition="'$(Platform)'=='$(cAndroidArm32Platform)' Or '$(Platform)'=='$(cAndroidArm64Platform)'">
      <Output TaskParameter="Include" ItemName="OtherOutputFiles"/>
    </CreateItem>

    <!-- Android ResourceCompilePropertyList.txt file -->
    <CreateItem Include="@(OutputFile->'%(RelativeDir)ResourceCompilePropertyList.txt')"
        Condition="'$(Platform)'=='$(cAndroidArm32Platform)' Or '$(Platform)'=='$(cAndroidArm64Platform)'">
      <Output TaskParameter="Include" ItemName="OtherOutputFiles"/>
    </CreateItem>

    <!-- Android ResourceList.txt file -->
    <CreateItem Include="@(OutputFile->'%(RelativeDir)ResourceList.txt')"
        Condition="'$(Platform)'=='$(cAndroidArm32Platform)' Or '$(Platform)'=='$(cAndroidArm64Platform)'">
      <Output TaskParameter="Include" ItemName="OtherOutputFiles"/>
    </CreateItem>

    <!-- Android R.txt file -->
    <CreateItem Include="@(OutputFile->'%(RelativeDir)R.txt')"
        Condition="'$(Platform)'=='$(cAndroidArm32Platform)' Or '$(Platform)'=='$(cAndroidArm64Platform)'">
      <Output TaskParameter="Include" ItemName="OtherOutputFiles"/>
    </CreateItem>

    <!-- Android R.hash file -->
    <CreateItem Include="@(OutputFile->'%(RelativeDir)R.hash')"
        Condition="'$(Platform)'=='$(cAndroidArm32Platform)' Or '$(Platform)'=='$(cAndroidArm64Platform)'">
      <Output TaskParameter="Include" ItemName="OtherOutputFiles"/>
    </CreateItem>

    <!-- Android ResourceIdsGenerationPropertyList.txt file -->
    <CreateItem Include="@(OutputFile->'%(RelativeDir)ResourceIdsGenerationPropertyList.txt')"
        Condition="'$(Platform)'=='$(cAndroidArm32Platform)' Or '$(Platform)'=='$(cAndroidArm64Platform)'">
      <Output TaskParameter="Include" ItemName="OtherOutputFiles"/>
    </CreateItem>

    <!-- Android AndroidLibTextSymbolsFileList.txt file -->
    <CreateItem Include="@(OutputFile->'%(RelativeDir)AndroidLibTextSymbolsFileList.txt')"
        Condition="'$(Platform)'=='$(cAndroidArm32Platform)' Or '$(Platform)'=='$(cAndroidArm64Platform)'">
      <Output TaskParameter="Include" ItemName="OtherOutputFiles"/>
    </CreateItem>

    <!-- Android R.jar file -->
    <CreateItem Include="@(OutputFile->'%(RelativeDir)R.jar')"
        Condition="'$(Platform)'=='$(cAndroidArm32Platform)' Or '$(Platform)'=='$(cAndroidArm64Platform)'">
      <Output TaskParameter="Include" ItemName="OtherOutputFiles"/>
    </CreateItem>

    <!-- Android GenerateResourceIdsFile.stamp file -->
    <CreateItem Include="@(OutputFile->'%(RelativeDir)GenerateResourceIdsFile.stamp')"
        Condition="'$(Platform)'=='$(cAndroidArm32Platform)' Or '$(Platform)'=='$(cAndroidArm64Platform)'">
      <Output TaskParameter="Include" ItemName="OtherOutputFiles"/>
    </CreateItem>

    <!-- Android DexPropertyList.txt file -->
    <CreateItem Include="@(OutputFile->'%(RelativeDir)DexPropertyList.txt')"
        Condition="'$(Platform)'=='$(cAndroidArm32Platform)' Or '$(Platform)'=='$(cAndroidArm64Platform)'">
      <Output TaskParameter="Include" ItemName="OtherOutputFiles"/>
    </CreateItem>

    <!-- Android DexList.txt file -->
    <CreateItem Include="@(OutputFile->'%(RelativeDir)DexList.txt')"
        Condition="'$(Platform)'=='$(cAndroidArm32Platform)' Or '$(Platform)'=='$(cAndroidArm64Platform)'">
      <Output TaskParameter="Include" ItemName="OtherOutputFiles"/>
    </CreateItem>

    <!-- Android BuildClassesDex.stamp file -->
    <CreateItem Include="@(OutputFile->'%(RelativeDir)BuildClassesDex.stamp')"
        Condition="'$(Platform)'=='$(cAndroidArm32Platform)' Or '$(Platform)'=='$(cAndroidArm64Platform)'">
      <Output TaskParameter="Include" ItemName="OtherOutputFiles"/>
    </CreateItem>

    <!-- UWP manifest file -->
    <CreateItem Include="@(OutputFile->'%(RelativeDir)AppxManifest.xml')"
        Condition="'$(Platform)'=='$(cWin32Platform)' Or '$(Platform)'=='$(cWin64Platform)' Or '$(Platform)'=='$(cWin64xPlatform)'">
      <Output TaskParameter="Include" ItemName="OtherOutputFiles"/>
    </CreateItem>

    <!-- Symbol file (.pdb) -->
    <CreateItem Include="@(OutputFile->'%(RelativeDir)$(MSBuildProjectName).pdb')"
        Condition="'$(Platform)'=='$(cWin64xPlatform)'">
      <Output TaskParameter="Include" ItemName="OtherOutputFiles"/>
    </CreateItem>
  </Target>

  <Target Name="_DepCheckFileToCompile" DependsOnTargets="_PCHMakeOneDepCheck">
    <BccDependencyCheck
      Condition="'@(CppFile)'!=''"
      InputFiles="@(CppFile)"
      OutputFile="$(BCC_OutputDir)%(CppFile.Filename)%(CppFile.Suffix).$(ObjExt)"
      ProjectFileName="$(MSBuildProjectFullPath)"
      Build="$(ForceRebuild)"
    >
      <Output
        TaskParameter="OutOfDate"
        ItemName="CppFiles"
      />
    </BccDependencyCheck>
    <DependencyCheck
      Condition="'@(AsmFile)'!=''"
      InputFiles="@(AsmFile)"
      OutputFile="$(TASM_OutputDir)%(AsmFile.Filename)%(AsmFile.Suffix).$(ObjExt)"
      ProjectFileName="$(MSBuildProjectFullPath)"
      Build="$(ForceRebuild)"
    >
      <Output
        TaskParameter="OutOfDate"
        ItemName="AsmFiles"
      />
    </DependencyCheck>
    <DependencyCheck
      Condition="'@(RcFile)'!=''"
      InputFiles="@(RcFile)"
      OutputFile="$(BRCC_OutputDir)%(RcFile.Filename).res"
      ProjectFileName="$(MSBuildProjectFullPath)"
      Build="$(ForceRebuild)"
    >
      <Output
        TaskParameter="OutOfDate"
        ItemName="RcFiles"
      />
    </DependencyCheck>
  </Target>

  <Target Name="_ExcludeFilesFromBuild">
    <!-- .mm files support only for CLANG based platforms -->
    <ItemGroup Condition="'$(Platform)'=='$(cOSX32Platform)' Or ('$(Platform)'=='$(cWin32Platform)' And '$(USING_CLANG_WIN32)'!='true')">
        <CppCompile Remove="*.mm"/>
    </ItemGroup>
  </Target>

  <Target Name="_ResolveFileToCompile" DependsOnTargets="_ResolveInput">
    <CopyItem
      Condition="'%(InputFile.Extension)'=='.h' And '$(USING_CLANG)'=='true' And '$(BCC_PCHUsage)'=='GenerateAndUse' And '%(InputFile.ToolName)'==''"
      Source="@(InputFile)"
      MetadataNames="PCH"
      MetadataValues="true">
      <Output
        TaskParameter="Dest"
        ItemName="CppFile"
      />
    </CopyItem>
    <CopyItem
      Condition="('%(InputFile.Extension)'=='.h' And '$(USING_CLANG)'!='true' And '%(InputFile.ToolName)'=='')"
      Source="@(InputFile)">
      <Output
        TaskParameter="Dest"
        ItemName="CppFile"
      />
    </CopyItem>
    <CopyItem
      Condition="('%(InputFile.Extension)'=='.cpp' Or '%(InputFile.Extension)'=='.c' Or '%(InputFile.Extension)'=='.cc' Or '%(InputFile.Extension)'=='.cxx') And '%(InputFile.ToolName)'==''"
      Source="@(InputFile)">
      <Output
        TaskParameter="Dest"
        ItemName="CppFile"
      />
    </CopyItem>
    <CopyItem
      Condition="('%(InputFile.Extension)'=='.mm') And '%(InputFile.ToolName)'=='' And ('$(Platform)'=='$(ciOSDevice32Platform)' Or '$(Platform)'=='$(ciOSDevice64Platform)') "
      Source="@(InputFile)">
      <Output
        TaskParameter="Dest"
        ItemName="CppFile"
      />
    </CopyItem>
    <CopyItem
      Condition="'%(InputFile.Extension)'=='.rc' And '%(InputFile.ToolName)'==''"
      Source="@(InputFile)">
      <Output
        TaskParameter="Dest"
        ItemName="RcFile"
      />
    </CopyItem>
    <CopyItem
      Condition="'%(InputFile.Extension)'=='.asm' And '%(InputFile.ToolName)'==''"
      Source="@(InputFile)">
      <Output
        TaskParameter="Dest"
        ItemName="AsmFile"
      />
    </CopyItem>
    <CopyItem
      Condition="'%(InputFile.Extension)'=='.ridl' And '%(InputFile.ToolName)'==''"
      Source="@(InputFile)">
      <Output
        TaskParameter="Dest"
        ItemName="RidlFile"
      />
    </CopyItem>

    <CreateItem
      Condition="('%(InputFile.Extension)'=='.cpp' Or '%(InputFile.Extension)'=='.c' Or '%(InputFile.Extension)'=='.cc') And '%(InputFile.ToolName)'==''"
      Include="@(InputFile->'$(BCC_OutputDir)%(filename)%(Suffix).$(ObjExt)')">
      <Output
        TaskParameter="Include"
        ItemName="OutputFile"
      />
    </CreateItem>
    <CreateItem
      Condition="'%(InputFile.Extension)'=='.rc' And '%(InputFile.ToolName)'==''"
      Include="@(InputFile->'$(BRCC_OutputDir)%(Suffix)%(filename).res')">
      <Output
        TaskParameter="Include"
        ItemName="OutputFile"
      />
    </CreateItem>
    <CreateItem
      Condition="'%(InputFile.Extension)'=='.asm' And '%(InputFile.ToolName)'==''"
      Include="@(InputFile->'$(TASM_OutputDir)%(Suffix)%(filename).$(ObjExt)')">
      <Output
        TaskParameter="Include"
        ItemName="OutputFile"
      />
    </CreateItem>
    <CreateItem
      Condition="'%(InputFile.Extension)'=='.ridl' And '%(InputFile.ToolName)'==''"
      Include="$(GENTLB_OutputDir)$(GENTLB_OutputName)">
      <Output
        TaskParameter="Include"
        ItemName="OutputFile"
      />
    </CreateItem>
  </Target>

  <Target Name="_ResolveOutput" DependsOnTargets="$(_ResolveOutputDependsOn)"/>
  <Target Name="ResolveFiles" DependsOnTargets="_ResolveInput;_ResolveOutput"/>

  <Target Name="_ResolveGENTLBBindings">
    <CreateItem
      Include="$(MSBuildProjectName)_TLB.cpp">
      <Output
        TaskParameter="Include"
        ItemName="GENTLB_Bindings"
      />
    </CreateItem>
    <CreateItem
      Include="$(MSBuildProjectName)_TLB.h">
      <Output
        TaskParameter="Include"
        ItemName="GENTLB_Bindings"
      />
    </CreateItem>
  </Target>

  <Target Name="_ForceRebuild">
    <CreateProperty
      Value="true">
      <Output
        TaskParameter="Value"
        PropertyName="ForceRebuild"
      />
    </CreateProperty>
    <CreateProperty
      Value="true">
      <Output
        TaskParameter="Value"
        PropertyName="ForceLink"
      />
    </CreateProperty>
  </Target>

  <Target Name="_GatherOutputs" DependsOnTargets="ResolveFiles">
    <Message Text="CompiledObjs: @(CompiledObjs)"/>
    <Message Text="CompiledResources: @(CompiledResources)"/>
    <Message Text="OutputFile: @(OutputFile)"/>
    <Message Text="ILinkSymbolFile: @(ILinkSymbolFile)"/>
    <Message Text="ILinkMapFile: @(ILinkMapFile)"/>
    <Message Text="PrecompiledHeaderFile: @(PrecompiledHeaderFile)"/>
    <Message Text="ImportLibrary: @(ImportLibrary)"/>
    <Message Text="PackageLib: @(PackageLib)"/>
    <Message Text="DCC_HppFiles: @(DCC_HppFiles)"/>
    <Message Text="CompiledDcus: @(CompiledDcus)"/>
    <Message Text="TASM_ListingFile: @(TASM_ListingFile)"/>
    <Message Text="TASM_CrossRefFile: @(TASM_CrossRefFile)"/>

    <CreateItem
      Include="@(CompiledObjs);@(CompiledResources);@(OutputFile);@(ILinkSymbolFile);$(ILinkMapFile);@(PrecompiledHeaderFile);@(ImportLibrary);@(PackageLib);@(DCC_HppFiles);@(CompiledDcus);@(TASM_ListingFile);@(TASM_CrossRefFile)">
      <Output
        TaskParameter="Include"
        ItemName="__OutputFiles"
      />
    </CreateItem>
  </Target>

  <Target Name="MakeObjs">
    <CallTarget Targets="_CoreCompile"/>
  </Target>

  <Target Name="_CoreCompile" DependsOnTargets="$(CoreCompileDependsOnTargets)"/>

  <Target Name="_MakeOne" DependsOnTargets="_ResolveInput;_ResolveFileToCompile;_DepCheckFileToCompile">
    <CallTarget Targets="_RidlCoreCompile" Condition="'@(RidlFiles)'!=''"/>
    <CallTarget Targets="_CppCoreCompile" Condition="'@(CppFiles)'!=''"/>
    <CallTarget Targets="_RcCoreCompile" Condition="'@(RcFiles)'!=''"/>
    <CallTarget Targets="_AsmCoreCompile" Condition="'@(AsmFiles)'!=''"/>
    <CallTarget Targets="_RunUserTools" Condition="'%(InputFile.ToolName)'!=''"/>
  </Target>

  <Target Name="CppCompile" DependsOnTargets="_CppDepCheck;_PCHDepCheck">
    <CallTarget Targets="_CppCoreCompile"/>
  </Target>

  <Target Name="_CppCoreCompile">
    <CallTarget Targets="_CLANGCoreCompile" Condition="'$(USING_CLANG)' And '$(_AllKibitzOptions)'!='true'"/>
    <CallTarget Targets="_CLANGKibitzOptionsAll" Condition="'$(USING_CLANG)' And '$(_AllKibitzOptions)'=='true'"/>
    <CallTarget Targets="_BCC32CoreCompile" Condition="!$(USING_CLANG)"/>
  </Target>

  <Target Name="MakeStaticPackage"
    Condition="'$(ProjectType)'=='CppPackage' And '$(ILINK_GenerateLibFile)'=='true' and '$(_DoingStaticPackageBuild)'!='true'">
    <InvokeMSBuild
      Condition="!Exists($(MSBuildProjectFullPath))"
      Project="$(MSBuildProjectFullPath)"
      Targets="Make"
      Properties="_DoingStaticPackageBuild=true;SkipResGeneration=true;Config=$(Config);Platform=$(Platform);BDSINCLUDE=$(BDSINCLUDE);ForceRebuild=$(ForceRebuild);BCC_UseClassicCompiler=$(BCC_UseClassicCompiler);DCC_CBuilderOutput=JPHN;DCC_ObjOutput=$(DCC_ObjOutput);TLibLink=true;BCC_OutputDir=$(BCC_OutputDir)staticobjs\;FinalOutput=$(ILINK_BpiLibOutputDir)$(StaticLibPrefix)$(ILINK_PackageBaseName).$(LibExt);BDSLIB=$(BDSLIB);RunBCCOutOfProcess=$(RunBCCOutOfProcess)"
    />
    <MSBuild
      Condition="Exists($(MSBuildProjectFullPath))"
      Projects="$(MSBuildProjectFullPath)"
      Targets="Make"
      Properties="_DoingStaticPackageBuild=true;SkipResGeneration=true;Config=$(Config);Platform=$(Platform);BDSINCLUDE=$(BDSINCLUDE);ForceRebuild=$(ForceRebuild);BCC_UseClassicCompiler=$(BCC_UseClassicCompiler);DCC_CBuilderOutput=JPHN;DCC_ObjOutput=$(DCC_ObjOutput);TLibLink=true;BCC_OutputDir=$(BCC_OutputDir)staticobjs\;FinalOutput=$(ILINK_BpiLibOutputDir)$(StaticLibPrefix)$(ILINK_PackageBaseName).$(LibExt);BDSLIB=$(BDSLIB);RunBCCOutOfProcess=$(RunBCCOutOfProcess)"
    />
  </Target>

  <Target Name="StaticPackageClean"
    Condition="'$(ProjectType)'=='CppPackage' And '$(ILINK_GenerateLibFile)'=='true' and '$(_DoingStaticPackageBuild)'!='true'">
    <InvokeMSBuild
      Condition="!Exists($(MSBuildProjectFullPath))"
      Project="$(MSBuildProjectFullPath)"
      Targets="Clean"
      Properties="_DoingStaticPackageBuild=true;Config=$(Config);Platform=$(Platform);DCC_CBuilderOutput=JPHN;DCC_ObjOutput=$(DCC_ObjOutput);TLibLink=true;BCC_OutputDir=$(BCC_OutputDir)staticobjs\;FinalOutput=$(ILINK_BpiLibOutputDir)$(StaticLibPrefix)$(ILINK_PackageBaseName).$(LibExt);RunBCCOutOfProcess=$(RunBCCOutOfProcess)"
    />
    <MSBuild
      Condition="Exists($(MSBuildProjectFullPath))"
      Projects="$(MSBuildProjectFullPath)"
      Targets="Clean"
      Properties="_DoingStaticPackageBuild=true;Config=$(Config);Platform=$(Platform);DCC_CBuilderOutput=JPHN;DCC_ObjOutput=$(DCC_ObjOutput);TLibLink=true;BCC_OutputDir=$(BCC_OutputDir)staticobjs\;FinalOutput=$(ILINK_BpiLibOutputDir)$(StaticLibPrefix)$(ILINK_PackageBaseName).$(LibExt);RunBCCOutOfProcess=$(RunBCCOutOfProcess)"
    />
  </Target>


  <Target Name="_BCC32CoreCompile" Outputs="%(CppFiles.Identity)">
    <BCC32
      Condition="(('@(CppFiles)'!='' And '%(CppFiles.OptionOverrides)'!='true') Or '$(FileToCompile)'!='') Or '$(_KibitzTask)'!=''"
      Compile="@(CppFiles)"
      ForceExecute="true"
      KibitzTask="$(_KibitzTask)"
      ProjectFileName="$(MSBuildProjectFullPath)"
      PlatformTarget="$(Platform)"
      PreventPCHInjection="%(CppFiles.BCC_PreventPCHInjection)"
      OutputFilename="$(BCC_OutputDir)%(CppFiles.Filename)%(CppFiles.Suffix).$(ObjExt)"
      ShowStdOut="$(ShowStdOut)"
      RunOutOfProcess="$(RunBCCOutOfProcess)"
      Defines="$(BCC_Defines)"
      InternalDefines="$(BCC_InternalDefines)"
      Undefines="$(BCC_Undefines)"
      TargetOutputDir="$(BCC_TargetOutputDir)"
      OutputDir="$(BCC_OutputDir)"
      SysRoot="$(Profile_SysRoot)"
      IncludePath="$(BCC_IncludePath)"
      SysIncludePath="$(ProfileIncludePath)"
      FrameworkRoot="$(ProfileFrameworkPath)"
      WindowsVersionDefines="$(BCC_WindowsVersionDefines)"
      DebugLineNumbers="$(BCC_DebugLineNumbers)"
      SourceDebuggingOn="$(BCC_SourceDebuggingOn)"
      InlineFunctionExpansion="$(BCC_InlineFunctionExpansion)"
      CodeView4DebugInfo="$(BCC_CodeView4DebugInfo)"
      AllCodeguardOptions="$(BCC_AllCodeguardOptions)"
      MonitorInlinePtrAccess="$(BCC_MonitorInlinePtrAccess)"
      MonitorGlobalAndStackData="$(BCC_MonitorGlobalAndStackData)"
      MonitorThis="$(BCC_MonitorThis)"
      CodeguardDebugLevel="$(BCC_CodeguardDebugLevel)"
      SuppressBanner="$(BCC_SuppressBanner)"
      ExtendedErrorInfo="$(BCC_ExtendedErrorInfo)"
      IntegerSizedEnums="$(BCC_IntegerSizedEnums)"
      IntegerTypeEnums="$(BCC_IntegerTypeEnums)"
      StackFrames="$(BCC_StackFrames)"
      CPPCompileAlways="$(BCC_CPPCompileAlways)"
      InstructionSet="$(BCC_InstructionSet)"
      DataAlignment="$(BCC_DataAlignment)"
      CallingConvention="$(BCC_CallingConvention)"
      UseRegisterVariables="$(BCC_UseRegisterVariables)"
      LanguageCompliance="$(BCC_LanguageCompliance)"
      EnableBatchCompilation="$(BCC_EnableBatchCompilation)"
      StopBatchAfterWarnings="$(BCC_StopBatchAfterWarnings)"
      StopBatchAfterErrors="$(BCC_StopBatchAfterErrors)"
      StopBatchAfterFirstError="$(BCC_StopBatchAfterFirstError)"
      NoLink="$(BCC_NoLink)"
      AutoDepCheck="$(BCC_AutoDepCheck)"
      VirtualTables="$(BCC_VirtualTables)"
      TemplateGeneration="$(BCC_TemplateGeneration)"
      MemberPtrKind="$(BCC_MemberPtrKind)"
      HonorMemPtrPrecision="$(BCC_HonorMemPtrPrecision)"
      EnableRTTI="$(BCC_EnableRTTI)"
      EnableExceptionHandling="$(BCC_EnableExceptionHandling)"
      DestructorCleanup="$(BCC_DestructorCleanup)"
      GlobalDestructorCount="$(BCC_GlobalDestructorCount)"
      NoDllOrMTDestructorCleanup="$(BCC_NoDllOrMTDestructorCleanup)"
      FastExceptionPrologs="$(BCC_FastExceptionPrologs)"
      ExceptionLocationInfo="$(BCC_ExceptionLocationInfo)"
      SlowExceptionEpilogues="$(BCC_SlowExceptionEpilogues)"
      HideExceptionVars="$(BCC_HideExceptionVars)"
      MergeDuplicateStrings="$(BCC_MergeDuplicateStrings)"
      StringsInReadOnlyDataSeg="$(BCC_StringsInReadOnlyDataSeg)"
      StringsInWriteableDataSeg="$(BCC_StringsInWriteableDataSeg)"
      FastFloatingPoint="$(BCC_FastFloatingPoint)"
      CorrectFDIVFlaw="$(BCC_CorrectFDIVFlaw)"
      QuietFloatingPoint="$(BCC_QuietFloatingPoint)"
      NestedComments="$(BCC_NestedComments)"
      MaxIdentifierLength="$(BCC_MaxIdentifierLength)"
      AsmToObj="$(BCC_AsmToObj)"
      Assembler="$(BCC_Assembler)"
      AssemblerOptions="$(BCC_AssemblerOptions)"
      CompileToAssembly="$(BCC_CompileToAssembly)"
      CompileToAssemblyOutputFilename="$(BCC_CompileToAssemblyOutputFilename)"
      UserSuppliedOptions="$(BCC_UserSuppliedOptions)"
      EnableCodePaging="$(BCC_EnableCodePaging)"
      ExecutionCharacterSet="$(BCC_ExecutionCharacterSet)"
      DefaultCharUnsigned="$(BCC_DefaultCharUnsigned)"
      LinkWithDynamicRTL="$(BCC_LinkWithDynamicRTL)"
      GenerateConsoleApp="$(BCC_GenerateConsoleApp)"
      GenerateDLL="$(BCC_GenerateDLL)"
      GenerateMultithreaded="$(BCC_GenerateMultithreaded)"
      GenerateUnicode="$(BCC_GenerateUnicode)"
      GenerateWindowsApp="$(BCC_GenerateWindowsApp)"
      GlobalFuncsInOwnSegment="$(BCC_GlobalFuncsInOwnSegment)"
      DontMangleCCInSymbolNames="$(BCC_DontMangleCCInSymbolNames)"
      MSHeaderSearchAlgorithm="$(BCC_MSHeaderSearchAlgorithm)"
      BackwardCompatibility="$(BCC_BackwardCompatibility)"
      AllowNonConstCalls="$(BCC_AllowNonConstCalls)"
      OldOverloadRules="$(BCC_OldOverloadRules)"
      NonConstRefBinding="$(BCC_NonConstRefBinding)"
      StringLiteralsNonConst="$(BCC_StringLiteralsNonConst)"
      OldUsingRules="$(BCC_OldUsingRules)"
      OldRefTypes="$(BCC_OldRefTypes)"
      OldTernaryOperators="$(BCC_OldTernaryOperators)"
      OldForStatementScoping="$(BCC_OldForStatementScoping)"
      DisableDigraphScanner="$(BCC_DisableDigraphScanner)"
      DOSHeaderSearchAlgorithm="$(BCC_DOSHeaderSearchAlgorithm)"
      NewOperatorNames="$(BCC_NewOperatorNames)"
      AllCompatibilityFlags="$(BCC_AllCompatibilityFlags)"
      ReverseOrderForMultiCharConst="$(BCC_ReverseOrderForMultiCharConst)"
      NativeCodeForMultiByte="$(BCC_NativeCodeForMultiByte)"
      VCCompatibility="$(BCC_VCCompatibility)"
      OldBorlandClassLayout="$(BCC_OldBorlandClassLayout)"
      OldStyleVirdef="$(BCC_OldStyleVirdef)"
      OldStyleClassArgs="$(BCC_OldStyleClassArgs)"
      OldStyleTemplateSpec="$(BCC_OldStyleTemplateSpec)"
      ExplicitSpecializationAsMemberFunc="$(BCC_ExplicitSpecializationAsMemberFunc)"
      ConstructorDisplacements="$(BCC_ConstructorDisplacements)"
      PushThisFirst="$(BCC_PushThisFirst)"
      VTablePtrAtFront="$(BCC_VTablePtrAtFront)"
      SlowVirtualBasePtrs="$(BCC_SlowVirtualBasePtrs)"
      ZeroLengthEmptyMemberFuncs="$(BCC_ZeroLengthEmptyMemberFuncs)"
      ZeroLengthEmptyBaseClass="$(BCC_ZeroLengthEmptyBaseClass)"
      PCHName="$(BCC_PCHName)"
      PCHInject="$(BCC_PCHInject)"
