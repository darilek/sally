      wtes="$(BCC_wtes)"
      wthr="$(BCC_wthr)"
      wucp="$(BCC_wucp)"
      wuse="$(BCC_wuse)"
      wvoi="$(BCC_wvoi)"
      wzdi="$(BCC_wzdi)"
      wnpp="$(BCC_wnpp)"
      wprc="$(BCC_wprc)"
      wifr="$(BCC_wifr)"
      wali="$(BCC_wali)"
      wstl="$(BCC_wstl)"
      wcod="$(BCC_wcod)"
      wpcm="$(BCC_wpcm)"
      wmes="$(BCC_wmes)"
      wmcs="$(BCC_wmcs)"
      wonr="$(BCC_wonr)"
      wmcc="$(BCC_wmcc)"
      wpsb="$(BCC_wpsb)"
      watr="$(BCC_watr)"
      wexc="$(BCC_wexc)"
      wimp="$(BCC_wimp)"
      wptl="$(BCC_wptl)"
      wmls="$(BCC_wmls)"
      wmnc="$(BCC_wmnc)"
      wntn="$(BCC_wntn)"
      wcni="$(BCC_wcni)"
      wpad="$(BCC_wpad)"
      wdat="$(BCC_wdat)"
      wdpr="$(BCC_wdpr)"
      wdex="$(BCC_wdex)"
      wiex="$(BCC_wiex)"
      wucn="$(BCC_wucn)"
      winc="$(BCC_winc)"
      wrlo="$(BCC_wrlo)"
      wiip="$(BCC_wiip)"
      wmal="$(BCC_wmal)"
      wbex="$(BCC_wbex)"
      wiac="$(BCC_wiac)"
      wmtx="$(BCC_wmtx)"
      wpnf="$(BCC_wpnf)"
      wnrm="$(BCC_wnrm)"
      weoi="$(BCC_weoi)"
      wbcx="$(BCC_wbcx)"
      wdlx="$(BCC_wdlx)"
      wdim="$(BCC_wdim)"
      wdgu="$(BCC_wdgu)"
      wdiu="$(BCC_wdiu)"
      wdin="$(BCC_wdin)"
      wind="$(BCC_wind)"
      wsmx="$(BCC_wsmx)"
      wadt="$(BCC_wadt)"
      wpun="$(BCC_wpun)"
      witl="$(BCC_witl)"
      wtlb="$(BCC_wtlb)"
      wpns="$(BCC_wpns)"
      OptimizeForSize="$(BCC_OptimizeForSize)"
      DisableOptimizations="$(BCC_DisableOptimizations)"
      OptimizeForSpeed="$(BCC_OptimizeForSpeed)"
      OptimizeMaximum="$(BCC_OptimizeMaximum)"
      SelectedOptimizations="$(BCC_SelectedOptimizations)"
      OptimizeJumps="$(BCC_OptimizeJumps)"
      PentiumInstructionScheduling="$(BCC_PentiumInstructionScheduling)"
      EliminateDeadStore="$(BCC_EliminateDeadStore)"
      EliminateDuplicateExpressions="$(BCC_EliminateDuplicateExpressions)"
      ExpandIntrinsics="$(BCC_ExpandIntrinsics)"
      LoopInductionReduction="$(BCC_LoopInductionReduction)"
      OptimizeVariables="$(BCC_OptimizeVariables)"
    >
        <Output
                TaskParameter="OutputFile"
                ItemName="BCC_OutputFile"/>
    </CPP32>
  </Target>

  <Target Name="_PerformLink" DependsOnTargets="_ResolveOutput;_CheckLinkDependencies">
    <CallTarget Targets="_PerformBCCILink" Condition="'$(USING_LD)'=='false' And '$(NO_LINK)'=='false'"/>
    <CallTarget Targets="_PerformCLANGLDLink" Condition="'$(USING_LD)'=='true' And '$(NO_LINK)'=='false'" />
    <CallTarget Targets="_DSymlinkGeneration" Condition="'$(USING_LD)'=='true' And '$(NO_LINK)'=='false' And '$(TLibLink)'!='true'"/>
    <CallTarget Targets="_DeleteLnkFile" Condition="'$(USING_LD)'=='true'"/>

    <!-- For Beta Preview Only -->
    <Message Condition="'$(NO_LINK)'=='true'"
             Text="This is a Compile-only preview with no linking support yet!"/>
    <MessageMap
      Condition="'$(NO_LINK)'=='true'"
      FormatString="strSkipping"
      Arg0="@(OutputFile)"
    />
  </Target>

  <Target Name="_PerformBCCILink">
    <ILINK32
      Condition="'$(TLibLink)'!='true' And ('@(OutputOutOfDate)'!='' Or '$(ForceLink)'=='true')"
      ProjectFileName="$(MSBuildProjectFullPath)"
      KibitzTask="$(_KibitzTask)"
      ForceExecute="$(ForceLink)"
      PlatformTarget="$(Platform)"
      LibraryPath="$(ILINK_LibraryPath)"
      SysLibraryPath="$(ProfileLibraryPath);$(ProfileFrameworkPath)"
      SysRoot="$(Profile_SysRoot)"
      Frameworks="$(ProfileFrameworks)"
      ObjectSearchPath="$(ILINK_ObjectSearchPath)"
      IntermediateOutputPath="$(ILINK_IntermediateOutputPath)"
      BpiLibOutputDir="$(ILINK_BpiLibOutputDir)"
      FullDebugInfo="$(ILINK_FullDebugInfo)"
      GenerateImportLibrary="$(ILINK_GenerateImportLibrary)"
      GenerateDRC="$(ILINK_GenerateDRC)"
      DisableIncrementalLinking="$(ILINK_DisableIncrementalLinking)"
      MaxErrors="$(ILINK_MaxErrors)"
      SuppressBanner="$(ILINK_SuppressBanner)"
      KeepOutputFiles="$(ILINK_KeepOutputFiles)"
      DisplayTime="$(ILINK_DisplayTime)"
      AdditionalOptions="$(ILinkTarget) $(ILINK_AdditionalOptions)"
      FilenameAlias="$(ILINK_FilenameAlias)"
      AppType="$(ILINK_AppType)"
      MapWithMangledNames="$(ILINK_MapWithMangledNames)"
      MapFileType="$(ILINK_MapFileType)"
      BaseAddress="$(ILINK_BaseAddress)"
      HeapReserveSize="$(ILINK_HeapReserveSize)"
      HeapCommitSize="$(ILINK_HeapCommitSize)"
      StackReserveSize="$(ILINK_StackReserveSize)"
      StackCommitSize="$(ILINK_StackCommitSize)"
      Description="$(ILINK_Description)"
      SectionFlags="$(ILINK_SectionFlags)"
      ImageFlags="$(ILINK_ImageFlags)"
      DelayLoadDll="$(ILINK_DelayLoadDll)"
      ClearState="$(ILINK_ClearState)"
      CaseSensitive="$(ILINK_CaseSensitive)"
      Verbose="$(ILINK_Verbose)"
      FastTLS="$(ILINK_FastTLS)"
      ImageChecksum="$(ILINK_ImageChecksum)"
      ReplaceResources="$(ILINK_ReplaceResources)"
      FileAlignment="$(ILINK_FileAlignment)"
      ObjectAlignment="$(ILINK_ObjectAlignment)"
      HeapInfo="$(ILINK_HeapInfo)"
      HeapCode="$(ILINK_HeapCode)"
      HeapROData="$(ILINK_HeapROData)"
      HeapData="$(ILINK_HeapData)"
      HeapTDS="$(ILINK_HeapTDS)"
      HeapDwarf_aranges="$(ILINK_HeapDwarf_aranges)"
      HeapDwarf_macinfo="$(ILINK_HeapDwarf_macinfo)"
      HeapDwarf_pubtypes="$(ILINK_HeapDwarf_pubtypes)"
      HeapDwarf_info="$(ILINK_HeapDwarf_info)"
      HeapDwarf_abbrev="$(ILINK_HeapDwarf_abbrev)"
      HeapDwarf_line="$(ILINK_HeapDwarf_line)"
      HeapDwarf_str="$(ILINK_HeapDwarf_str)"
      HeapDwarf_loc="$(ILINK_HeapDwarf_loc)"
      HeapDwarf_ranges="$(ILINK_HeapDwarf_ranges)"
      OSVersion="$(ILINK_OSVersion)"
      SubSysVersion="$(ILINK_SubSysVersion)"
      UserVersion="$(ILINK_UserVersion)"
      PackageType="$(ILINK_PackageType)"
      PackageBaseName="$(ILINK_PackageBaseName)"

      TSAware="$(ILINK_TSAware)"
      NXCompat="$(ILINK_NXCompat)"
      HighEntropyVa="$(ILINK_HighEntropyVa)"
      DynamicBase="$(ILINK_DynamicBase)"
      LargeAddressAware="$(ILINK_LargeAddressAware)"

      ImageComment="$(ILINK_ImageComment)"
      AllWarnings="$(ILINK_AllWarnings)"
      DisableWarnings="$(ILINK_DisableWarnings)"
      SelectedWarnings="$(ILINK_SelectedWarnings)"
      wexp="$(ILINK_wexp)"
      wrty="$(ILINK_wrty)"
      wdup="$(ILINK_wdup)"
      wdpl="$(ILINK_wdpl)"
      wnou="$(ILINK_wnou)"
      wuld="$(ILINK_wuld)"
      wsrd="$(ILINK_wsrd)"
      wdee="$(ILINK_wdee)"
      wsnf="$(ILINK_wsnf)"
      ObjFiles="$(ILINK_StartupObjs);$(DelphiRTLBpis);@(ILINK_PackageImports->'%(filename).$(BpiExt)');$(ILINK_AdditionalObjs);@(CompiledObjs);@(UserObjs)"
      OutputFile="@(OutputFile)"
      MapFile="@(ILinkMapFile)"
      LibFiles="$(CodeGuard_Lib);$(DelphiRTLLibs);@(ILINK_PackageLibs->'%(filename).$(LibExt)');@(UserLibs);$(ILINK_AdditionalLibs)"
      DefFile="@(DefFile)"
      ResFiles="@(CompiledResources);@(ResFiles)"
      FormResources="@(FormResources)"
      ShowStdOut="$(ShowStdOut)"
      >
        <Output
                TaskParameter="OutputFile"
                ItemName="ILINK_OutputFile"/>
        <Output
                TaskParameter="StateFiles"
                ItemName="ILINK_StateFiles"/>
        <Output
                TaskParameter="MapFile"
                ItemName="ILINK_MapFile"/>
        <Output
                TaskParameter="SymbolFile"
                ItemName="ILINK_SymbolFile"/>
        <Output
                TaskParameter="ImportLibrary"
                ItemName="ILINK_ImportLibrary"/>
        <Output
                TaskParameter="PackageStaticLibrary"
                ItemName="ILINK_PackageStaticLibrary"/>
      </ILINK32>
    <Delete
      Condition="'$(TLibLink)'=='true' And ('@(OutputOutOfDate)'!='' Or '$(ForceLink)'=='true')"
      Files="@(OutputFile)"
      TreatErrorsAsWarnings="true"
      />
    <TLIB
      Condition="'$(TLibLink)'=='true' And ('@(OutputOutOfDate)'!='' Or '$(ForceLink)'=='true')"
      PlatformTarget="$(Platform)"
      ObjFiles="@(CompiledObjs);@(UserObjs)"
      OutputFile="@(OutputFile)"
      ProjectFileName="$(MSBuildProjectFullPath)"
      ListingFileName="$(TLib_ListingFileName)"
      CaseSensitive="$(TLib_CaseSensitive)"
      PageSize="$(TLib_PageSize)"
      PurgeCommentRecords="$(TLib_PurgeCommentRecords)"
      ShowStdOut="$(ShowStdOut)"
    >
      <Output
        TaskParameter="OutputFile"
        ItemName="TLIB_OutputFile"/>
    </TLIB>
  </Target>

  <!-- Secondary LD task file generation (.dsym, .lnk) -->
  <Target Name="_DSymlinkGeneration" Condition="'$(Platform)'=='$(ciOSDevice32Platform)'
                                             Or '$(Platform)'=='$(ciOSDevice64Platform)'
                                             Or '$(Platform)'=='$(cOSX64Platform)'
                                             Or '$(Platform)'=='$(cOSXArm64Platform)'
                                             ">
    <Exec Condition="'$(BCC_SourceDebuggingOn)'=='true' And ('$(Platform)'=='$(ciOSDevice32Platform)'
                                                          Or '$(Platform)'=='$(ciOSDevice64Platform)')"
          Command='"$(BDS)\bin\dsymlink.exe" "$(OutputPath)"'/>
    <Exec Condition="'$(BCC_SourceDebuggingOn)'=='true' And ('$(Platform)'=='$(cOSX64Platform)' Or '$(Platform)'=='$(cOSXArm64Platform)')"
          Command='"$(BDS)\bin\dsymutil.exe" -flat "$(OutputPath)"'/>
  </Target>

  <Target Name="__GenerateStartLnkFile" Condition="'$(TLibLink)'!='true' And ('@(OutputOutOfDate)'!='' Or '$(ForceLink)'=='true')">
    <ItemGroup>
        <Lnk_FilesStart Include="$(LD_SetStartupCodeToUse)"/>
    </ItemGroup>

    <PropertyGroup>
        <RequiresQuotes Condition="'$(Platform)'=='$(cAndroidArm32Platform)'
                                Or '$(Platform)'=='$(cAndroidArm64Platform)'
                                Or '$(Platform)'=='$(cLinux64Platform)'
                                Or '$(Platform)'=='$(cWin64xPlatform)'
                                  ">true</RequiresQuotes>
        <RequiresQuotes Condition="'$(Platform)'=='$(ciOSDevice32Platform)'
                                Or '$(Platform)'=='$(ciOSDevice64Platform)'
                                Or '$(Platform)'=='$(ciOSX6464Platform)'
                                Or '$(Platform)'=='$(ciOSXArm6464Platform)'
                                  ">false</RequiresQuotes>
    </PropertyGroup>
    <!-- Print .lnk file content
    <Message Text="FilesStart in .lnk linker file: @(Lnk_FilesStart)"/>
    -->

    <WriteLinesToFileEx
      File="$(FinalOutputDir)$(MSBuildProjectName)Start.lnk"
      Lines="@(Lnk_FilesStart)"
      lineEnding="1"
      RemoveCR="true"
      Escaped="true"
      RequiresQuotes="$(RequiresQuotes)"
      Overwrite="true"/>

    <ItemGroup>
        <StartLnk_IOS Condition="'$(Platform)'=='$(ciOSDevice32Platform)' Or '$(Platform)'=='$(ciOSDevice64Platform)'" Include="$(FinalOutputDir)$(MSBuildProjectName)Start.lnk"/>
        <StartLnk_Linux_Android Condition="'$(Platform)'=='$(cAndroidArm32Platform)' Or '$(Platform)'=='$(cAndroidArm64Platform)' Or '$(Platform)'=='$(cLinux64Platform)'" Include="$(FinalOutputDir)$(MSBuildProjectName)Start.lnk"/>
        <StartLnk_Window Condition="'$(Platform)'=='$(cWin64xPlatform)'" Include="$(FinalOutputDir)$(MSBuildProjectName)Start.lnk"/>
    </ItemGroup>
  </Target>

  <Target Name="__GenerateLnkFile" Condition="'$(TLibLink)'!='true' And ('@(OutputOutOfDate)'!='' Or '$(ForceLink)'=='true')" DependsOnTargets="__GenerateStartLnkFile" >
    <ItemGroup>
        <Lnk_ObjFiles Include="$(ILINK_AdditionalObjs);@(CompiledObjs);@(UserObjs)"/>
        <Lnk_Files Include="@(Lnk_ObjFiles);$(LD_ForceLoadStaticLibraries);@(UserLibs);$(LD_SystemLibraries)"/>
    </ItemGroup>

    <PropertyGroup>
        <RequiresQuotes Condition="'$(Platform)'=='$(cAndroidArm32Platform)'
                                Or '$(Platform)'=='$(cAndroidArm64Platform)'
                                Or '$(Platform)'=='$(cLinux64Platform)'
                                Or '$(Platform)'=='$(cWin64xPlatform)'
                                  ">true</RequiresQuotes>
        <RequiresQuotes Condition="'$(Platform)'=='$(ciOSDevice32Platform)'
                                Or '$(Platform)'=='$(ciOSDevice64Platform)'
                                Or '$(Platform)'=='$(ciOSX64Platform)'
                                Or '$(Platform)'=='$(ciOSXArm64Platform)'
                                  ">false</RequiresQuotes>
    </PropertyGroup>
    <!-- Print .lnk file content
    <Message Text="Files in .lnk linker file: @(Lnk_Files)"/>
    -->

    <WriteLinesToFileEx
      File="$(FinalOutputDir)$(MSBuildProjectName).lnk"
      Lines="@(Lnk_Files)"
      lineEnding="1"
      RemoveCR="true"
      Escaped="true"
      RequiresQuotes="$(RequiresQuotes)"
      Overwrite="true"/>

    <ItemGroup>
        <ObjectLinkerFile Condition="'$(Platform)'=='$(ciOSDevice32Platform)'
                                  Or '$(Platform)'=='$(ciOSDevice64Platform)'
                                  Or '$(Platform)'=='$(cOSX64Platform)'
                                  Or '$(Platform)'=='$(cOSXArm64Platform)'"
                          Include="$(FinalOutputDir)$(MSBuildProjectName).lnk"/>
        <Android_ObjectLinkerFile Condition="'$(Platform)'=='$(cAndroidArm32Platform)'
                                          Or '$(Platform)'=='$(cAndroidArm64Platform)'
                                          Or '$(Platform)'=='$(cLinux64Platform)'"
                                  Include="$(FinalOutputDir)$(MSBuildProjectName).lnk"/>
        <Window_ObjectLinkerFile Condition="'$(Platform)'=='$(cWin64xPlatform)'"
                                  Include="$(FinalOutputDir)$(MSBuildProjectName).lnk"/>
    </ItemGroup>
  </Target>

  <Target Name="_DeleteLnkFile" Condition="'$(ILINK_RemoveTmpLnkFile)'!='false'">
    <Delete Files="@(ObjectLinkerFile)"/>
    <Delete Files="@(Android_ObjectLinkerFile)"/>
    <Delete Files="@(Window_ObjectLinkerFile)"/>
    <Delete Files="@(StartLnk_Linux_Android)"/>
    <Delete Files="@(StartLnk_IOS)"/>
    <Delete Files="@(StartLnk_Window)"/>
  </Target>


  <Target Name="_PerformCLANGLDLink" DependsOnTargets="__GenerateLnkFile">
    <LD
      Condition="'$(TLibLink)'!='true' And ('@(OutputOutOfDate)'!='' Or '$(ForceLink)'=='true')"
      ProjectFileName="$(MSBuildProjectFullPath)"
      KibitzTask="$(_KibitzTask)"
      ForceExecute="$(ForceLink)"
      PlatformTarget="$(Platform)"
      SysRoot="$(LD_SysRoot)"
      SysLibRoot="$(Profile_SysRoot)"
      SymbolsToExport="$(ILINK_SymbolsToExport)"
      LibraryPath="$(ILINK_LibraryPath)"
      ForceLoad_RtlHelper="$(LD_ForceLoad_RtlHelper)"
      ForceLoad_Rtl="$(LD_ForceLoad_Rtl)"
      StartLibraryGroup="$(LD_StartLibraryGroup)"
      EndLibraryGroup="$(LD_EndLibraryGroup)"
      ObjectLinkerFile="@(ObjectLinkerFile)"
      Android_ObjectLinkerFile="@(Android_ObjectLinkerFile)"
      Window_ObjectLinkerFile="@(Window_ObjectLinkerFile)"
      StartLnk_Linux_Android="@(StartLnk_Linux_Android)"
      StartLnk_IOS="@(StartLnk_IOS)"
      StartLnk_Window="@(StartLnk_Window)"
      AdditionalOptions="$(ILINK_AdditionalOptions)"
      iOSMinimumVersion="$(ILINK_iOSMinimumVersion)"
      macOSMinimumVersion="$(ILINK_macOSMinimumVersion)"
      macOSArmMinimumVersion="$(ILINK_macOSArmMinimumVersion)"
      FrameworkRoot="$(Profile_frameworkroot)"
      FrameworkReferences="$(ProfileFrameworks)"

      GCSections="$(ILINK_GCSections)"
      PackageDescription_lld="$(LD_PackageDescription_lld)"
      PackageType="$(ILINK_PackageType)"
      VersionScriptFile="$(LD_VersionScriptFile)"
      SharedLibrary="$(LD_SharedLibrary)"
      UndefinedSymbols="$(LD_UndefinedSymbols)"
      ReportUnresolvedSymRef="$(LD_ReportUnresolvedSymRef)"
      UseLibrariesToLink="$(LD_UseLibrariesToLink)"
      UseLibrariesToLink_lld="$(LD_UseLibrariesToLink_lld)"
      DefFile="@(DefFile)"
      ResFiles="@(CompiledResources);@(ResFiles)"
      UsePackagesToLink="$(LD_UsePackagesToLink)"
      UsePackagesToLink_lld="$(LD_UsePackagesToLink_lld)"
      ObjFiles="$(ILINK_AdditionalObjs);@(CompiledObjs)"
      SetEndCodeToUse="$(LD_SetEndCodeToUse)"
      MapFile="@(ILinkMapFile)"
      GenerateMapFile="$(ILINK_GenerateMapFile)"
      MapWithMangledNames="$(ILINK_MapWithMangledNames)"
      iOSOutputMapFile="$(LD_iOSOutputMapFile)"
      AndroidOutputMapFile="$(LD_AndroidOutputMapFile)"
      WindowOutputMSLinkMapFile="$(LD_WindowOutputMSLinkMapFile)"
      WindowOutputLLDMapFile="$(LD_WindowOutputLLDMapFile)"

      RemoveUnreachableSymbols="$(LD_RemoveUnreachableSymbols)"
      TargetArhitecture="$(LD_TargetArhitecture)"
      LinkDynamically="$(LD_LinkDynamically)"
      DebugInfoOptimization="$(LD_DebugInfoOptimization)"

      StaticLink="$(LD_StaticLink)"
      DynamicLink="$(LD_DynamicLink)"
      GeneratePDBFile="$(LD_GeneratePDBFile)"
      VFSOverlayDir="$(CLANG_OutputDir)"
      RemoveTmpVFSFiles="$(BCC_RemoveTmpVFSFiles)"
      MaxErrors="$(ILINK_MaxErrors)"
      EntryPointSymbol="$(LD_EntryPointSymbol)"
      EnableAutoImageBase="$(LD_EnableAutoImageBase)"
      StripDebugInfo_lld="$(LD_StripDebugInfo_lld)"
      GenerateImportLibrary_lld="$(LD_GenerateImportLibrary_lld)"

      HeapReserveCommitSize_lld="$(LD_HeapReserveCommitSize_lld)"
      StackReserveCommitSize_lld="$(LD_StackReserveCommitSize_lld)"
      OSVersionMajor_lld="$(LD_OSVersionMajor_lld)"
      OSVersionMinor_lld="$(LD_OSVersionMinor_lld)"
      SubSysVersionMajor_lld="$(LD_SubSysVersionMajor_lld)"
      SubSysVersionMinor_lld="$(LD_SubSysVersionMinor_lld)"

      TSAware_lld="$(ILINK_TSAware_lld)"
      NXCompat="$(ILINK_NXCompat)"
      Verbose="$(ILINK_Verbose)"
      DelayLoadDll="$(ILINK_DelayLoadDll)"
      FileAlignment="$(ILINK_FileAlignment)"
      ObjectAlignment="$(ILINK_ObjectAlignment)"
      HighEntropyVa="$(ILINK_HighEntropyVa)"
      DynamicBase="$(ILINK_DynamicBase)"
      ExcludeAllSymbols="$(ILINK_ExcludeAllSymbols)"

      ExceptionFrameHeader="$(LD_ExceptionFrameHeader)"
      LinkerEmulation="$(LD_LinkerEmulation)"
      Subsystem="$(LD_Subsystem)"
      DynamicLinker="$(LD_DynamicLinker)"
      RuntimeSearchPath="$(LD_RuntimeSearchPath)"
      GenerateBuildID="$(LD_GenerateBuildID)"

      OutputFileName="@(OutputFile)"
      AndroidNDKLinkerFile="$(NDKArmLinuxAndroidFile)"
      >
        <Output
                TaskParameter="OutputFile"
                ItemName="ILINK_OutputFile"/>
    </LD>
    <Delete
      Condition="'$(TLibLink)'=='true' And ('@(OutputOutOfDate)'!='' Or '$(ForceLink)'=='true')"
      Files="@(OutputFile)"
      TreatErrorsAsWarnings="true"
    />
    <TLIB
      Condition="'$(TLibLink)'=='true' And ('$(_DoingStaticPackageBuild)'=='true' Or ('@(OutputOutOfDate)'!='' Or '$(ForceLink)'=='true'))"
      PlatformTarget="$(Platform)"
      ObjFiles="@(CompiledObjs);@(UserObjs)"
      OutputFile="@(OutputFile)"
      ProjectFileName="$(MSBuildProjectFullPath)"
      ListingFileName="$(TLib_ListingFileName)"
      CaseSensitive="$(TLib_CaseSensitive)"
      PageSize="$(TLib_PageSize)"
      PurgeCommentRecords="$(TLib_PurgeCommentRecords)"
      ShowStdOut="$(ShowStdOut)"
    >
      <Output
        TaskParameter="OutputFile"
        ItemName="TLIB_OutputFile"/>
    </TLIB>

  </Target>

  <Target Name="CleanAndroidApkRootDir" Condition="'$(Platform)'=='$(cAndroidArm32Platform)' Or '$(Platform)'=='$(cAndroidArm64Platform)'">
    <RemoveDir Directories="$(APK_RootDir)"/>
  </Target>

  <Target Name="CleanUWPAppxRootDir"  Condition="'$(UWP_Platform)'=='true'">
    <RemoveDir Directories="$(APPX_RootDir)"/>
  </Target>

  <!-- Android predexed jar and globals files -->
  <Target Name="CleanDexCompilationOutputFiles" DependsOnTargets="_AndroidResolveAndroidLibFiles;GetProjectJars" Condition="'$(Platform)'=='$(cAndroidArm32Platform)' Or '$(Platform)'=='$(cAndroidArm64Platform)'">
    <Delete Files="@(_JarsLocations->'%(PredexedJar)');@(_JarsLocations->'%(Globals)')"/>
  </Target>

  <Target Name="CleanOutputFiles" DependsOnTargets="_ResolveOutput;_ResolveExternalTypesPch">
    <Delete Files="@(CompiledObjs)"/>
    <Delete Files="@(CompiledResources)"/>
    <Delete Files="@(CompiledDcus)"/>
    <Delete Files="@(DCC_HppFiles)"/>
    <Delete Files="@(PrecompiledHeaderFile)"/>
    <Delete Files="@(ExternalTypesPch)"/>
    <Delete Files="@(OtherOutputFiles)"/>
    <Delete Files="@(CLANG_DependencyFiles)"/>
    <Delete Files="@(CLANG_DwarfObjectFiles)"/>
    <Delete Files="$(FinalOutputDir)$(MSBuildProjectName).icns"/>
    <Delete Files="$(FinalOutputDir)$(MSBuildProjectName).lnk"/>
    <Delete Files="$(FinalOutputDir)$(MSBuildProjectName)Start.lnk"/>
    <Delete Files="$(FinalOutputDir)$(MSBuildProjectName).rsp"/>
    <RemoveDir Directories="@(LaunchScreenDir)"/>
    <RemoveDir Directories="@(ClassesDir)"/>
    <RemoveDir Directories="@(CompiledResDir)"/>
    <RemoveDir Directories="@(AndroidLibsDir)"/>
  </Target>

  <Target Name="CleanLinkerStateFiles" DependsOnTargets="_ResolveOutput">
    <Delete Files="@(ILinkStateFiles)"
      Condition="'$(TLibLink)'!='true'"/>
  </Target>

  <Target Name="CleanLinkOutput" DependsOnTargets="_ResolveOutput;CleanLinkerStateFiles">
    <Delete Files="@(OutputFile)"/>
    <Delete Condition="'$(AppType)'=='Package'" Files="@(PackageLib)"/>
    <Delete Files="@(ImportLibrary)"
      Condition="'$(TLibLink)'!='true'"/>
    <Delete Files="$(ILINK_MapFileName)"
      Condition="'$(TLibLink)'!='true'"/>
    <Delete Files="@(ILinkSymbolFile)"
      Condition="'$(TLibLink)'!='true'"/>
  </Target>

  <Target Name="Make" DependsOnTargets="$(MakeDependsOnTargets)"/>
  <Target Name="MakeOne" DependsOnTargets="$(MakeOneDependsOnTargets)"/>
  <Target Name="Build" DependsOnTargets="$(BuildDependsOnTargets)"/>
  <Target Name="BuildOne" DependsOnTargets="$(BuildOneDependsOnTargets)"/>
  <Target Name="Link" DependsOnTargets="$(LinkDependsOnTargets)"/>
  <Target Name="Clean" DependsOnTargets="$(CleanDependsOnTargets)"/>

  <Target Name="MakeAll" Outputs="%(BuildConfiguration.Identity)">
    <MessageMap
      Condition="'%(BuildConfiguration.Identity)'!='Base'"
      FormatString="strMakingConfiguration"
      Arg0="%(BuildConfiguration.Identity)"
    />
    <InvokeMSBuild
      Condition="!Exists($(MSBuildProjectFullPath)) And '%(BuildConfiguration.Identity)'!='Base'"
      Project="$(MSBuildProjectFullPath)"
      Properties="Config=%(BuildConfiguration.Identity)"
      Targets="Make"
    />
    <MSBuild
      Condition="Exists($(MSBuildProjectFullPath)) And '%(BuildConfiguration.Identity)'!='Base'"
      Projects="$(MSBuildProjectFullPath)"
      Properties="Config=%(BuildConfiguration.Identity)"
      Targets="Make"
    />
  </Target>

  <Target Name="BuildAll" Outputs="%(BuildConfiguration.Identity)">
    <MessageMap
      Condition="'%(BuildConfiguration.Identity)'!='Base'"
      FormatString="strBuildingConfiguration"
      Arg0="%(BuildConfiguration.Identity)"
    />
    <InvokeMSBuild
      Condition="!Exists($(MSBuildProjectFullPath)) And '%(BuildConfiguration.Identity)'!='Base'"
      Project="$(MSBuildProjectFullPath)"
      Properties="Config=%(BuildConfiguration.Identity)"
      Targets="Build"
    />
    <MSBuild
      Condition="Exists($(MSBuildProjectFullPath)) And '%(BuildConfiguration.Identity)'!='Base'"
      Projects="$(MSBuildProjectFullPath)"
      Properties="Config=%(BuildConfiguration.Identity)"
      Targets="Build"
    />
  </Target>

  <Target Name="CleanAll" Outputs="%(BuildConfiguration.Identity)">
    <MessageMap
      Condition="'%(BuildConfiguration.Identity)'!='Base'"
      FormatString="strCleaningConfiguration"
      Arg0="%(BuildConfiguration.Identity)"
    />
    <InvokeMSBuild
      Condition="!Exists($(MSBuildProjectFullPath)) And '%(BuildConfiguration.Identity)'!='Base'"
      Project="$(MSBuildProjectFullPath)"
      Properties="Config=%(BuildConfiguration.Identity)"
      Targets="Clean"
    />
    <MSBuild
      Condition="Exists($(MSBuildProjectFullPath)) And '%(BuildConfiguration.Identity)'!='Base'"
      Projects="$(MSBuildProjectFullPath)"
      Properties="Config=%(BuildConfiguration.Identity)"
      Targets="Clean"
    />
  </Target>

  <Target Name="Default">
    <CallTarget Targets="Make"/>
  </Target>

</Project>
